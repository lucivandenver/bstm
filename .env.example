# Node.js 22.13+ required. Copy to .env; never commit the real .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=BSTM
DB_USER=root
DB_PASSWORD=
# Cloud MySQL: enable TLS and provide the CA via a private file or DB_SSL_CA.
DB_SSL=false
DB_SSL_CA_FILE=
# Google Cloud OAuth client, application type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Optional: Gemini generates guidance using anonymised competency evidence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

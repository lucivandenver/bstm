# Node.js 22.13+ required. Copy to .env; never commit the real .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=BSTM
DB_USER=root
DB_PASSWORD=
# Cloud MySQL: enable TLS and provide the CA via a private file or DB_SSL_CA.
DB_SSL=false
DB_SSL_CA_FILE=
# Google Cloud OAuth client, application type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Optional: Gemini generates guidance using anonymised competency evidence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Reserved owner account provisioned by npm run migrate. Never commit a real password.
ADMIN_EMAIL=bstm4thyear.mbc@gmail.com
ADMIN_INITIAL_PASSWORD=

# Course generation: keep Gemini for careers; use a lighter course model separately.
COURSE_AI_PROVIDER=gemini
COURSE_GEMINI_MODEL=gemini-3.1-flash-lite
# Shared course request pacing; adjust to the actual project quota.
COURSE_AI_INTERVAL_MS=12000
# Optional independent provider; never commit a real Groq key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional Vertex AI course-generation provider. Express Mode uses API key; standard mode uses service-account ADC.
VERTEX_AUTH_MODE=service_account
VERTEX_API_KEY=
VERTEX_MODEL=gemini-2.5-flash
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Set to groq only after adding the key and reviewing provider consent.
COURSE_AI_FALLBACK=none

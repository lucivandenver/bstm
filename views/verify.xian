<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}} · CareerBridge</title><meta name="robots" content="noindex,nofollow"><link rel="stylesheet" href="/css/student.css"></head><body><main class="page" style="max-width:700px"><section class="card"><p class="eyebrow">BSTM CAREERBRIDGE</p><h1>Credential verification</h1>{{#if missing}}<div class="notice error">This credential could not be found.</div>{{else}}{{#if credential.revoked}}<div class="notice error">This credential has been revoked.</div>{{else}}<div class="notice">Valid platform course-completion record</div><h2>{{credential.recipientName}}</h2><p>Completed <strong>{{credential.courseTitle}}</strong></p><p class="small muted">Issued {{credential.date}} · Version {{credential.courseVersion}}<br>Final assessment: {{credential.score}}%<br>Credential ID: {{credential.id}}</p><p class="small muted">A CareerBridge course-completion certificate is not a professional licence, TESDA certification or guarantee of employment.</p>{{/if}}{{/if}}<a class="button secondary" href="/">Visit CareerBridge</a></section></main></body></html>

{{> head }}
<body class="min-h-screen bg-[#F8FAFC] flex flex-col justify-between antialiased selection:bg-rose-500 selection:text-white">
<div class="auth-status">{{> messages}}</div>

  <!-- Header Branding with 3 Logos + CareerBridge Brand Logo (Pushed to corners) -->
  <header class="w-full px-6 sm:px-10 py-5 flex items-center justify-between border-b border-gray-200 bg-white shadow-sm">
    <div class="flex items-center gap-3">
      <div class="flex items-center space-x-2">
        <img src="/images/minsu_seal.png" alt="MinSU Seal" class="h-10 w-10 object-contain drop-shadow" />
        <img src="/images/cbm_logo.png" alt="CBM Logo" class="h-10 w-10 object-contain drop-shadow" />
        <img src="/images/council_tourism_logo.png" alt="Council of Tourism Students" class="h-11 w-11 object-contain drop-shadow" />
      </div>
      <div class="border-l border-gray-200 pl-3">
        <a href="/" class="block hover:opacity-95 transition-opacity">
          <img src="/images/careerbridge_brand_logo.png" alt="CareerBridge" class="h-14 sm:h-16 w-auto object-contain" />
        </a>
      </div>
    </div>
    <div>
      <a href="/" class="text-xs font-bold text-gray-500 hover:text-gray-900 transition-colors uppercase tracking-wider">← Back to Home</a>
    </div>
  </header>

  <!-- Register Card Form Container: Boxy Corner Design -->
  <main class="w-full max-w-[460px] mx-auto px-4 py-6">
    <div class="bg-white rounded-none shadow-xl p-8 sm:p-10 border border-gray-200">
      
      <!-- Card Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Sign Up</h1>
      </div>

      <!-- Register Form -->
      {{> registrationForm prefix="register_"}}

      {{#unless pendingGoogle}}
      <!-- OR Divider -->
      <div class="relative flex py-5 items-center">
        <div class="flex-grow border-t border-gray-200"></div>
        <span class="flex-shrink mx-4 text-xs font-medium text-gray-400 uppercase">or</span>
        <div class="flex-grow border-t border-gray-200"></div>
      </div>

      {{/unless}}
      <!-- Google Sign In (Boxy) -->
      {{#unless pendingGoogle}}<a
        href="/auth/google?intent=register&amp;role={{registrationRole}}" data-google-register
        class="w-full flex items-center justify-center gap-3 py-2.5 px-4 border border-gray-300 rounded-none text-sm font-semibold text-slate-700 hover:bg-gray-50 hover:border-gray-400 transition-all shadow-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Sign up with Google
      </a>{{/unless}}

      {{#if pendingGoogle}}<form action="/register/cancel-google" method="post" class="mt-4"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="text-xs text-gray-500 underline">Use another account or account type</button></form>{{/if}}
<!-- Bottom Prompt: Log in -->
      <p class="text-center text-xs text-slate-600 mt-5">
        Already have an account? 
        <a href="/login" class="font-bold text-[#007042] hover:text-[#005a35] underline underline-offset-2">Log in</a>
      </p>

      <!-- Terms & Privacy -->
      <p class="text-center text-[11px] text-gray-400 mt-5 leading-relaxed">
        By creating an account, you agree to CareerBridge's 
        <a href="#" class="underline text-gray-500 hover:text-gray-700">Terms</a> & 
        <a href="#" class="underline text-gray-500 hover:text-gray-700">Privacy Policy</a>
      </p>

    </div>
  </main>

  <!-- Footer Help Link -->
  <footer class="w-full text-right px-6 sm:px-10 py-5">
    <a href="#help" class="text-xs font-semibold text-gray-500 hover:text-gray-800 hover:underline">Need Help?</a>
  </footer>

  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.style.opacity = isPassword ? '0.7' : '1';
    }
  </script>
</body>
</html>

{{> head }}
<body data-initial-auth="{{#if openLoginModal}}login{{else}}{{#if openRegisterModal}}register{{/if}}{{/if}}" class="bg-white text-slate-800 antialiased selection:bg-rose-500 selection:text-white">
{{#unless openLoginModal}}{{#unless openRegisterModal}}<div class="auth-status">{{> messages}}</div>{{/unless}}{{/unless}}

  <!-- TOP NAVIGATION BAR (Logos pushed far left, Buttons pushed far right) -->
  {{> publicHeader}}

  <!-- 1. WHAT IS BSTM CAREERBRIDGE? SECTION (WITH HOSTEL PHOTO BACKGROUND + BOXY CORNER DESIGN) -->
  <section id="about-section" class="relative py-20 lg:py-28 overflow-hidden border-b border-gray-100">
    
    <!-- Background Image: MinSU Hostel Campus Photo with Clean White Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="/images/about_hostel_bg.jpg" alt="MinSU Bongabong Hostel" class="w-full h-full object-cover object-center filter brightness-[0.85] contrast-[1.05]" />
      <div class="absolute inset-0 bg-white/85 backdrop-blur-[2px]"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Side: Boxy Corner Badges with subtle border -->
        <div class="lg:col-span-5 relative flex flex-col gap-4 pt-4">

          <!-- Badge 1: BSTM MinSU (Boxy) -->
          <div class="bg-white/95 backdrop-blur-md rounded-none p-5 shadow-md border border-gray-200 flex items-center justify-between">
            <span class="text-2xl font-black text-[#E11D48] tracking-tight">BSTM</span>
            <div class="text-right">
              <p class="text-xs font-semibold text-slate-700">Bachelor of Science in</p>
              <p class="text-xs font-medium text-slate-500">Tourism Management •</p>
              <p class="text-xs text-gray-400">MinSU Bongabong Campus</p>
            </div>
          </div>

          <!-- Badge 2: Academic Period (Boxy with Green Highlight) -->
          <div class="bg-white/95 backdrop-blur-md rounded-none p-5 shadow-md border border-gray-200 border-l-4 border-l-[#16a34a] flex items-center justify-between">
            <div class="flex flex-col">
              <span class="text-lg font-black text-[#16a34a] leading-tight">Oct–</span>
              <span class="text-lg font-black text-[#16a34a] leading-tight">Dec</span>
            </div>
            <div class="text-right">
              <p class="text-xs font-semibold text-slate-700">Graduating Academic Year</p>
              <p class="text-xs text-gray-500">Assessment Period 2026</p>
            </div>
          </div>

          <!-- Badge 3: AI Matching (Boxy) -->
          <div class="bg-white/95 backdrop-blur-md rounded-none p-5 shadow-md border border-gray-200 flex items-center justify-between">
            <span class="text-2xl font-black text-[#E11D48] tracking-tight">AI</span>
            <div class="text-right">
              <p class="text-xs font-semibold text-slate-700">Rule-based and algorithmic</p>
              <p class="text-xs text-gray-500">career-matching logic</p>
            </div>
          </div>

        </div>

        <!-- Right Side: Content Boxy Card with Corner Design -->
        <div class="lg:col-span-7 bg-white/95 backdrop-blur-md rounded-none p-8 sm:p-10 border border-gray-200 shadow-md space-y-6">
          
          <!-- Tag -->
          <span class="inline-block px-3.5 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-[#E11D48] bg-rose-100/90 border border-rose-200">
            ACADEMIC PLATFORM
          </span>

          <!-- Main Heading -->
          <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-slate-900 tracking-tight leading-tight">
            What is BSTM <br class="hidden sm:block"/>
            CareerBridge?
          </h1>

          <!-- Body Description -->
          <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
            <strong class="text-slate-900 font-bold">BSTM CareerBridge</strong> is a dedicated web application developed as an institutional technology tool for graduating <strong class="text-slate-900 font-bold">Bachelor of Science in Tourism Management (BSTM)</strong> students at <strong class="text-slate-900 font-bold">Mindoro State University – Bongabong Campus</strong>.
          </p>

          <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
            The system systematically evaluates student competency readiness across key tourism disciplines, compares profiles against standard career criteria, and produces individualized knowledge-gap assessments and ranked career recommendations.
          </p>

          <!-- 4 Core Pillars with Green Checkmarks -->
          <div class="space-y-4 pt-2">
            
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-none bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 border border-emerald-300">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="text-xs sm:text-sm">
                <span class="font-bold text-slate-900 mr-2">Comprehensive Competency Assessment:</span>
                <span class="text-slate-600">Evaluates key domains (Tourism Core, Communication, Workplace Skills, and Digital Tools).</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-none bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 border border-emerald-300">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="text-xs sm:text-sm">
                <span class="font-bold text-slate-900 mr-2">Intelligent Career Matching:</span>
                <span class="text-slate-600">Matches qualifications, OJT experience, and preferences with 7+ tourism career pathways.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-none bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 border border-emerald-300">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="text-xs sm:text-sm">
                <span class="font-bold text-slate-900 mr-2">Actionable Knowledge-Gap Insights:</span>
                <span class="text-slate-600">Highlights specific areas where additional preparation or certifications are beneficial.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-none bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 border border-emerald-300">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="text-xs sm:text-sm">
                <span class="font-bold text-slate-900 mr-2">Faculty & Coordinator Oversight:</span>
                <span class="text-slate-600">Equips faculty administrators with real-time class analytics and evaluation summaries.</span>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- 4 Stat Highlight Cards Below (Boxy) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-16 pt-8 border-t border-gray-200">
        
        <div class="bg-white/95 rounded-none p-6 border border-gray-200 shadow-sm">
          <div class="text-3xl lg:text-4xl font-extrabold text-[#E11D48] tracking-tight">{{stats.students}}</div>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Graduating BSTM Students at MinSU Bongabong Campus
          </p>
        </div>

        <div class="bg-white/95 rounded-none p-6 border border-gray-200 shadow-sm">
          <div class="text-3xl lg:text-4xl font-extrabold text-[#16a34a] tracking-tight">4</div>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Skill Domains Assessed: Industry, Communication, Workplace & Digital
          </p>
        </div>

        <div class="bg-white/95 rounded-none p-6 border border-gray-200 shadow-sm">
          <div class="text-3xl lg:text-4xl font-extrabold text-[#E11D48] tracking-tight">{{stats.pathways}}</div>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Tourism & Hospitality Career Pathways in Database
          </p>
        </div>

        <div class="bg-white/95 rounded-none p-6 border border-gray-200 shadow-sm">
          <div class="text-3xl lg:text-4xl font-extrabold text-[#16a34a] tracking-tight">10</div>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Assessment Sections for a Complete Student Readiness Profile
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. FREQUENTLY ASKED QUESTIONS SECTION (CENTERED TEXT AS REQUESTED) -->
  <section id="faq-section" class="py-20 lg:py-28 bg-[#FAFAFA]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center space-y-3 mb-14">
        <span class="inline-block px-3.5 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-[#E11D48] bg-rose-100/90 border border-rose-200">
          FAQ
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto">
          Clear answers to common questions about assessment procedures, account access, and career matches.
        </p>
      </div>

      <!-- FAQ Accordion List (Boxy + Centered Text) -->
      <div class="space-y-3.5">
        
        <!-- FAQ 1 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(1)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span><!-- Spacer for centering -->
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">Who can use BSTM CareerBridge?</span>
            <svg id="faq-icon-1" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-1" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            BSTM CareerBridge is designed specifically for graduating Bachelor of Science in Tourism Management students at Mindoro State University – Bongabong Campus, as well as BSTM faculty and research evaluators who oversee the readiness assessment program.
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(2)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span>
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">Is participation in the assessment required?</span>
            <svg id="faq-icon-2" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-2" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            Participation is highly encouraged for all graduating BSTM students as part of the department's career preparation and academic research benchmarking. It helps students understand their industry strengths and areas for improvement.
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(3)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span>
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">How does the career-matching algorithm work?</span>
            <svg id="faq-icon-3" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-3" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            The algorithmic engine evaluates student responses across 10 structured sections covering tourism domains, workplace skills, communication, and digital PMS tools. It matches these competency ratings against job profiles in 7+ key tourism sectors.
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(4)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span>
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">Will the career match guarantee immediate employment?</span>
            <svg id="faq-icon-4" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-4" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            CareerBridge is an academic diagnostic and career-guidance tool, not an employment agency. It gives students personalized insight into which careers best suit their existing skill set and where they should focus additional development.
          </div>
        </div>

        <!-- FAQ 5 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(5)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span>
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">Is my personal assessment data kept confidential?</span>
            <svg id="faq-icon-5" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-5" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            Yes. All individual scores and responses are treated with strict confidentiality in accordance with Republic Act 10173 (Data Privacy Act of 2012) and university research ethics standards.
          </div>
        </div>

        <!-- FAQ 6 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(6)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span>
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">Can I retake the assessment to update my scores?</span>
            <svg id="faq-icon-6" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-6" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            Depending on campus coordinator policy, students may request an assessment reset or update their profile after completing supplemental skills training or OJT experiences.
          </div>
        </div>

        <!-- FAQ 7 -->
        <div class="bg-white rounded-none border border-gray-200 overflow-hidden shadow-sm">
          <button onclick="toggleFaq(7)" class="w-full px-6 py-4 flex items-center justify-between hover:bg-gray-50/70 transition-colors">
            <span class="w-4"></span>
            <span class="text-sm sm:text-base font-bold text-slate-900 text-center flex-1">How do I log in or create my student account?</span>
            <svg id="faq-icon-7" class="w-4 h-4 text-rose-500 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="faq-content-7" class="px-6 pb-4 pt-2 text-xs sm:text-sm text-slate-600 text-center hidden border-t border-gray-100 leading-relaxed">
            Click "Sign Up" in the navigation bar, enter your Full Name, official Student ID (e.g. 2021-0001), your Section (-1, -2, -3, or -4), email, and password. If you already have an account, click "Log In".
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[#111827] text-gray-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <!-- Col 1: Brand & 3 Identical Logos + Transparent CareerBridge Logo -->
        <div class="space-y-4">
          <div class="flex items-center space-x-2.5">
            <img src="/images/minsu_seal.png" alt="MinSU Seal" class="h-10 w-10 object-contain" />
            <img src="/images/cbm_logo.png" alt="CBM Logo" class="h-10 w-10 object-contain" />
            <img src="/images/council_tourism_logo.png" alt="Council of Tourism Students" class="h-11 w-11 object-contain" />
          </div>
          <div class="mt-2">
            <img src="/images/careerbridge_brand_logo.png" alt="CareerBridge" class="h-12 w-auto object-contain brightness-110 mb-2" />
            <p class="text-xs text-gray-400 leading-relaxed">
              Technology-based knowledge-readiness assessment and career matching platform for graduating BSTM students at Mindoro State University – Bongabong Campus.
            </p>
          </div>
        </div>

        <!-- Col 2: Navigation -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Navigation</h6>
          <ul class="space-y-2 text-xs">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li><a href="/#features" class="hover:text-white transition-colors">Platform Features</a></li>
            <li><a href="/#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
            <li><a href="/#who-its-for" class="hover:text-white transition-colors">Who It's For</a></li>
          </ul>
        </div>

        <!-- Col 3: About & Help -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">About & Help</h6>
          <ul class="space-y-2 text-xs">
            <li><a href="#about-section" class="hover:text-white transition-colors">About CareerBridge</a></li>
            <li><a href="#faq-section" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
            <li><a href="/#features" class="hover:text-white transition-colors">Core Competencies</a></li>
          </ul>
        </div>

        <!-- Col 4: Access Portal (Opens Modals) -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Access Portal</h6>
          <ul class="space-y-2 text-xs">
            <li><button onclick="openLoginModal()" class="hover:text-white transition-colors text-left">Student Sign In</button></li>
            <li><button onclick="openRegisterModal()" class="hover:text-white transition-colors text-left">Create Student Account</button></li>
            <li><button onclick="openLoginModal()" class="hover:text-white transition-colors text-left">Faculty / Admin Sign In</button></li>
          </ul>
        </div>

      </div>

      <!-- Bottom Line -->
      <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500">
        <div>
          &copy; 2026 BSTM CareerBridge • Mindoro State University Bongabong Campus
        </div>
        <div class="mt-2 sm:mt-0 font-medium text-gray-400">
          College of Business and Management (CBM) • Council of Tourism Students
        </div>
      </div>

    </div>
  </footer>

  <!-- ================= POPUP MODALS IN ABOUT PAGE (Fixes the green screen issue) ================= -->
  
  {{> publicAuthDialogs}}
</body>
</html>

<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{badge.title}} · CareerBridge badge</title><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/portal.css"></head><body><main class="page" style="max-width:800px;margin:auto"><section class="card"><p class="eyebrow">CAREERBRIDGE · COURSE BADGE</p><span class="award-art badge">{{> achievementArt type="badge"}}</span><h1>{{badge.title}}</h1><p>Earned by <strong>{{recipientName}}</strong> · Issued {{badge.date}}</p><p>This badge represents the earned module achievements listed below.</p>{{#each badge.modules}}<section><h2>{{moduleTitle}}</h2><ul>{{#each skills}}<li>{{this}}</li>{{/each}}</ul></section>{{else}}<p>Course completion recorded. No separate module skills recorded.</p>{{/each}}<a class="button secondary" href="/">Visit CareerBridge</a></section></main></body></html>
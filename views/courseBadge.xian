<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{badge.title}} · CareerBridge badge</title><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/portal.css"></head><body><main class="page" style="max-width:800px;margin:auto"><section class="card"><p class="eyebrow">CAREERBRIDGE · COURSE BADGE</p><span class="award-art badge">{{> achievementArt type="badge"}}</span><h1>{{badge.title}}</h1><p>Earned by <strong>{{recipientName}}</strong> · Issued {{badge.date}}</p><p>This badge represents the earned module achievements listed below.</p><h2>Completed modules</h2><ul>{{#each badge.modules}}<li>{{moduleTitle}}</li>{{else}}<li>No separate completed module records available.</li>{{/each}}</ul><a class="button secondary" href="/">Visit CareerBridge</a></section></main></body></html>
{{#if admin}}{{> adminTop}}{{else}}{{#if faculty}}{{> facultyTop}}{{else}}{{> studentTop}}{{/if}}{{/if}}<div class="toolbar"><p class="muted">Course updates, feedback, deadlines and achievements in one place.</p><form method="post" action="/notifications/read"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary">Mark all as read</button></form></div><section class="card">{{#each notifications}}<article class="notification-item {{#if unread}}unread{{/if}}"><div><div class="row"><h3>{{title}}</h3>{{#if unread}}<span class="chip pink">New</span>{{/if}}</div><p class="lesson-body">{{message}}</p><small>{{date}}</small></div><form method="post" action="/notifications/{{id}}/open"><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button secondary">Open update →</button></form></article>{{else}}<div class="empty"><h2>You're up to date.</h2><p>Your learning and account updates will appear here.</p></div>{{/each}}</section>{{> studentBottom}}

{{> facultyTop}}<form class="toolbar" method="get"><label class="field grow">Search assigned students<input name="q" value="{{q}}" placeholder="Name, Student ID or section"></label><button class="button secondary">Search</button></form><section class="card"><div class="table-wrap"><table><thead><tr><th>Student</th><th>Student ID</th><th>Section</th><th></th></tr></thead><tbody>{{#each students}}<tr><td>{{name}}</td><td>{{studentId}}</td><td>{{section}}</td><td><a class="text-link" href="/faculty/students/{{id}}">View learning record →</a></td></tr>{{else}}<tr><td colspan="4" class="empty">No matching assigned students.</td></tr>{{/each}}</tbody></table></div></section>{{> studentBottom}}

{{> facultyTop}}<form class="actions faculty-progress-actions" method="get"><label class="field grow">Search students<input name="q" value="{{q}}" placeholder="Name or Student ID"></label><label class="field">Gender<select name="gender"><option value="">All</option><option value="Female" {{selected gender 'Female'}}>Female</option><option value="Male" {{selected gender 'Male'}}>Male</option></select></label><label class="field">Progress<select name="status"><option value="">All</option><option value="not-started" {{selected status 'not-started'}}>Not Started</option><option value="ongoing" {{selected status 'ongoing'}}>Ongoing</option><option value="completed" {{selected status 'completed'}}>Completed</option></select></label><button class="button secondary">Filter</button></form><nav class="actions faculty-progress-actions space-top" aria-label="Student progress tools"><a class="button secondary" href="/faculty/monitoring">Full progress report</a><a class="button secondary" href="/faculty/evaluations">Grade practicals</a><a class="button secondary" href="/faculty/assignments">Course assignments</a><a class="button secondary" href="/faculty/announcements">Student announcements</a></nav>{{#each students}}<section class="card space-top"><div class="row"><div><h2>{{name}}</h2><p>{{studentId}} · {{section}} · {{gender}}</p></div><div class="actions faculty-progress-actions"><span class="chip">{{learningStatus}}</span><a class="button secondary" href="/faculty/students/{{id}}">Learning record</a></div></div>{{#each progressRows}}<p>{{title}} · {{done}} / {{total}} lessons · {{percent}}% · Final score {{score}}{{#if inactive}} <span class="chip pink">Inactive 7+ days</span>{{/if}}</p>{{/each}}</section>{{else}}<section class="card"><p>No matching students enrolled in your courses.</p></section>{{/each}}{{> studentBottom}}

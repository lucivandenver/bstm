{{> facultyTop}}<div class="toolbar"><p class="muted">Your courses only. Module quiz results appear after submission. Final assessment scores appear after the course final is submitted. Active time excludes idle browser time.</p><a class="button secondary" href="/faculty/reports?export=xlsx">Download Excel ↓</a></div><section class="card"><div class="table-wrap faculty-progress-report" tabindex="0" role="region" aria-label="Learning attempts"><table><thead><tr><th>Student / section</th><th>Course / attempt</th><th>Progress & status</th><th>Module quizzes / final assessment</th><th>Time</th><th>Last activity</th></tr></thead><tbody>{{#each attempts}}<tr><td><a href="/faculty/students/{{student.id}}">{{student.name}}</a><small>{{student.section}}</small></td><td>{{title}}<small>Attempt {{attemptNumber}}{{#if retaking}} · Retake{{/if}}</small></td><td><span class="chip">{{statusLabel}}</span><small>{{percent}}% · {{done}} / {{total}}</small>{{#if awaiting}}<span class="chip pink">Awaiting grading</span>{{/if}}{{#if inactive}}<span class="chip pink">Inactive · 7+ days</span>{{/if}}</td><td>{{> facultyAssessmentScores}}</td><td>{{minutes}} active min<small>{{elapsedDays}} elapsed days</small></td><td>{{lastActivity}}</td></tr>{{else}}<tr><td colspan="6" class="empty">No course attempts in your assigned sections.</td></tr>{{/each}}</tbody></table></div></section><div class="grid cols-2 space-top"><section class="card"><h2>Competency & skills-gap summary</h2><div class="table-wrap faculty-progress-report" tabindex="0" role="region" aria-label="Learning attempts"><table><thead><tr><th>Area</th><th>Assessed students</th><th>Average</th><th>Below 75%</th></tr></thead><tbody>{{#each domainSummary}}<tr><td>{{name}}</td><td>{{assessed}}</td><td>{{average}}</td><td>{{gaps}}</td></tr>{{/each}}</tbody></table></div><p class="small muted">This summary uses completed-course evidence and the latest diagnostic. Individual module quiz scores appear in the learning attempts above.</p></section><section class="card"><h2>Section completion summary</h2><div class="table-wrap faculty-progress-report" tabindex="0" role="region" aria-label="Learning attempts"><table><thead><tr><th>Section</th><th>Students</th><th>Attempts</th><th>Modules passed</th><th>Course attempts completed</th></tr></thead><tbody>{{#each sectionSummary}}<tr><td>{{name}}</td><td>{{students}}</td><td>{{attempts}}</td><td>{{modulesPassed}} / {{modulesTotal}}</td><td>{{coursesCompleted}}</td></tr>{{/each}}</tbody></table></div><p class="small muted">Course completion requires passing all modules and the final assessment, plus any required activities or feedback.</p></section></div>{{> studentBottom}}

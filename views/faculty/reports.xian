{{> facultyTop}}<div class="toolbar"><p class="muted">Assigned sections only. Active time excludes hidden or idle browser time; elapsed time starts at enrollment.</p><a class="button secondary" href="/faculty/reports?export=csv">Download CSV ↓</a></div><section class="card"><div class="table-wrap"><table><thead><tr><th>Student / section</th><th>Course / attempt</th><th>Progress & status</th><th>Final knowledge score</th><th>Time</th><th>Last activity</th></tr></thead><tbody>{{#each attempts}}<tr><td><a href="/faculty/students/{{student.id}}">{{student.name}}</a><small>{{student.section}}</small></td><td>{{title}}<small>Attempt {{attemptNumber}}{{#if retaking}} · Retake{{/if}}</small></td><td><span class="chip">{{statusLabel}}</span><small>{{percent}}% · {{done}} / {{total}}</small>{{#if awaiting}}<span class="chip pink">Awaiting grading</span>{{/if}}{{#if inactive}}<span class="chip pink">Inactive · 7+ days</span>{{/if}}</td><td>{{finalScore}}</td><td>{{minutes}} active min<small>{{elapsedDays}} elapsed days</small><small>{{assessmentMinutes}} assessment min</small></td><td>{{lastActivity}}</td></tr>{{else}}<tr><td colspan="6" class="empty">No course attempts in your assigned sections.</td></tr>{{/each}}</tbody></table></div></section><div class="grid cols-2 space-top"><section class="card"><h2>Competency & skills-gap summary</h2><div class="table-wrap"><table><thead><tr><th>Area</th><th>Assessed students</th><th>Average</th><th>Below 75%</th></tr></thead><tbody>{{#each domainSummary}}<tr><td>{{name}}</td><td>{{assessed}}</td><td>{{average}}</td><td>{{gaps}}</td></tr>{{/each}}</tbody></table></div><p class="small muted">Latest valid learning evidence per student; unassessed areas are excluded from averages.</p></section><section class="card"><h2>Section completion summary</h2><div class="table-wrap"><table><thead><tr><th>Section</th><th>Students</th><th>Attempts</th><th>Completed</th></tr></thead><tbody>{{#each sectionSummary}}<tr><td>{{name}}</td><td>{{students}}</td><td>{{attempts}}</td><td>{{completed}}</td></tr>{{/each}}</tbody></table></div></section></div>{{> studentBottom}}

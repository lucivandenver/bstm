{{> facultyTop}}<section class="card"><h2>Add a reusable question</h2><form method="post" action="/faculty/questions" data-question-form><input type="hidden" name="_csrf" value="{{csrf}}"><label class="field">Question<textarea name="prompt" required minlength="8" maxlength="1500" rows="3"></textarea></label><label class="field">Answer choices · one per line<textarea data-options name="optionsText" rows="4" required placeholder="Choice A&#10;Choice B&#10;Choice C"></textarea></label><input type="hidden" name="options"><div class="grid cols-2"><label class="field">Correct choice number<input name="answerNumber" type="number" min="1" max="6" value="1" required></label><input type="hidden" name="answer"><label class="field">Competency<select name="domain">{{#each domains}}<option>{{this}}</option>{{/each}}</select></label></div><label class="field">Explanation<textarea name="explanation" rows="3" required></textarea></label><label class="field">Source reference<input name="sourceReference" maxlength="200"></label><label class="field">Supporting source quote<textarea name="sourceQuote" rows="2" maxlength="1200"></textarea></label><label class="check-label"><input type="checkbox" name="reviewed" value="true"> I verified the question, answer and explanation.</label><button class="button space-top">Add to question bank</button></form></section><section class="space-top"><h2>Your question library</h2><p class="small muted">Reviewed questions can be inserted from the course editor.</p>{{#each questions}}<details class="card space-top"><summary>{{prompt}} · {{#if reviewed}}Reviewed{{else}}Needs review{{/if}}</summary><form action="/faculty/questions/{{id}}" method="post" data-question-form><input type="hidden" name="_csrf" value="{{../csrf}}"><label class="field">Question<textarea name="prompt" required>{{prompt}}</textarea></label><label class="field">Choices · one per line<textarea data-options data-choices="{{json options}}" name="optionsText" required></textarea></label><input type="hidden" name="options"><label class="field">Correct choice (number starting at 1)<input name="answerNumber" type="number" min="1" max="6" data-answer-index="{{answer}}" required></label><input type="hidden" name="answer"><label class="field">Competency<select name="domain">{{#each ../domains}}<option {{selected this ../domain}}>{{this}}</option>{{/each}}</select></label><label class="field">Explanation<textarea name="explanation">{{explanation}}</textarea></label><label class="field">Source reference<input name="sourceReference" value="{{sourceReference}}"></label><label class="field">Source quote<textarea name="sourceQuote">{{sourceQuote}}</textarea></label><label class="check-label"><input type="checkbox" name="reviewed" value="true" {{#if reviewed}}checked{{/if}}> Reviewed</label><label class="check-label"><input type="checkbox" name="active" value="false" {{#unless active}}checked{{/unless}}> Archive this question</label><button class="button space-top">Save question</button></form></details>{{else}}<div class="card empty">No questions saved yet.</div>{{/each}}</section>{{> studentBottom}}

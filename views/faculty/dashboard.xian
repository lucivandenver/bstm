{{> facultyTop}}<div class="page-heading"><div><p class="eyebrow">FACULTY MONITORING</p><h1>Welcome, {{currentUser.name}}.</h1><p class="muted">Monitor the students in sections assigned to you by Admin.</p></div></div><div class="grid cols-3"><div class="card stat"><span class="label">Assigned sections</span><strong class="value">{{sections.length}}</strong></div><div class="card stat"><span class="label">Students</span><strong class="value">{{students.length}}</strong></div><div class="card stat"><span class="label">Completed attempts in recent activity</span><strong class="value">{{completed}}</strong></div></div><section class="card space-top"><h2>My sections</h2>{{#each sections}}<span class="chip">{{name}} · {{academicYear}}</span> {{else}}<p class="muted">No assigned sections yet. Ask Admin to assign your approved faculty account.</p>{{/each}}</section><section class="card space-top"><h2>Assigned students</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Student ID</th><th>Section</th></tr></thead><tbody>{{#each students}}<tr><td>{{name}}</td><td>{{studentId}}</td><td>{{section}}</td></tr>{{else}}<tr><td colspan="3" class="empty">No assigned students.</td></tr>{{/each}}</tbody></table></div></section><section class="card space-top"><h2>Recent learning attempts</h2><p class="small muted">Up to 300 recent attempts. Active time is estimated, not verified attendance.</p><div class="table-wrap"><table><thead><tr><th>Student</th><th>Course</th><th>Attempt</th><th>Status</th><th>Final score</th><th>Active minutes</th><th>Started</th></tr></thead><tbody>{{#each attempts}}<tr><td>{{name}}</td><td>{{title}}</td><td>{{attempt}}</td><td>{{status}}</td><td>{{score}}</td><td>{{minutes}}</td><td>{{started}}</td></tr>{{else}}<tr><td colspan="7" class="empty">No course activity in your assigned sections.</td></tr>{{/each}}</tbody></table></div></section>{{> studentBottom}}

{{> facultyTop}}<div class="hero-banner"><div><p class="eyebrow">YOUR TEACHING WORKSPACE</p><h2>Support the next step.</h2><p>Build learning experiences and monitor students in the courses you publish.</p><div class="actions"><a class="button light" href="/faculty/upload">Upload & generate</a><a class="button light secondary" href="/faculty/students">View student progress</a></div></div></div><div class="stats-grid space-top"><div class="stat-card"><span class="stat-card-icon">{{> icon name="users"}}</span><small>Students in my courses</small><strong>{{studentCount}}</strong></div><div class="stat-card"><span class="stat-card-icon">{{> icon name="book"}}</span><small>Published courses</small><strong>{{publishedCount}}</strong></div><div class="stat-card {{#if pendingCredentials}}publication-needs-review{{/if}}"><span class="stat-card-icon">{{> icon name="certificate"}}</span><small>Credential requests pending</small><strong>{{pendingCredentials}}</strong><a href="/faculty/credentials">Review status</a></div><div class="stat-card"><span class="stat-card-icon">{{> icon name="play"}}</span><small>Active learners</small><strong>{{active}}</strong></div><div class="stat-card"><span class="stat-card-icon">{{> icon name="chart"}}</span><small>Completion rate</small><strong>{{completionRate}}%</strong></div><a class="stat-card" href="/faculty/evaluations"><span class="stat-card-icon">{{> icon name="clock"}}</span><small>Awaiting grading</small><strong>{{pending}}</strong></a></div><div class="grid cols-2 space-top"><section class="card"><h2>Course section targets</h2>{{#each sections}}<p class="assignment-item"><strong>{{name}}</strong><span>{{academicYear}}</span></p>{{else}}<div class="empty">Faculty are not assigned to sections. Learner monitoring follows course enrollments and course-section assignments.</div>{{/each}}{{#each students}}<p class="small"><a class="text-link" href="/faculty/students/{{id}}">{{name}} · {{studentId}}</a></p>{{/each}}<a class="text-link" href="/faculty/students">Open student records →</a></section><section class="card"><h2>Students needing a check-in</h2><p class="small muted">No recorded learning activity for at least 7 days in an ongoing course.</p>{{#each support}}<p><a class="text-link" href="/faculty/students/{{id}}">{{name}} · {{section}} →</a></p>{{else}}<div class="empty">No inactive learners to flag.</div>{{/each}}</section></div>{{> studentBottom}}

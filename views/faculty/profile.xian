{{> facultyTop}}<div class="page-heading"><div><p class="eyebrow">FACULTY ACCOUNT</p><h1>My profile</h1></div></div><section class="card"><form method="post" action="/faculty/profile"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="grid cols-3"><div class="field"><label>Full name<input name="name" value="{{currentUser.name}}" required minlength="2" maxlength="100"></label></div><div class="field"><label>Faculty ID<input value="{{currentUser.facultyId}}" readonly></label></div><div class="field"><label>Email<input value="{{currentUser.email}}" readonly></label></div></div><button class="button space-top">Save profile</button></form><div class="divider"></div>{{#if googleConnected}}<span class="chip">Google connected</span>{{else}}<form method="post" action="/faculty/connect-google"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary" {{#unless googleReady}}disabled{{/unless}}>Connect Google account</button></form>{{/if}}</section>{{> studentBottom}}

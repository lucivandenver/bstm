{{> facultyTop}}{{#if returned}}<section class="card"><strong>Registration returned for updates</strong><p>{{currentUser.facultyReviewRemarks}}</p><p>Update your faculty details below, then save to resubmit for approval.</p></section>{{/if}}<section class="card"><form method="post" action="/faculty/profile"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="grid cols-2"><div class="field"><label>Full name<input name="name" value="{{currentUser.name}}" required minlength="2" maxlength="100"></label></div><div class="field"><label>Faculty ID<input value="{{currentUser.facultyId}}" readonly></label></div><div class="field"><label>Email<input value="{{currentUser.email}}" readonly></label></div><div class="field"><label>Position<input name="facultyPosition" value="{{currentUser.facultyPosition}}" required maxlength="120"></label></div><div class="field"><label>Educational attainment / degree<input name="facultyEducation" value="{{currentUser.facultyEducation}}" required maxlength="200"></label></div><div class="field"><label>Relevant qualifications<textarea name="facultyQualifications" required maxlength="2000">{{currentUser.facultyQualifications}}</textarea></label></div></div><button class="button space-top">Save profile</button></form><div class="divider"></div>{{#if googleConnected}}<span class="chip">Google connected</span>{{else}}<form method="post" action="/faculty/connect-google"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary" {{#unless googleReady}}disabled{{/unless}}>Connect Google account</button></form>{{/if}}</section><section class="card space-top" id="faculty-signature">
  <h2>Certificate signature</h2>
  <p class="muted">Save one signature for your current and future certificates. A saved signature is required for publication.</p>
  <form method="post" action="/faculty/profile/signature" data-signature-form>
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <label class="field">Signature image<input type="file" accept="image/png,image/jpeg,image/webp" data-signature-file required></label>
    <input type="hidden" name="signature" data-signature-value>
    <p class="small muted" role="status" data-signature-status>Upload dark ink on a light background.</p>
    <img alt="Faculty signature preview" data-signature-preview {{#if savedSignature}}src="{{savedSignature}}"{{else}}hidden{{/if}} style="max-width:320px;max-height:120px">
    <div class="actions space-top"><button class="button">Save faculty signature</button></div>
  </form>
</section><script src="/js/signature.js" defer></script>{{> studentBottom}}

{{> facultyTop}}{{#if moduleState}}<p class="chip">{{moduleState}}</p>{{/if}}<div class="notice info">Student preview · no progress or awards are created here. Faculty answer keys appear below the lesson preview.</div>{{#unless moduleState}}<a class="button secondary" href="/faculty/courses/{{course.id}}/edit">← Continue editing</a>{{/unless}}<article class="card space-top"><span class="chip">{{#if course.competencyAreas}}{{#each course.competencyAreas}}{{this}}{{#unless @last}} • {{/unless}}{{/each}}{{else}}{{course.domain}}{{/if}} · {{course.level}}</span><h2>{{course.title}}</h2>{{#unless moduleState}}<p>{{course.description}}</p>{{/unless}}{{#each course.modules}}<details class="card space-top" open><summary>{{title}}</summary>{{> moduleOutcomes}}{{#each lessons}}<h3>{{title}}</h3><p class="lesson-body">{{body}}</p><ul>{{#each takeaways}}<li>{{this}}</li>{{/each}}</ul>{{/each}}</details>{{/each}}<h3 class="space-top">Assessment preview</h3>{{> questions}}{{#each course.tasks}}<section class="card space-top"><h3>{{title}}</h3><p class="lesson-body">{{instructions}}</p>{{#each rubric}}<p>{{label}} · {{max}} points</p>{{/each}}</section>{{/each}}</article>{{#unless course.published}}<section class="card space-top"><h2>Faculty review</h2>{{#each course.questions}}<details><summary>{{prompt}}</summary><p>Correct answer: {{lookup options answer}}</p><p>{{explanation}}</p><small>{{sourceReference}} · {{sourceQuote}}</small></details>{{/each}}{{#if generated}}<form method="post" action="/faculty/courses/{{course.id}}"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="version" value="{{course.version}}"><input type="hidden" name="action" value="approve-generated"><label class="check-label"><input type="checkbox" name="confirmReview" value="yes" required> I reviewed or edited the entire course above, including every lesson and all answer keys. Approve them together.</label><button class="button">Approve all reviewed content & publish</button></form>{{/if}}</section>{{/unless}}{{> studentBottom}}

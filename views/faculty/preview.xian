{{> facultyTop}}<div class="notice info">Student preview · no progress or awards are created here. Correct answer keys are hidden.</div><a class="button secondary" href="/faculty/courses/{{course.id}}/edit">← Continue editing</a><article class="card space-top"><span class="chip">{{course.domain}} · {{course.level}}</span><h2>{{course.title}}</h2><p>{{course.description}}</p><h3>Learning outcomes</h3><ul>{{#each course.outcomes}}<li>{{this}}</li>{{/each}}</ul>{{#each course.modules}}<details class="card space-top" open><summary>{{title}}</summary>{{#each lessons}}<h3>{{title}}</h3><p class="lesson-body">{{body}}</p><ul>{{#each takeaways}}<li>{{this}}</li>{{/each}}</ul>{{/each}}</details>{{/each}}<h3 class="space-top">Assessment preview</h3>{{> questions}}{{#each course.tasks}}<section class="card space-top"><h3>{{title}}</h3><p class="lesson-body">{{instructions}}</p>{{#each rubric}}<p>{{label}} · {{max}} points</p>{{/each}}</section>{{/each}}</article>{{> studentBottom}}

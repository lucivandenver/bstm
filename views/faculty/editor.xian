{{> facultyTop}}<div class="toolbar"><a class="text-link" href="/faculty/courses">← My courses</a>{{#if course.id}}<a class="button secondary" href="/faculty/courses/{{course.id}}/preview">Preview student experience</a>{{/if}}</div><div class="notice info">Saving an edit creates a new version and returns this course to draft. Existing student attempts keep their original lessons, questions and grading requirements.</div><form method="post" action="/faculty/courses{{#if course.id}}/{{course.id}}{{/if}}" id="course-editor"><input type="hidden" name="_csrf" value="{{csrf}}"><textarea name="courseData" id="course-state" hidden>{{json course}}</textarea><textarea id="bank-state" hidden>{{json bank}}</textarea><textarea id="domains-state" hidden>{{json domains}}</textarea><textarea id="prerequisites-state" hidden>{{json otherCourses}}</textarea><div id="editor-fields"></div><div class="editor-savebar"><p id="editor-status" class="small" role="status">Draft changes are saved when you choose Save draft.</p><div class="actions"><button class="button secondary" name="action" value="draft">Save draft</button><button class="button" name="action" value="publish">Review complete · Publish →</button></div></div></form><noscript><p class="notice">Enable JavaScript to use the structured course editor.</p></noscript><details class="card space-top"><summary>Version history</summary>{{#each revisions}}<p class="assignment-item">Version {{version}} · {{action}}<small>{{date}}</small></p>{{else}}<p class="empty">No previous versions.</p>{{/each}}</details><script src="/js/course-editor.js" defer></script>{{> studentBottom}}

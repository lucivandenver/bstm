{{> facultyTop}}{{#if signatureMissing}}<p class="notice info">Faculty signature missing. <a href="/faculty/credentials">Save your reusable signature</a> before Admin can publish this course with certificates.</p>{{/if}}{{#if moduleSubmissions}}<section id="module-submissions" class="card space-top"><h2>New modules for this published course</h2>
{{#each moduleSubmissions}}<details open><summary>{{snapshot.module.title}} · {{#if pending}}Pending Admin review{{else}}Draft{{/if}}</summary>
{{#each snapshot.module.lessons}}<h3>{{title}}</h3><p>{{body}}</p>{{/each}}
<ol>{{#each snapshot.questions}}<li><strong>{{prompt}}</strong><ol>{{#each options}}<li>{{this}}{{#if (eq @index ../answer)}} <strong>Correct answer</strong>{{/if}}</li>{{/each}}</ol><p>{{explanation}}</p></li>{{/each}}</ol>
{{#unless pending}}<form method="post" action="/faculty/courses/{{../course.id}}/modules/{{id}}/submit"><input type="hidden" name="_csrf" value="{{../csrf}}"><label><input type="checkbox" name="confirmReview" value="yes" required> I reviewed the topics and assessment.</label><button class="button">Submit module and certificate</button></form>{{/unless}}
</details>{{/each}}</section>{{/if}}
<div class="toolbar"><a class="text-link" href="/faculty/courses">← My courses</a>{{#if course.published}}<a class="button secondary" href="/faculty/upload?courseId={{course.id}}">Generate another module</a>{{/if}}{{#if course.id}}<a class="button secondary" href="/faculty/courses/{{course.id}}/preview">Preview student experience</a>{{/if}}</div>{{#if course.modules.length}}<section class="card space-top" id="original-material">
<h2>Attach original file</h2>
<p>Add a PDF to an existing module. Students can open it as learning material and confirm reading before taking the module quiz.</p>
<form method="post" action="/faculty/courses/{{course.id}}/material" enctype="multipart/form-data" data-module-material>
<input type="hidden" name="_csrf" value="{{csrf}}">
<label class="field">Module<select name="moduleId" required><option value="">Select a module</option>{{#each course.modules}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label>
<label class="field">Original PDF<input type="file" name="material" accept=".pdf,application/pdf" required></label>
<button type="submit" class="button" disabled>Attach original file</button>
<p role="status" data-material-status></p>
<noscript><p>Enable JavaScript to attach the PDF.</p></noscript>
</form></section><script src="/js/module-material.js" defer></script>{{/if}}<div class="notice info">Saving an edit returns this course to draft. Existing student attempts keep their original lessons, questions and grading requirements.</div><form method="post" action="/faculty/courses{{#if course.id}}/{{course.id}}{{/if}}" id="course-editor"><input type="hidden" name="_csrf" value="{{csrf}}"><textarea name="courseData" id="course-state" hidden>{{json course}}</textarea><textarea id="bank-state" hidden>{{json bank}}</textarea><textarea id="domains-state" hidden>{{json domains}}</textarea><textarea id="prerequisites-state" hidden>{{json otherCourses}}</textarea><div id="editor-fields"></div><div class="editor-savebar"><p id="editor-status" class="small" role="status">Draft changes are saved when you choose Save draft.</p><label class="check-label"><input type="checkbox" name="confirmReview" value="yes" required> I reviewed or edited the whole course, including every lesson, answer, and explanation.</label><div class="actions"><button class="button secondary" name="action" value="draft" formnovalidate>Save draft</button><button class="button" name="action" value="publish">Submit reviewed course for Admin approval</button></div></div></form>{{#if destinations}}<section class="card space-top"><h2>Attach a generated module to an existing course</h2>
<p>Save edits to this draft first. The module and its questions will be copied under the selected course and its existing badge.</p>
<form method="post" action="/faculty/courses/{{course.id}}/attach-module">
<input type="hidden" name="_csrf" value="{{csrf}}">
<label class="field">Existing course<select name="destinationId" required><option value="">Select a course</option>{{#each destinations}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label>
<label class="field">Generated module<select name="moduleId" required><option value="">Select a module</option>{{#each course.modules}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label>
<label class="field">Module name (optional)<input name="moduleTitle" maxlength="160" placeholder="Keep generated name"></label>
<label class="field">Module number<input type="number" name="moduleNumber" min="1" max="9999" required></label>
<button class="button secondary">Attach module</button>
</form></section>{{/if}}<noscript><p class="notice">Enable JavaScript to use the structured course editor.</p></noscript><script src="/js/course-editor.js" defer></script>{{> studentBottom}}

{{> facultyTop}}<div class="toolbar"><a class="text-link" href="/faculty/courses">← My courses</a>{{#if course.id}}<a class="button secondary" href="/faculty/courses/{{course.id}}/preview">Preview student experience</a>{{/if}}</div><div class="notice info">Saving an edit creates a new version and returns this course to draft. Existing student attempts keep their original lessons, questions and grading requirements.</div><form method="post" action="/faculty/courses{{#if course.id}}/{{course.id}}{{/if}}" id="course-editor"><input type="hidden" name="_csrf" value="{{csrf}}"><textarea name="courseData" id="course-state" hidden>{{json course}}</textarea><textarea id="bank-state" hidden>{{json bank}}</textarea><textarea id="domains-state" hidden>{{json domains}}</textarea><textarea id="prerequisites-state" hidden>{{json otherCourses}}</textarea><div id="editor-fields"></div><div class="editor-savebar"><p id="editor-status" class="small" role="status">Draft changes are saved when you choose Save draft.</p><label class="check-label"><input type="checkbox" name="confirmReview" value="yes" required> I reviewed or edited the whole course, including every lesson, answer, and explanation.</label><div class="actions"><button class="button secondary" name="action" value="draft" formnovalidate>Save draft</button><button class="button" name="action" value="publish">Submit reviewed course for Admin approval</button></div></div></form>{{#if destinations}}<section class="card space-top"><h2>Attach a generated module to an existing course</h2>
<p>Save edits to this draft first. The module and its questions will be copied under the selected course and its existing badge.</p>
<form method="post" action="/faculty/courses/{{course.id}}/attach-module">
<input type="hidden" name="_csrf" value="{{csrf}}">
<label class="field">Existing course<select name="destinationId" required><option value="">Select a course</option>{{#each destinations}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label>
<label class="field">Generated module<select name="moduleId" required><option value="">Select a module</option>{{#each course.modules}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label>
<label class="field">Module name (optional)<input name="moduleTitle" maxlength="160" placeholder="Keep generated name"></label>
<label class="field">Module number<input type="number" name="moduleNumber" min="1" max="9999" required></label>
<button class="button secondary">Attach module</button>
</form></section>{{/if}}<noscript><p class="notice">Enable JavaScript to use the structured course editor.</p></noscript><details class="card space-top"><summary>Version history</summary>{{#each revisions}}<p class="assignment-item">Version {{version}} · {{action}}<small>{{date}}</small></p>{{else}}<p class="empty">No previous versions.</p>{{/each}}</details><script src="/js/course-editor.js" defer></script>{{> studentBottom}}

{{> facultyTop}}<div class="grid cols-2"><section class="card"><h2>{{source.filename}}</h2><p class="small muted">Only the extracted text shown here is sent to Gemini. Do not include student records or confidential material.</p><div class="source-reader">{{#each source.sections}}<details open><summary>{{reference}}</summary><p>{{text}}</p></details>{{/each}}</div></section><section class="card"><h2>Set up your draft</h2><form method="post" action="/faculty/sources/{{source.id}}/generate" data-ai-form><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Competency area<select name="domain" required>{{#each domains}}<option>{{this}}</option>{{/each}}</select></label></div><div class="field"><label>Target learning outcomes<textarea name="outcomes" required maxlength="1500" rows="4" placeholder="What should students understand after this course?"></textarea></label></div><div class="grid cols-2"><div class="field"><label>Difficulty<select name="level"><option>Foundation</option><option>Intermediate</option><option>Advanced</option></select></label></div><div class="field"><label>Question count<input type="number" name="questionCount" min="3" max="30" value="8" required></label></div></div><label class="check-label"><input type="checkbox" name="consent" value="yes" required> I have permission to use this material and send its extracted text to Gemini.</label><button class="button space-top">Generate a course draft →</button></form><p class="small muted space-top">Nothing is published automatically. Unsupported source references are rejected. Your daily generation limit is set by Admin.</p></section></div>{{> studentBottom}}

{{> facultyTop}}
<div class="source-intro"><p class="eyebrow">SOURCE → DRAFT → REVIEW → PUBLISH</p><p class="muted">Your source is saved privately. A draft stays hidden from students until you review and publish it.</p></div>
<div class="grid cols-2"><section class="card"><div class="row between"><h2>{{source.filename}}</h2><form method="post" action="/faculty/sources/{{source.id}}/delete" data-confirm="Delete this source resource? Generated courses and learning records will remain unchanged."><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button danger" type="submit">Delete source</button></form></div><p class="small muted">Review the extracted text. Only this text is shared when you choose AI drafting. Scanned images need a text-based document.</p><div class="source-reader">{{#each source.sections}}<details open><summary>{{reference}}</summary><p>{{text}}</p></details>{{/each}}</div></section>
<section class="card"><h2>Set up your course draft</h2><p class="small muted">Choose the area this course teaches. Tourism knowledge is a competency area, alongside Communication, Workplace and Digital skills.</p>
<form method="post" action="/faculty/sources/{{source.id}}/generate" data-course-generation>
<input type="hidden" name="background" value="yes">
<input type="hidden" name="_csrf" value="{{csrf}}">
<fieldset class="field"><legend>Competency areas</legend><p class="small muted">Choose all areas covered by this course.</p>{{#each areas}}<label class="check-label"><input type="checkbox" name="domains" value="{{name}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}</fieldset>
<div class="field"><label>Target learning outcomes<textarea name="outcomes" required maxlength="1500" rows="4" placeholder="What should students understand after this course?">{{values.outcomes}}</textarea></label></div>
<div class="grid cols-2"><div class="field"><label>Difficulty<select name="level"><option {{selected values.level 'Foundation'}}>Foundation</option><option {{selected values.level 'Intermediate'}}>Intermediate</option><option {{selected values.level 'Advanced'}}>Advanced</option></select></label></div><div class="field"><label>Question count<input type="number" name="questionCount" min="3" max="30" value="{{values.questionCount}}" required></label></div></div>
{{#unless aiReady}}<p class="notice">AI drafting is temporarily unavailable. Ask Admin to configure or restore the AI provider, then retry. Your saved source remains available.</p>{{/unless}}
<label class="check-label"><input type="checkbox" name="consent" value="yes" required {{#if values.consent}}checked{{/if}}> I have permission to use this material and send its extracted text to Gemini.</label>
<div class="notice" role="alert" data-generation-error {{#unless error}}hidden{{/unless}}>{{#if error}}{{error.message}} ({{error.code}} · Reference {{error.reference}}){{/if}}</div>
<p class="small muted" role="status" aria-live="polite" data-generation-status></p>
</form><div class="actions space-top"><button class="button" name="mode" value="ai" {{#unless aiReady}}disabled{{/unless}}>Generate review-ready course</button></div><p class="small muted space-top">Large collections are analyzed in batches with a live progress page; all generated lessons and answers require faculty review before publishing.</p></section></div>
<script src="/js/faculty-generation.js" defer></script>{{> studentBottom}}

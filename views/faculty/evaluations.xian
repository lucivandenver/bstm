{{> facultyTop}}<p class="muted">Use the rubric frozen in the student's course version. Passed tasks and completed course records cannot be silently changed.</p>{{#each submissions}}<article class="card space-top"><div class="row between"><h2>{{name}} · {{task.title}}</h2><span class="chip">{{status}}</span></div><p class="small muted">{{courseTitle}} · {{date}}</p><p class="lesson-body">{{response}}</p>{{#if link}}<p><a class="text-link" href="{{link}}" target="_blank" rel="noopener noreferrer">Open evidence link ↗</a></p>{{/if}}<form method="post" action="/faculty/evaluations/{{id}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="grid cols-2">{{#each criteria}}<label class="field">{{label}} (max {{max}})<input type="number" name="scores[{{id}}]" min="0" max="{{max}}" step="0.5" value="{{score}}" required></label>{{/each}}</div><label class="field">Feedback<textarea name="feedback" rows="3" required maxlength="3000">{{feedback}}</textarea></label><button class="button">Save rubric evaluation</button>{{#if graded}}<span class="chip">Recorded grade: {{grade}}%</span>{{/if}}</form></article>{{else}}<section class="card empty"><h2>Nothing waiting for evaluation.</h2><p>Practical submissions from assigned students will appear here.</p></section>{{/each}}{{> studentBottom}}

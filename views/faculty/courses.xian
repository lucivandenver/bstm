{{> facultyTop}}{{#if databaseNotice}}<p class="notice info" role="status">{{databaseNotice}}</p>{{/if}}<div class="toolbar"><p class="muted">Draft privately. Review the questions. Publish when ready. Unpublishing makes course content editable and keeps learner history.</p><div class="actions"><a class="button" href="/faculty/upload">Upload &amp; generate</a></div></div><form class="toolbar" action="/faculty/courses" method="get" role="search">
  <label>Search courses or modules <input type="search" name="q" value="{{query}}" maxlength="160" placeholder="Enter a title"></label>
  <input type="hidden" name="list" value="{{#if archived}}archive{{else}}active{{/if}}">
  <button class="button secondary">Search</button>
</form>
<nav class="actions" aria-label="Course lists"><a href="{{activeUrl}}" {{#unless archived}}aria-current="page"{{/unless}}>My courses</a><a href="{{archiveUrl}}" {{#if archived}}aria-current="page"{{/if}}>Archive</a></nav>
<div class="grid cols-2">{{#each courses}}<article class="card course-card"><div class="course-art"><span>{{areaLabels competencyAreas domain}}</span><strong>{{level}}</strong></div><div class="row between"><span class="chip">{{#if published}}Published{{else}}{{#if ../archived}}Archived{{else}}{{#if pendingReview}}Pending Admin review{{else}}Draft{{/if}}{{/if}}{{/if}}</span><span class="small muted">Version {{version}}</span></div><details><summary>{{title}}</summary>
<h2>Course modules</h2>
<ul>{{#each modules}}<li>Module {{number}} · {{title}}</li>{{else}}<li>No modules yet.</li>{{/each}}</ul>
</details><p class="muted">{{description}}</p><p class="small">{{moduleCount}} modules · {{questionCount}} questions · {{minutes}} min</p><p class="small muted">{{enrolledStudents}} learners enrolled · {{activeLearners}} ongoing · {{completedAttempts}} completed attempts</p><div class="actions"><a class="button" href="/faculty/courses/{{id}}/edit">Edit course</a><a class="button secondary" href="/faculty/courses/{{id}}/preview">Preview</a>{{#if published}}<form method="post" action="/faculty/courses/{{id}}/archive" data-confirm="Unpublish this course? You can edit and republish it later; student progress and credentials remain preserved."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button ghost">Unpublish</button></form>{{/if}}{{#if deleteEligible}}<form method="post" action="/faculty/courses/{{id}}/delete" data-confirm="Permanently delete this unused draft? This cannot be undone."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger" type="submit">Delete draft</button></form>{{/if}}</div></article>{{else}}<div class="card empty"><h2>No matching courses</h2></div>{{/each}}</div>{{#if previousUrl}}<a class="button secondary" href="{{previousUrl}}" rel="prev">Previous</a>{{/if}}
<p class="small muted">Page {{page}} of {{pageCount}}</p>
{{#if nextUrl}}<a class="button secondary" href="{{nextUrl}}" rel="next">Next</a>{{/if}}
{{> studentBottom}}


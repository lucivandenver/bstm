{{> facultyTop}}{{#if databaseNotice}}<p class="notice info" role="status">{{databaseNotice}}</p>{{/if}}<div class="toolbar"><p class="muted">Draft privately. Review the questions. Publish when ready. Unpublishing makes course content editable and keeps learner history.</p><div class="actions"><a class="button" href="/faculty/upload">Upload &amp; generate</a></div></div><nav class="course-list-tabs" aria-label="Course lists">
  <a class="button {{#if archived}}secondary{{/if}}" href="{{activeUrl}}" {{#unless archived}}aria-current="page"{{/unless}}>My Courses</a>
  <a class="button {{#unless archived}}secondary{{/unless}}" href="{{archiveUrl}}" {{#if archived}}aria-current="page"{{/if}}>Archive</a>
</nav>
{{#if archived}}<p class="notice info">Use Delete permanently on an archived course to remove it and its associated learner records.</p>{{/if}}
<form class="card course-list-search" action="/faculty/courses" method="get" role="search">
  <label class="field">Search courses or modules<input type="search" name="q" value="{{query}}" maxlength="160" placeholder="Enter a course or module title"></label>
  <input type="hidden" name="list" value="{{#if archived}}archive{{else}}active{{/if}}">
  {{#unless archived}}<label class="field">Status<select name="status">
    <option value="">All statuses</option>
    <option value="pending" {{selected status "pending"}}>Pending Admin review</option>
    <option value="approved" {{selected status "approved"}}>Approved / Published</option>
    <option value="draft" {{selected status "draft"}}>Draft</option>
  </select></label>{{/unless}}
  <button class="button">Search</button>
</form>
<div class="grid cols-2">{{#each courses}}<article class="card course-card"><div class="course-art"><span>{{areaLabels competencyAreas domain}}</span><strong>{{level}}</strong><h2>{{title}}</h2></div><div class="row between"><span class="chip">{{#if published}}Published{{else}}{{#if ../archived}}Archived{{else}}{{#if pendingReview}}Pending Admin review{{else}}Draft{{/if}}{{/if}}{{/if}}</span></div><details><summary aria-label="{{title}}">View modules</summary>
<h2>Course modules</h2>
<ul>{{#each modules}}<li>Module {{number}} · {{title}} {{#if ../pendingReview}}<span class="chip">Pending Admin review</span>{{/if}}</li>{{else}}<li>No modules yet.</li>{{/each}}</ul>
</details><p class="muted">{{description}}</p><p class="small">{{moduleCount}} modules · {{questionCount}} questions · {{minutes}} min</p><p class="small muted">{{enrolledStudents}} learners enrolled · {{activeLearners}} ongoing · {{completedAttempts}} completed attempts</p><div class="actions">{{#unless published}}{{#unless pendingReview}}<a class="button secondary" href="/faculty/upload?courseId={{id}}">Generate module</a>{{/unless}}{{/unless}}<a class="button" href="/faculty/courses/{{id}}/edit">Edit course</a><a class="button secondary" href="/faculty/courses/{{id}}/preview">Preview</a>{{#if published}}<form method="post" action="/faculty/courses/{{id}}/archive" data-confirm="Unpublish this course? You can edit and republish it later; student progress and credentials remain preserved."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button ghost">Unpublish</button></form>{{/if}}{{#if ../archived}}<form method="post" action="/faculty/courses/{{id}}/archive/delete" data-confirm="Permanently delete this archived course and its student progress, scores, badges and certificates? This cannot be undone."><input type="hidden" name="_csrf" value="{{../csrf}}"><input type="hidden" name="confirmDelete" value="yes"><button class="button danger" type="submit">Delete permanently</button></form>{{else}}{{#if deleteEligible}}<form method="post" action="/faculty/courses/{{id}}/delete" data-confirm="Permanently delete this unused draft? This cannot be undone."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger" type="submit">Delete draft</button></form>{{/if}}{{/if}}</div></article>{{else}}<div class="card empty"><h2>No matching courses</h2></div>{{/each}}</div>{{#if previousUrl}}<a class="button secondary" href="{{previousUrl}}" rel="prev">Previous</a>{{/if}}
<p class="small muted">Page {{page}} of {{pageCount}}</p>
{{#if nextUrl}}<a class="button secondary" href="{{nextUrl}}" rel="next">Next</a>{{/if}}
{{> studentBottom}}


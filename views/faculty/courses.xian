{{> facultyTop}}{{#if databaseNotice}}<p class="notice info" role="status">{{databaseNotice}}</p>{{/if}}<div class="toolbar"><p class="muted">Draft privately. Review the questions. Publish when ready. Unpublishing makes course content editable and keeps learner history.</p><div class="actions"><a class="button" href="/faculty/upload">Upload &amp; generate</a></div></div><nav class="course-list-tabs" aria-label="Course lists">
  <a class="button {{#unless (eq list 'active')}}secondary{{/unless}}" href="{{activeUrl}}" {{#if (eq list 'active')}}aria-current="page"{{/if}}>Published &amp; pending</a>
  <a class="button {{#unless drafts}}secondary{{/unless}}" href="{{draftsUrl}}" {{#if drafts}}aria-current="page"{{/if}}>Drafts</a>
  <a class="button {{#unless archived}}secondary{{/unless}}" href="{{archiveUrl}}" {{#if archived}}aria-current="page"{{/if}}>Archive</a>
</nav>
{{#if archived}}<p class="notice info">Open a course and choose Republish on the module you want to restore.</p>{{/if}}
<form class="card course-list-search" action="/faculty/courses" method="get" role="search">
  <label class="field">Search courses or modules<input type="search" name="q" value="{{query}}" maxlength="160" placeholder="Enter a course or module title"></label>
  <input type="hidden" name="list" value="{{list}}">
  {{#if (eq list 'active')}}<label class="field">Status<select name="status">
    <option value="">All statuses</option>
    <option value="pending" {{selected status "pending"}}>Pending Admin review</option>
    <option value="approved" {{selected status "approved"}}>Approved / Published</option>
  </select></label>{{/if}}
  <button class="button">Search</button>
</form>
<div class="grid cols-2">
{{#each courses}}
<article class="card student-catalog-card {{#if hasPending}}publication-pending{{/if}}">
  <a class="catalog-card-link" href="{{href}}">
    <div class="catalog-card-meta"><span class="chip">{{areaLabels competencyAreas domain}}</span>{{#if hasPending}}<span class="chip pending-publication-label">Pending</span>{{/if}}</div>
    <h2>{{title}}</h2>
    <div class="catalog-card-meta"><strong>{{moduleCount}} {{#if (eq moduleCount 1)}}module{{else}}modules{{/if}}</strong><span>View modules →</span></div>
  </a>
</article>
{{else}}<div class="card empty"><h2>No matching courses</h2></div>{{/each}}
</div>
<nav class="pagination" aria-label="Courses pagination">{{#if previousUrl}}<a class="button secondary" href="{{previousUrl}}" rel="prev">Previous</a>{{/if}}
<p class="small muted">Page {{page}} of {{pageCount}}</p>
{{#if nextUrl}}<a class="button secondary" href="{{nextUrl}}" rel="next">Next</a>{{/if}}
</nav>
{{> studentBottom}}


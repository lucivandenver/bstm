{{> facultyTop}}<div class="toolbar"><p class="muted">Draft privately. Review the questions. Publish when ready. Unpublishing makes course content editable and keeps learner history.</p><div class="actions"><a class="button" href="/faculty/upload">Upload &amp; generate</a></div></div><div class="grid cols-2">{{#each courses}}<article class="card course-card"><div class="course-art"><span>{{areaLabels competencyAreas domain}}</span><strong>{{level}}</strong></div><div class="row between"><span class="chip">{{#if published}}Published{{else}}Draft / archived{{/if}}</span><span class="small muted">Version {{version}}</span></div><h2>{{title}}</h2><p class="muted">{{description}}</p><p class="small">{{moduleCount}} modules · {{questionCount}} questions · {{minutes}} min</p><p class="small muted">{{enrolledStudents}} learners enrolled · {{activeLearners}} ongoing · {{completedAttempts}} completed attempts</p><div class="actions"><a class="button" href="/faculty/courses/{{id}}/edit">Edit course</a><a class="button secondary" href="/faculty/courses/{{id}}/preview">Preview</a>{{#if published}}<form method="post" action="/faculty/courses/{{id}}/archive" data-confirm="Unpublish this course? You can edit and republish it later; student progress and credentials remain preserved."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button ghost">Unpublish</button></form>{{/if}}{{#if deleteEligible}}<form method="post" action="/faculty/courses/{{id}}/delete" data-confirm="Permanently delete this unused draft? This cannot be undone."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger" type="submit">Delete draft</button></form>{{/if}}</div></article>{{else}}<div class="card empty"><h2>Your first course starts here.</h2><p>Upload teaching materials to generate lessons and assessments.</p><a href="/faculty/upload" class="button">Create a course</a></div>{{/each}}</div>{{> studentBottom}}

{{> facultyTop}}<section class="card"><h2>Assign a published course</h2><form method="post" action="/faculty/assignments"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="grid cols-2"><label class="field">Course<select name="courseId" required>{{#each courses}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label><label class="field">Assigned section<select name="sectionId" required>{{#each sections}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label class="field">Due date (optional)<input type="datetime-local" name="dueAt"></label><label class="field">Learning requirement<select name="required"><option value="true">Required</option><option value="false">Recommended / no longer required</option></select></label></div><button class="button">Save assignment & notify students</button></form></section><section class="card space-top"><h2>Section learning requirements</h2>{{#each assignments}}<p class="assignment-item"><strong>{{courseTitle}}</strong><span>{{sectionName}} · {{#if required}}Required{{else}}Recommended{{/if}}<small>Due: {{date}}</small></span></p>{{else}}<p class="empty">No course assignments yet.</p>{{/each}}</section>{{> studentBottom}}

{{> facultyTop}}
<p class="muted">Save your faculty signature once. Future publication submissions reuse it and include the module certificates automatically.</p>
{{#unless savedSignature}}<p class="notice info">Faculty signature missing. Save a signature before Admin can publish modules with certificates enabled.</p>{{/unless}}
{{#each courses}}
<section class="card space-top"><div class="row between"><div><h2>{{title}}</h2><p>{{domain}} · {{#if published}}Published{{else}}Unpublished{{/if}} · {{#if awardsApproved}}Signature configuration approved{{else}}System-issued certificate enabled{{/if}}</p></div><a class="button secondary" href="/faculty/courses/{{id}}/edit">Edit course title / certificate setting</a></div>
{{> badgePreview title=title}}
{{#each modules}}<h3>Module certificate · {{title}}</h3>{{> certificatePreview title=title institution=../../institutionName signature=../signature name=../../facultyName position=../../facultyPosition}}{{/each}}
{{#if request}}<p>Status: <span class="chip">{{request.status}}</span>{{#if request.remarks}}<br>Admin feedback: {{request.remarks}}{{/if}}</p>{{/if}}
<form method="post" action="/faculty/courses/{{id}}/credentials" data-signature-form><input type="hidden" name="saveReusable" value="yes"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="field"><label>Faculty signature image (optional when keeping the saved signature)<input type="file" accept="image/png,image/jpeg,image/webp" data-signature-file {{#unless signature}}required{{/unless}}></label><p class="small muted" role="status" aria-live="polite" data-signature-status></p><input type="hidden" name="signature" data-signature-value value="{{signature}}"><small>Upload dark ink on a plain light background. A new signature is converted to a transparent PNG before submission.</small><img alt="Processed signature preview" data-signature-preview {{#unless signature}}hidden{{/unless}} src="{{signature}}" style="max-width:320px;max-height:120px;background:#f5f5f5"></div><button class="button space-top">Save faculty signature</button></form>
{{#if request}}<form method="post" action="/faculty/courses/{{id}}/credentials/delete" class="space-top" data-confirm="Remove this course's signature configuration? Previously issued student certificates will remain unchanged."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger">Remove certificate signature configuration</button></form>{{/if}}
</section>
{{else}}<section class="card"><p>No published courses currently have certificates enabled.</p><a class="button" href="/faculty/courses">Open My courses</a></section>{{/each}}
<script src="/js/signature.js" defer></script>{{> studentBottom}}

{{> facultyTop}}
<p class="muted">Each published course needs Admin approval before students can earn its certificate or badge.</p>
{{#each courses}}<section class="card space-top"><h2>{{title}}</h2><p>{{domain}} · {{#if published}}Published{{else}}Draft{{/if}}</p><h3>Standard certificate preview</h3><article style="border:3px solid #007042;padding:24px;text-align:center;background:#fff"><p>{{../institutionName}}</p><h2>Certificate of Completion</h2><p>Sample Student Name</p><h2>{{title}}</h2><div class="grid cols-2"><div><img alt="Faculty signature preview" src="{{request.facultySignature}}" data-course-signature-preview {{#unless request.facultySignature}}hidden{{/unless}} style="max-width:160px;max-height:60px"><p>{{../facultyName}}</p><p class="small muted">{{../facultyPosition}}</p></div><div>{{#if ../adminSignature}}<img src="{{../adminSignature}}" alt="Administrator signature" style="max-width:160px;max-height:60px">{{else}}<p class="small muted">Administrator signature pending</p>{{/if}}<p>{{../certificateSignatory}}</p><p class="small muted">{{../certificateSignatoryPosition}}</p></div></div></article>
{{#if request}}<p>Status: <span class="chip">{{request.status}}</span>{{#if request.remarks}}<br>Admin feedback: {{request.remarks}}{{/if}}</p>{{/if}}
{{#if published}}<form method="post" action="/faculty/courses/{{id}}/credentials" data-signature-form><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="field"><label>Faculty signature image<input type="file" accept="image/png,image/jpeg,image/webp" required data-signature-file></label><p class="small muted" role="status" aria-live="polite" data-signature-status></p><input type="hidden" name="signature" data-signature-value><small>Upload dark ink on a plain light background. Preview the transparent PNG before submitting.</small><img alt="Processed signature preview" data-signature-preview hidden data-course-signature-preview style="max-width:320px;max-height:120px;background:#f5f5f5"></div><div class="field"><label>Badge label<input name="badgeLabel" value="Course completion" maxlength="60" required></label></div><button class="button space-top">{{#if request}}Resubmit for approval{{else}}Submit for Admin approval{{/if}}</button></form>{{else}}<a class="button secondary" href="/faculty/courses/{{id}}/edit">Finish and publish course</a>{{/if}}</section>{{else}}<section class="card"><p>Create and publish a course before requesting its certificate and badge configuration.</p><a class="button" href="/faculty/courses/new">Create course</a></section>{{/each}}
<script src="/js/signature.js" defer></script>{{> studentBottom}}

{{> facultyTop}}
<p class="muted">Only published courses with certificate issuance enabled appear here. Students receive a system-issued completion certificate after meeting the course rules. You can configure or remove faculty/admin signature branding for each course.</p>
{{#each courses}}
<section class="card space-top"><div class="row between"><div><h2>{{title}}</h2><p>{{domain}} · Published · {{#if awardsApproved}}Signature configuration approved{{else}}System-issued certificate enabled{{/if}}</p></div><a class="button secondary" href="/faculty/courses/{{id}}/edit">Edit course title / certificate setting</a></div>
<h3>Certificate preview · {{title}}</h3><article style="border:3px solid #007042;padding:24px;text-align:center;background:#fff"><p>{{../institutionName}}</p><h2>Certificate of Completion</h2><p>Sample Student Name</p><h2>{{title}}</h2><div class="grid cols-2"><div><img alt="Faculty signature preview" src="{{request.facultySignature}}" data-course-signature-preview {{#unless request.facultySignature}}hidden{{/unless}} style="max-width:160px;max-height:60px"><p>{{../facultyName}}</p><p class="small muted">{{../facultyPosition}}</p></div><div>{{#if ../adminSignature}}<img src="{{../adminSignature}}" alt="Administrator signature" style="max-width:160px;max-height:60px">{{else}}<p class="small muted">Administrator signature pending</p>{{/if}}<p>{{../certificateSignatory}}</p><p class="small muted">{{../certificateSignatoryPosition}}</p></div></div></article>
{{#if request}}<p>Status: <span class="chip">{{request.status}}</span>{{#if request.remarks}}<br>Admin feedback: {{request.remarks}}{{/if}}</p>{{/if}}
<form method="post" action="/faculty/courses/{{id}}/credentials" data-signature-form><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="field"><label>Faculty signature image (optional when keeping the saved signature)<input type="file" accept="image/png,image/jpeg,image/webp" data-signature-file {{#unless request.facultySignature}}required{{/unless}}></label><p class="small muted" role="status" aria-live="polite" data-signature-status></p><input type="hidden" name="signature" data-signature-value value="{{request.facultySignature}}"><small>Upload dark ink on a plain light background. A new signature is converted to a transparent PNG before submission.</small><img alt="Processed signature preview" data-signature-preview {{#unless request.facultySignature}}hidden{{/unless}} src="{{request.facultySignature}}" style="max-width:320px;max-height:120px;background:#f5f5f5"></div><div class="field"><label>Certificate badge label<input name="badgeLabel" value="{{#if request}}{{request.badge.label}}{{else}}Course completion{{/if}}" maxlength="60" required></label></div><button class="button space-top">{{#if request}}Save certificate changes / resubmit{{else}}Configure signature approval{{/if}}</button></form>
{{#if request}}<form method="post" action="/faculty/courses/{{id}}/credentials/delete" class="space-top" data-confirm="Remove this course's signature configuration? Previously issued student certificates will remain unchanged."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger">Remove certificate signature configuration</button></form>{{/if}}
</section>
{{else}}<section class="card"><p>No published courses currently have certificates enabled.</p><a class="button" href="/faculty/courses">Open My courses</a></section>{{/each}}
<script src="/js/signature.js" defer></script>{{> studentBottom}}

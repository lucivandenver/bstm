{{> facultyTop}}
<p class="muted">Courses with certificates enabled appear here. Your saved signature can be reused across courses. Students receive a system-issued completion certificate after meeting the course rules. You can configure or remove faculty/admin signature branding for each course.</p>
{{#each courses}}
<section class="card space-top"><div class="row between"><div><h2>{{title}}</h2><p>{{domain}} · {{#if published}}Published{{else}}Unpublished{{/if}} · {{#if awardsApproved}}Signature configuration approved{{else}}System-issued certificate enabled{{/if}}</p></div><a class="button secondary" href="/faculty/courses/{{id}}/edit">Edit course title / certificate setting</a></div>
<h3>Certificate preview · {{title}}</h3>{{> certificatePreview title=title institution=../institutionName signature=signature name=../facultyName position=../facultyPosition}}
{{#if request}}<p>Status: <span class="chip">{{request.status}}</span>{{#if request.remarks}}<br>Admin feedback: {{request.remarks}}{{/if}}</p>{{/if}}
<form method="post" action="/faculty/courses/{{id}}/credentials" data-signature-form><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="field"><label>Faculty signature image (optional when keeping the saved signature)<input type="file" accept="image/png,image/jpeg,image/webp" data-signature-file {{#unless signature}}required{{/unless}}></label><p class="small muted" role="status" aria-live="polite" data-signature-status></p><input type="hidden" name="signature" data-signature-value value="{{signature}}"><small>Upload dark ink on a plain light background. A new signature is converted to a transparent PNG before submission.</small><img alt="Processed signature preview" data-signature-preview {{#unless signature}}hidden{{/unless}} src="{{signature}}" style="max-width:320px;max-height:120px;background:#f5f5f5"></div><div class="field"><label>Certificate badge label<input name="badgeLabel" value="{{#if request}}{{request.badge.label}}{{else}}Course completion{{/if}}" maxlength="60" required></label></div><button class="button space-top">{{#if request}}Save certificate changes / resubmit{{else}}Configure signature approval{{/if}}</button></form>
{{#if request}}<form method="post" action="/faculty/courses/{{id}}/credentials/delete" class="space-top" data-confirm="Remove this course's signature configuration? Previously issued student certificates will remain unchanged."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger">Remove certificate signature configuration</button></form>{{/if}}
</section>
{{else}}<section class="card"><p>No published courses currently have certificates enabled.</p><a class="button" href="/faculty/courses">Open My courses</a></section>{{/each}}
<script src="/js/signature.js" defer></script>{{> studentBottom}}

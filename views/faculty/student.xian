{{> facultyTop}}<a class="text-link" href="/faculty/students">← Assigned students</a><p class="muted">{{student.studentId}} · {{student.section}} · {{student.email}}</p><div class="grid cols-2 space-top">
  <section class="card"><h2>Competency progress</h2>
    <p class="muted">Overall module progress <strong>{{evidence.overall}}%</strong></p>
    <progress class="faculty-module-progress" value="{{evidence.overall}}" max="100" aria-label="Overall module progress"></progress>
    {{#each domains}}<div class="space-top"><div class="row between"><span>{{name}}</span><strong>{{percent}}%</strong></div>
      <progress class="faculty-module-progress" value="{{percent}}" max="100" aria-label="{{name}} progress"></progress>
      <small>{{passed}} of {{total}} started modules passed</small></div>{{/each}}
    <p class="small muted space-top">An unpassed module contributes up to 25% toward its competency progress.</p>
  </section>
  <section class="card"><h2>Career directions</h2>
    {{#each careerSuggestions}}<article class="feedback-item"><h3>{{title}}</h3><p class="small muted">{{explanation}}</p></article>
    {{else}}<p class="muted">Career directions appear after a module with relevant competency evidence is passed.</p>{{/each}}
    <h3 class="space-top">Assessments to review</h3>
    {{#each evidence.lowScores}}<p>{{title}} · {{score}}% <small class="muted">({{passingScore}}% to pass)</small></p>
    {{else}}<p class="small muted">No below-passing module quiz results.</p>{{/each}}
    {{#each evidence.developing}}{{#unless assessed}}<p class="small">{{title}} · {{percent}}% progress · Quiz pending</p>{{/unless}}{{/each}}
  </section>
</div><section class="card space-top"><h2>Learning attempts</h2><div class="table-wrap"><table><thead><tr><th>Course / attempt</th><th>Progress</th><th>Score</th><th>Duration</th><th>Last activity</th></tr></thead><tbody>{{#each attempts}}<tr><td>{{title}}<small>#{{attemptNumber}} · {{status}}</small></td><td>{{percent}}%</td><td>{{finalScore}}</td><td>{{minutes}} active min<small>{{elapsedDays}} elapsed days</small></td><td>{{lastActivity}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No learning attempts.</td></tr>{{/each}}</tbody></table></div></section><div class="grid cols-2 space-top"><section class="card"><h2>Add feedback or intervention</h2><form method="post" action="/faculty/students/{{student.id}}/notes"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Feedback<textarea name="feedback" rows="4" required maxlength="3000"></textarea></label></div><div class="field"><label>Recommended remediation<textarea name="remediation" rows="3" maxlength="1500"></textarea></label></div><div class="field"><label>Visibility<select name="visibility"><option value="student">Share with student</option><option value="internal">Private faculty intervention note</option></select></label></div><button class="button">Save feedback</button></form></section><section class="card"><h2>Your feedback history</h2>{{#each notes}}<article class="feedback-item"><span class="chip">{{visibility}}</span><small>{{date}}</small><p class="lesson-body">{{feedback}}</p><p class="muted">{{remediation}}</p></article>{{else}}<p class="empty">No notes added.</p>{{/each}}</section></div>{{> studentBottom}}

{{> facultyTop}}<a class="text-link" href="/faculty/students">← Assigned students</a><p class="muted">{{student.studentId}} · {{student.section}} · {{student.email}}</p><div class="grid cols-2 space-top"><section class="card"><h2>Current evidence</h2>{{#each domains}}<p class="assignment-item"><span>{{name}}</span><strong>{{score}}</strong></p>{{/each}}<p class="small muted">Completed course knowledge and latest diagnostic. Self-declared qualifications remain separate.</p></section><section class="card"><h2>Background & direction</h2><p>{{profile.careerInterest}} · {{profile.preferredLocation}}</p><p>OJT: {{profile.ojtStatus}} · {{profile.ojtHours}} hours</p><p class="small">Self-declared skills: {{profile.skills}}</p><p class="small">Self-declared qualifications: {{profile.qualifications}}</p></section></div><section class="card space-top"><h2>Learning attempts</h2><div class="table-wrap"><table><thead><tr><th>Course / attempt</th><th>Progress</th><th>Score</th><th>Duration</th><th>Last activity</th></tr></thead><tbody>{{#each attempts}}<tr><td>{{title}}<small>#{{attemptNumber}} · {{status}}</small></td><td>{{percent}}%</td><td>{{finalScore}}</td><td>{{minutes}} active min<small>{{elapsedDays}} elapsed days</small></td><td>{{lastActivity}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No learning attempts.</td></tr>{{/each}}</tbody></table></div></section><div class="grid cols-2 space-top"><section class="card"><h2>Add feedback or intervention</h2><form method="post" action="/faculty/students/{{student.id}}/notes"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Feedback<textarea name="feedback" rows="4" required maxlength="3000"></textarea></label></div><div class="field"><label>Recommended remediation<textarea name="remediation" rows="3" maxlength="1500"></textarea></label></div><div class="field"><label>Visibility<select name="visibility"><option value="student">Share with student</option><option value="internal">Private faculty intervention note</option></select></label></div><button class="button">Save feedback</button></form></section><section class="card"><h2>Your feedback history</h2>{{#each notes}}<article class="feedback-item"><span class="chip">{{visibility}}</span><small>{{date}}</small><p class="lesson-body">{{feedback}}</p><p class="muted">{{remediation}}</p></article>{{else}}<p class="empty">No notes added.</p>{{/each}}</section></div>{{> studentBottom}}

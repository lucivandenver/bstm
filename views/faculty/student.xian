{{> facultyTop}}<a class="text-link" href="/faculty/students">← Assigned students</a><h2>{{student.name}}</h2><p class="muted">{{student.studentId}} · {{student.section}} · {{student.email}}</p><section class="card space-top"><h2>Learning summary</h2><div class="overview-summary"><p><strong>{{evidence.completed.length}}</strong> Modules passed</p><p><strong>{{evidence.lowScores.length}}</strong> Modules needing retake</p><p><strong>{{summary.coursesCompleted}}</strong> Courses completed</p></div></section><section class="card space-top"><h2>Needs attention</h2><div data-page-list>{{#each evidence.lowScores}}<p data-page-item>{{courseTitle}} · {{title}} · <strong>{{score}}% · Needs retake</strong></p>{{else}}<p>No below-passing module results.</p>{{/each}}{{#each attempts}}{{#if inactive}}<p data-page-item>{{title}} · Inactive 7+ days · Last activity {{lastActivity}}</p>{{/if}}{{/each}}</div></section><div class="grid cols-2 space-top">
  <section class="card"><h2>Competency progress</h2>
    <p class="muted">Overall module progress <strong>{{evidence.overall}}%</strong></p>
    <progress class="faculty-module-progress" value="{{evidence.overall}}" max="100" aria-label="Overall module progress"></progress>
    {{#each domains}}<div class="space-top"><div class="row between"><span>{{name}}</span><strong>{{percent}}%</strong></div>
      <progress class="faculty-module-progress" value="{{percent}}" max="100" aria-label="{{name}} progress"></progress>
      <small>{{passed}} of {{total}} available modules passed</small></div>{{/each}}
    <p class="small muted space-top">Progress includes all published modules in your courses. Percentage = passed modules ÷ available modules × 100.</p>
  </section>
<details class="card course-disclosure"><summary>Career alignment</summary><div data-page-list>{{#each careerSuggestions}}<article class="feedback-item" data-page-item><h3>{{title}}</h3><p>{{explanation}}</p><h4>Supporting passed modules</h4><ul>{{#each supportingModules}}<li>{{courseTitle}} · {{title}}</li>{{else}}<li>No linked passed modules.</li>{{/each}}</ul><h4>Competencies still to assess</h4><ul>{{#each missingAreas}}<li>{{this}}</li>{{else}}<li>All required areas have assessment evidence.</li>{{/each}}</ul></article>{{else}}<p>Pass a relevant module assessment to see career alignment.</p>{{/each}}</div></details>
</div><section class="card space-top"><h2>Module assessment records</h2><div data-page-list>{{#each attempts}}<details class="course-disclosure space-top" data-page-item><summary>{{title}} · Attempt {{attemptNumber}} · {{status}}</summary><p>{{modulesPassed}} of {{modulesTotal}} modules passed · {{modulePercent}}%</p>{{> facultyModuleTable}}</details>{{else}}<p>No learning attempts.</p>{{/each}}</div></section><div class="grid cols-2 space-top"><section class="card"><h2>Add feedback or intervention</h2><form method="post" action="/faculty/students/{{student.id}}/notes"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Feedback<textarea name="feedback" rows="4" required maxlength="3000"></textarea></label></div><div class="field"><label>Recommended remediation<textarea name="remediation" rows="3" maxlength="1500"></textarea></label></div><div class="field"><label>Visibility<select name="visibility"><option value="student">Share with student</option><option value="internal">Private faculty intervention note</option></select></label></div><button class="button">Save feedback</button></form></section><section class="card"><h2>Your feedback history</h2><div data-page-list>{{#each notes}}<article data-page-item class="feedback-item"><span class="chip">{{visibility}}</span><small>{{date}}</small><p class="lesson-body">{{feedback}}</p><p class="muted">{{remediation}}</p></article>{{else}}<p class="empty">No notes added.</p>{{/each}}</div></section></div>{{> studentBottom}}

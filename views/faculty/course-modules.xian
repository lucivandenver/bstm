{{> facultyTop}}
<h2>Course modules</h2>
<div class="actions space-top">
  {{#unless archived}}{{#unless course.pendingReview}}<a class="button" href="/faculty/upload?courseId={{course.id}}">Generate module</a>{{/unless}}{{/unless}}
  {{#unless course.draftOnly}}
  <a class="button secondary" href="/faculty/courses/{{course.id}}/edit">Edit course</a>
  {{#if course.published}}
  <form method="post" action="/faculty/courses/{{course.id}}/archive" data-confirm="Unpublish this course? You can edit and republish it later.">
    <input type="hidden" name="_csrf" value="{{csrf}}"><button class="button ghost">Unpublish</button>
  </form>
  {{/if}}
  {{#if archived}}
  <form method="post" action="/faculty/courses/{{course.id}}/archive/delete" data-confirm="Permanently delete this archived course and its student progress, scores, badges and certificates? This cannot be undone.">
    <input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="confirmDelete" value="yes"><button class="button danger">Delete permanently</button>
  </form>
  {{/if}}
  {{#if course.deleteEligible}}
  <form method="post" action="/faculty/courses/{{course.id}}/delete" data-confirm="Permanently delete this unused draft? This cannot be undone.">
    <input type="hidden" name="_csrf" value="{{csrf}}"><button class="button danger">Delete draft</button>
  </form>
  {{/if}}
  {{/unless}}
</div>
<section class="space-top" aria-label="Course modules">
<div class="grid cols-2">
{{#each course.modules}}
  <article class="card module-card">
    <p class="eyebrow">{{../course.title}}</p>
    <span class="chip">{{status}}</span>
    <h2>Module {{number}} · {{title}}</h2>
    <details><summary>{{lessons.length}} topic areas</summary>
      <ol>{{#each lessons}}<li>{{title}}</li>{{/each}}</ol>
    </details>
    <div class="actions space-top"><a class="button secondary" href="{{editUrl}}">Review module</a>
      {{#if (eq status 'Published')}}<a class="button secondary" href="/faculty/courses/{{../course.id}}/preview">Preview course</a>{{/if}}
    </div>
  </article>
{{else}}<p class="muted">No modules in this list yet.</p>{{/each}}
</div>
</section>
{{> studentBottom}}

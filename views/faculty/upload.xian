{{> facultyTop}}<p><a href="/faculty/questions">Open question bank</a></p><div class="grid cols-2"><section class="card"><span class="step-number">01</span><h2>Turn your materials into a course</h2><p class="muted">Select multiple related PDF, DOCX, PPTX or TXT files. Files upload one at a time, up to 100 MB each; there is no 8-file selection cap. A collection holds up to 1,000,000 extracted characters. Scanned PDFs need a selectable-text version.</p>
<form method="post" action="/faculty/upload" enctype="multipart/form-data" data-source-upload data-no-dirty novalidate><input type="hidden" name="_csrf" value="{{csrf}}">
<div class="field"><label for="sources">Related modules, lessons and references</label><input type="file" name="sources" id="sources" accept=".pdf,.docx,.pptx,.txt" multiple required></div>
<ul class="upload-file-status small" aria-live="polite" data-upload-files></ul>
<fieldset class="field space-top"><legend>Competency areas</legend><p class="small muted">Select every area covered by your materials.</p>{{#each areas}}<label class="check-label"><input type="checkbox" name="domains" value="{{name}}"> {{name}}</label>{{/each}}</fieldset>
<div class="grid cols-2"><div class="field"><label>Difficulty<select name="level"><option>Foundation</option><option>Intermediate</option><option>Advanced</option></select></label></div><div class="field"><label>Assessment questions<input type="number" name="questionCount" value="8" min="3" max="30"></label></div></div>
<div class="field"><label>Learning outcomes <span class="muted small">(optional)</span><textarea name="outcomes" rows="3" maxlength="1500" placeholder="Leave blank to derive outcomes from the learning materials."></textarea></label></div>
<label class="check-label"><input type="checkbox" name="consent" value="yes"> I have permission to send the extracted teaching material to the configured AI provider for course generation.</label>
<p class="upload-status small" role="status" data-upload-status></p>
<div class="actions space-top"><button class="button" value="generate" {{#unless aiReady}}disabled{{/unless}}>Upload &amp; generate course</button><button class="button secondary" value="extract">Save materials only</button><a class="button secondary" data-source-link hidden href="#">Open saved materials</a></div>
<noscript><p class="notice">Enable JavaScript for sequential multi-file uploads, or upload up to 20 files (100 MB combined) and review the saved source.</p></noscript>
</form></section><section class="card"><span class="step-number">02</span><h2>Review before publishing</h2><ol class="workflow-list"><li>Check the extracted pages, paragraphs or slides.</li><li>The AI organizes lessons and writes assessment questions, answer keys and explanations.</li><li>Review the AI draft and its source references.</li><li>Open Preview or Edit lessons & answers, mark the answers reviewed, then publish.</li></ol>{{#unless aiReady}}<p class="notice info">AI provider is not configured. Upload and review still work. Uploaded files are retained so you can retry after the AI provider recovers.</p>{{/unless}}</section></div><section class="card space-top"><h2>Your source library</h2>{{#each sources}}<p class="assignment-item"><a class="text-link" href="/faculty/sources/{{id}}">{{filename}} →</a></p>{{else}}<p class="empty">No documents uploaded yet.</p>{{/each}}</section><section class="card space-top"><h2>Generation history</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Status</th><th>Result</th></tr></thead><tbody>{{#each jobs}}<tr><td>{{date}}</td><td>{{status}}</td><td>{{#if courseId}}<a href="/faculty/courses/{{courseId}}/edit">Open draft →</a>{{else}}<a href="/faculty/generation/{{id}}">View progress / result →</a> {{errorCode}}{{/if}}</td></tr>{{else}}<tr><td colspan="3" class="empty">No generation requests.</td></tr>{{/each}}</tbody></table></div></section><script src="/js/source-upload.js" defer></script>{{> studentBottom}}

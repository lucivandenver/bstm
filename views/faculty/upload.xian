{{> facultyTop}}<div class="grid cols-2"><section class="card"><span class="step-number">01</span><h2>Start with your teaching material</h2><p class="muted">Upload a text-based PDF, DOCX or PPTX. Review the extracted text, then request a draft. Scanned documents need OCR before uploading.</p><form method="post" action="/faculty/upload" enctype="multipart/form-data" data-upload><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label for="source">Topic softcopy · up to 8 MB</label><input type="file" name="source" id="source" accept=".pdf,.docx,.pptx" required></div><p class="upload-status small" role="status"></p><button class="button">Extract source text →</button></form></section><section class="card"><span class="step-number">02</span><h2>Review before publishing</h2><ol class="workflow-list"><li>Check the extracted pages, paragraphs or slides.</li><li>Choose outcomes, difficulty and question count.</li><li>Review the AI draft and its source references.</li><li>Mark questions reviewed, preview and publish.</li></ol>{{#unless aiReady}}<p class="notice info">Gemini is not configured. Upload and review still work. Open a saved source to import it into a manual draft, or start with the manual editor.</p>{{/unless}}<a class="button secondary" href="/faculty/courses/new">Use manual editor</a></section></div><section class="card space-top"><h2>Your source library</h2>{{#each sources}}<p class="assignment-item"><a class="text-link" href="/faculty/sources/{{id}}">{{filename}} →</a></p>{{else}}<p class="empty">No documents uploaded yet.</p>{{/each}}</section><section class="card space-top"><h2>Generation history</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Status</th><th>Result</th></tr></thead><tbody>{{#each jobs}}<tr><td>{{date}}</td><td>{{status}}</td><td>{{#if courseId}}<a href="/faculty/courses/{{courseId}}/edit">Open draft →</a>{{else}}{{errorCode}}{{/if}}</td></tr>{{else}}<tr><td colspan="3" class="empty">No generation requests.</td></tr>{{/each}}</tbody></table></div></section>{{> studentBottom}}

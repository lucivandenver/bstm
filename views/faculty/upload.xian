{{> facultyTop}}<ol class="workflow-list"><li>Select or create a course</li><li>Upload materials</li><li>Configure and generate the module</li><li>Review the generated draft</li><li>Submit for Admin approval</li></ol><p><a href="/faculty/questions">Open question bank</a></p><details class="card" {{#unless destinations}}open{{/unless}}><summary>Create a new course</summary><form method="post" action="/faculty/courses"><input type="hidden" name="_csrf" value="{{csrf}}"><section data-upload-step><h3>1. Select your course</h3><label class="field">Course name<input name="title" required minlength="4" maxlength="160"></label><button class="button secondary">Create course</button></form></details>
{{#if destinations}}<div class="grid cols-2 space-top"><section class="card"><span class="step-number">01</span><h2>Upload material for a module</h2><p class="muted">Select multiple related PDF, DOCX, PPTX or TXT files. Files upload one at a time, up to 100 MB each; there is no 8-file selection cap. A collection holds up to 1,000,000 extracted characters. Scanned PDFs need a selectable-text version.</p>
<form data-no-dirty method="post" action="/faculty/upload" enctype="multipart/form-data" data-source-upload novalidate><input type="hidden" name="_csrf" value="{{csrf}}">
<label class="field">Course<select name="destinationId" required><option value="">Select your course</option>{{#each destinations}}<option value="{{id}}" {{selected id ../selectedCourseId}}>{{title}}</option>{{/each}}</select></label>
</section><section data-upload-step><h3>2. Select materials</h3><div class="field"><label for="sources">Related modules, lessons and references</label><input type="file" name="sources" id="sources" accept=".pdf,.docx,.pptx,.txt" multiple required></div>
<ul class="upload-file-status small" aria-live="polite" data-upload-files></ul>
</section><section data-upload-step><h3>3. Configure the module</h3><label class="field">Module title<input name="moduleTitle" required minlength="4" maxlength="160"></label>
<fieldset class="field"><legend>Competency areas · select all that apply</legend>{{#each domains}}<label class="check-label"><input type="checkbox" name="competencyAreas" value="{{this}}"> {{this}}</label>{{/each}}</fieldset>
<div class="grid cols-2"><div class="field"><label>Difficulty<select name="level"><option>Foundation</option><option>Intermediate</option><option>Advanced</option></select></label></div><div class="field"><label>Assessment questions<input type="number" name="questionCount" value="8" min="3" max="30"></label></div></div>
<div class="field"><label>Learning outcomes <span class="muted small">(optional)</span><textarea name="outcomes" rows="3" maxlength="1500" placeholder="Leave blank to derive outcomes from the learning materials."></textarea></label></div>
<label class="check-label"><input type="checkbox" name="consent" value="yes"> I have permission to send the extracted teaching material to the configured AI providers ({{aiProviderLabel}}) for course generation.</label>
</section><div class="actions" data-upload-navigation hidden><button type="button" class="button secondary" data-upload-back>Back</button><button type="button" class="button" data-upload-next>Next</button></div><p class="upload-status small" role="status" data-upload-status></p>
<div class="actions space-top" data-upload-submit><button class="button" value="generate" {{#unless aiReady}}disabled{{/unless}}>Upload &amp; generate module</button><button class="button secondary" value="extract">Save materials only</button><a class="button secondary" data-source-link hidden href="#">Open saved materials</a></div>
<noscript><p class="notice">Enable JavaScript for sequential multi-file uploads, or upload up to 20 files (100 MB combined) and review the saved source.</p></noscript>
</form></section><section class="card"><span class="step-number">02</span><h2>What happens next</h2><ol class="workflow-list"><li>Review the generated lessons, answer keys and source references.</li><li>Submit the completed course for Admin approval.</li></ol>{{#unless aiReady}}<p class="notice info">The selected AI provider is not configured. Upload and review still work. Your saved materials will be available when generation resumes.</p>{{/unless}}</section></div>{{/if}}<details class="card space-top"><summary>Saved materials</summary>{{#each sources}}<p class="assignment-item"><a class="text-link" href="/faculty/sources/{{id}}">{{filename}} →</a></p><form method="post" action="/faculty/sources/{{id}}/delete" data-confirm="Delete this saved material?"><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button secondary" type="submit">Delete saved material</button></form>{{else}}<p class="empty">No documents uploaded yet.</p>{{/each}}</details><section class="card space-top" id="generation-history"><h2>Generation history</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Status</th><th>Result</th></tr></thead><tbody>{{#each jobs}}<tr><td>{{date}}</td><td>{{status}}</td><td>{{#if courseId}}<a href="/faculty/courses/{{courseId}}/edit">Open draft →</a>{{else}}<a href="/faculty/generation/{{id}}">View progress / result →</a> {{errorCode}}{{/if}}</td></tr>{{else}}<tr><td colspan="3" class="empty">No generation requests.</td></tr>{{/each}}</tbody></table></div><nav class="actions" aria-label="Generation history pages">{{#if previousHistory}}<a href="{{previousHistory}}">Previous</a>{{/if}}<span>Page {{historyPage}} of {{historyPages}}</span>{{#if nextHistory}}<a href="{{nextHistory}}">Next</a>{{/if}}</nav></section><script src="/js/source-upload.js" defer></script>{{> studentBottom}}

{{> studentTop}}<div class="lesson-layout">{{#if attempt}}{{> studentTopicOutline}}{{/if}}<div><a class="text-link" href="/student/learn/{{attempt.id}}{{#if moduleOnly}}?module={{currentScope}}{{/if}}">← {{#if moduleOnly}}Back to module{{else}}Back to course{{/if}}</a><div class="page-heading"><div><p class="muted">{{#if moduleTitle}}{{moduleTitle}}{{else}}{{attempt.snapshot.title}}{{/if}} · Passing score: {{attempt.snapshot.passingScore}}%</p></div>{{#if timed}}<span class="chip" data-timer="{{remainingSeconds}}" role="timer"></span>{{/if}}</div><div class="notice info">Answers save to your account as you work. Wait for “Saved to your account” before leaving. The final graded result is saved on submission.</div>{{#if blocked}}<div class="notice error">{{blockedReason}}</div>{{/if}}<form method="post" class="card" data-quiz="{{attempt.id}}-{{scope}}" {{#unless blocked}}data-draft-url="{{draftUrl}}"{{/unless}} data-revision="{{draftRevision}}" data-active-topic="{{activeTopic}}" action="/student/learn/{{attempt.id}}/{{#if final}}final{{else}}quiz/{{scope}}{{/if}}"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="challenge" value="{{challenge}}">{{#each topics}}<section class="assessment-topic" data-assessment-topic id="topic-{{id}}">{{#if title}}<h2 tabindex="-1">{{#if number}}Topic {{number}} · {{/if}}{{title}}</h2>{{/if}}{{#each questions}}<fieldset class="question"><legend>{{prompt}}</legend>{{#each options}}<label class="answer"><input type="radio" name="answers[{{../id}}]" value="{{index}}" {{#if ../../../blocked}}disabled{{/if}} {{#if checked}}checked{{/if}} required><span>{{label}}</span></label>{{/each}}</fieldset>{{/each}}</section>{{/each}}<nav class="actions assessment-topic-actions" aria-label="Assessment topic navigation" hidden><button class="button secondary" type="button" data-topic-back>Back</button><span class="small" data-topic-status role="status"></span><button class="button" type="button" data-topic-next>Next topic →</button></nav><p class="quiz-draft" role="status">Previously saved answers have been restored.</p>{{#if canSubmit}}<button class="button" type="submit" data-topic-submit {{#if blocked}}disabled{{/if}}>Submit {{title}} →</button>{{else}}{{#if nextLesson}}<a class="button" data-topic-submit href="/student/learn/{{attempt.id}}?lesson={{nextLesson.id}}">Continue to next lesson →</a>{{/if}}{{/if}}</form>{{#if timed}}<form class="space-top" method="post" action="/student/learn/{{attempt.id}}/restart/{{scope}}" data-confirm="Restart an expired assessment? This records the expired attempt and clears its draft."><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button ghost">Restart expired timed assessment</button></form>{{/if}}</div></div>{{> studentBottom}}

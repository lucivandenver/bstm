{{> studentTop}}<a class="text-link" href="/student/learn/{{attempt.id}}">← Back to course</a><div class="page-heading"><div><p class="eyebrow">CHECK YOUR UNDERSTANDING</p><h1>{{title}}</h1><p class="muted">{{attempt.snapshot.title}} · Passing score: {{attempt.snapshot.passingScore}}%</p></div>{{#if timed}}<span class="chip" data-timer="{{remainingSeconds}}" role="timer"></span>{{/if}}</div><div class="notice info">Answers save to your account as you work. Wait for “Saved to your account” before leaving. The final graded result is saved on submission.</div>{{#if blocked}}<div class="notice error">{{blockedReason}}</div>{{/if}}<form method="post" class="card" data-quiz="{{attempt.id}}-{{scope}}" {{#unless blocked}}data-draft-url="{{draftUrl}}"{{/unless}} data-revision="{{draftRevision}}" action="/student/learn/{{attempt.id}}/{{#if final}}final{{else}}quiz/{{scope}}{{/if}}"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="challenge" value="{{challenge}}">{{#each questions}}<fieldset class="question"><legend>{{prompt}}</legend>{{#each options}}<label class="answer"><input type="radio" name="answers[{{../id}}]" value="{{index}}" {{#if ../../blocked}}disabled{{/if}} {{#if checked}}checked{{/if}} required><span>{{label}}</span></label>{{/each}}</fieldset>{{/each}}<p class="quiz-draft" role="status">Previously saved answers have been restored.</p><button class="button" type="submit" {{#if blocked}}disabled{{/if}}>Submit {{title}} →</button></form>{{#if timed}}<form class="space-top" method="post" action="/student/learn/{{attempt.id}}/restart/{{scope}}" data-confirm="Restart an expired assessment? This records the expired attempt and clears its draft."><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button ghost">Restart expired timed assessment</button></form>{{/if}}{{> studentBottom}}

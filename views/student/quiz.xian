{{> studentTop}}
<p class="small"><a href="/student/learn/{{attempt.id}}">← Back to course</a></p><div class="page-heading"><div><p class="eyebrow">CHECK YOUR UNDERSTANDING</p><h1>{{title}}</h1><p class="muted">{{attempt.snapshot.title}} · Passing score: {{attempt.snapshot.passingScore}}%</p></div></div><div class="notice info">Answer every question. Your answers are graded on the server. If you do not pass, review the lessons and try again.</div>
<form method="post" class="card" data-quiz="{{attempt.id}}-{{scope}}" action="/student/learn/{{attempt.id}}/{{#if final}}final{{else}}quiz/{{scope}}{{/if}}"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="challenge" value="{{challenge}}">{{> questions}}<p class="quiz-draft" role="status">Answers are kept in this tab while you work. Submit to save the graded result.</p><button class="button" type="submit">Submit {{#if final}}final assessment{{else}}module quiz{{/if}} →</button></form>
{{> studentBottom}}

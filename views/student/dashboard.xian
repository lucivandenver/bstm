{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">A LITTLE PROGRESS, EVERY DAY</p><h1>Welcome back, {{currentUser.name}}.</h1><p class="muted">Build your knowledge. Discover your direction.</p></div><a class="button secondary" href="/student/courses">Explore courses ↗</a></div>
{{#unless profileComplete}}<div class="notice">Complete your academic profile to start learning. <a href="/student/profile"><strong>Set up my profile →</strong></a></div>{{/unless}}
<div class="grid cols-4"><a class="card stat dashboard-link" href="/student/learning"><span class="accent">{{> icon name="play"}}</span><span class="label">Courses in progress</span><span class="value">{{activeCount}}</span></a><a class="card stat dashboard-link" href="/student/learning"><span class="accent">{{> icon name="check"}}</span><span class="label">Completed attempts</span><span class="value">{{completedCount}}</span></a><a class="card stat dashboard-link" href="/student/achievements"><span class="accent">{{> icon name="certificate"}}</span><span class="label">Certificates earned</span><span class="value">{{credentialCount}}</span></a><a class="card stat rose dashboard-link" href="/student/achievements"><span class="accent">{{> icon name="award"}}</span><span class="label">Achievement stars</span><span class="value">{{totalStars}}</span></a></div>
<div class="grid dashboard-columns space-top"><div><section class="card hero"><p class="eyebrow">YOUR NEXT CHAPTER</p><h2>Small steps today.<br>More possibilities tomorrow.</h2><p>Explore tourism learning paths and turn your assessment results into a plan for growth.</p><a class="button" href="/student/careers">Discover my pathways →</a></section></div><div><section class="card"><h2>My competency progress</h2><p class="small muted">Track how many modules you’ve passed in each competency.</p>
<div class="stack space-top">{{#each competencies}}
  <div><div class="progress-label"><strong>{{name}}</strong><span>{{#if total}}{{passed}} of {{total}} passed{{else}}No modules started{{/if}}</span></div>
    {{#if total}}<progress class="competency-progress" aria-label="{{name}} modules passed" value="{{passed}}" max="{{total}}"></progress>{{/if}}
  </div>
{{/each}}</div><a class="button secondary full space-top" href="/student/assessment">{{#if baseline}}Retake diagnostic{{else}}Take knowledge diagnostic{{/if}}</a></section><section class="card space-top"><h2>Recent achievements</h2>{{#each recentCredentials}}<div class="divider"></div><span class="chip">Certificate earned</span><h3 class="space-top">{{courseTitle}}</h3><p class="small muted">{{date}}</p>{{else}}<p class="small muted">Complete a course to unlock your first certificate and badge.</p>{{/each}}<a class="small" href="/student/achievements">My achievement collection →</a></section></div></div>
{{> studentBottom}}

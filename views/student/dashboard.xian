{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">A LITTLE PROGRESS, EVERY DAY</p><h1>Welcome back, {{currentUser.name}}.</h1><p class="muted">Build your knowledge. Discover your direction.</p></div><a class="button secondary" href="/student/courses">Explore courses ↗</a></div>
{{#unless profileComplete}}<div class="notice">Complete your academic profile to start learning. <a href="/student/profile"><strong>Set up my profile →</strong></a></div>{{/unless}}
<div class="grid cols-4"><div class="card stat"><span class="accent">▷</span><span class="label">Courses in progress</span><span class="value">{{activeCount}}</span><span class="small muted">Keep your momentum</span></div><div class="card stat"><span class="accent">✓</span><span class="label">Completed attempts</span><span class="value">{{completedCount}}</span><span class="small muted">Every completion counts</span></div><div class="card stat"><span class="accent">▧</span><span class="label">Certificates earned</span><span class="value">{{credentialCount}}</span><span class="small muted">Ready to download</span></div><div class="card stat rose"><span class="accent">☆</span><span class="label">Achievement stars</span><span class="value">{{totalStars}}</span><span class="small muted">Your learning milestones</span></div></div>
<div class="grid dashboard-columns space-top"><div><section class="card hero"><p class="eyebrow">YOUR NEXT CHAPTER</p><h2>Small steps today.<br>More possibilities tomorrow.</h2><p>Explore tourism learning paths and turn your assessment results into a plan for growth.</p><a class="button" href="/student/careers">Discover my pathways →</a></section><div class="section-heading"><h2>Continue learning</h2><a href="/student/learning">View all →</a></div><div class="stack">{{#each ongoing}}<article class="card"><div class="row"><span class="chip">{{domain}}</span><span class="small muted">Attempt {{attemptNumber}}</span></div><h3 class="space-top">{{title}}</h3><div class="progress-label"><span>{{done}} of {{total}} requirements</span><strong>{{percent}}%</strong></div><div class="progress-track"><div class="progress-fill" style="--progress:{{percent}}%"></div></div><a class="button secondary space-top" href="/student/learn/{{id}}">Resume learning →</a></article>{{else}}<div class="card empty"><strong>Your learning journey is ready.</strong>Choose your first course and start building your skills.<br><a class="button" href="/student/courses">Find a course</a></div>{{/each}}</div></div><div><section class="card"><p class="eyebrow">KNOW WHERE YOU STAND</p><h2>My knowledge snapshot</h2><p class="small muted">Latest completed course evidence, or your diagnostic where no course evidence is available.</p><div class="stack space-top">{{#each domains}}<div><div class="progress-label"><strong>{{name}}</strong><span>{{#if known}}{{score}}%{{else}}Not assessed{{/if}}</span></div><div class="progress-track"><div class="progress-fill" style="--progress:{{#if known}}{{score}}{{else}}0{{/if}}%"></div></div></div>{{/each}}</div><a class="button secondary full space-top" href="/student/assessment">{{#if baseline}}Retake diagnostic{{else}}Take knowledge diagnostic{{/if}}</a></section><section class="card space-top"><h2>Recent achievements</h2>{{#each recentCredentials}}<div class="divider"></div><span class="chip">Certificate earned</span><h3 class="space-top">{{courseTitle}}</h3><p class="small muted">{{date}}</p>{{else}}<p class="small muted">Complete a course to unlock your first certificate and badge.</p>{{/each}}<a class="small" href="/student/achievements">My achievement collection →</a></section></div></div>
<div class="section-heading"><h2>Explore your next course</h2><a href="/student/courses">Browse catalog →</a></div><div class="grid cols-4 course-grid">{{#each recommended}}<article class="card course-card"><div class="course-art">↗<span>BSTM LEARNING</span></div><span class="chip">{{domain}}</span><h3 class="space-top">{{title}}</h3><p>{{description}}</p><div class="course-meta"><span>{{minutes}} min estimated</span><span>{{level}}</span></div><a class="button secondary" href="/student/courses/{{id}}">View course →</a></article>{{else}}<div class="card empty">No courses have been published yet.</div>{{/each}}</div>
{{> studentBottom}}

{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">A LITTLE PROGRESS, EVERY DAY</p><h1>Welcome back, {{currentUser.name}}.</h1><p class="muted">Build your knowledge. Discover your direction.</p></div><a class="button secondary" href="/student/courses">Explore courses ↗</a></div>
{{#unless profileComplete}}<div class="notice">Complete your academic profile to start learning. <a href="/student/profile"><strong>Set up my profile →</strong></a></div>{{/unless}}
<div class="grid cols-4"><a class="card stat dashboard-link" href="/student/learning"><span class="accent">{{> icon name="play"}}</span><span class="label">Courses in progress</span><span class="value">{{activeCount}}</span></a><a class="card stat dashboard-link" href="/student/learning"><span class="accent">{{> icon name="check"}}</span><span class="label">Completed attempts</span><span class="value">{{completedCount}}</span></a><a class="card stat dashboard-link" href="/student/achievements"><span class="accent">{{> icon name="certificate"}}</span><span class="label">Certificates earned</span><span class="value">{{credentialCount}}</span></a><a class="card stat rose dashboard-link" href="/student/achievements"><span class="accent">{{> icon name="award"}}</span><span class="label">Achievement stars</span><span class="value">{{totalStars}}</span></a></div>
<div class="grid dashboard-columns space-top"><div><section class="card hero"><p class="eyebrow">YOUR NEXT CHAPTER</p><h2>Small steps today.<br>More possibilities tomorrow.</h2><p>Explore tourism learning paths and turn your assessment results into a plan for growth.</p><a class="button" href="/student/careers">Discover my pathways →</a></section><div class="section-heading"><h2>Continue learning</h2><a href="/student/learning">View all →</a></div><div class="stack">{{#each ongoing}}<a class="card dashboard-link dashboard-summary" href="/student/learn/{{id}}"><div class="row"><span class="chip">{{domain}}</span><span class="small muted">Attempt {{attemptNumber}}</span></div><h3 class="space-top">{{title}}</h3><div class="progress-label"><span>{{done}} of {{total}} requirements</span><strong>{{percent}}%</strong></div><div class="progress-track"><div class="progress-fill" style="--progress:{{percent}}%"></div></div><span class="dashboard-card-action">Resume learning →</span></a>{{else}}<div class="card empty"><strong>Your learning journey is ready.</strong>Choose your first course and start building your skills.<br><a class="button" href="/student/courses">Find a course</a></div>{{/each}}</div></div><div><section class="card"><h2>My competency progress</h2><p class="small muted">Track how many modules you’ve passed in each competency.</p>
<div class="stack space-top">{{#each competencies}}
  <div><div class="progress-label"><strong>{{name}}</strong><span>{{#if total}}{{passed}} of {{total}} passed{{else}}No modules started{{/if}}</span></div>
    {{#if total}}<progress class="competency-progress" aria-label="{{name}} modules passed" value="{{passed}}" max="{{total}}"></progress>{{/if}}
  </div>
{{/each}}</div><a class="button secondary full space-top" href="/student/assessment">{{#if baseline}}Retake diagnostic{{else}}Take knowledge diagnostic{{/if}}</a></section><section class="card space-top"><h2>Recent achievements</h2>{{#each recentCredentials}}<div class="divider"></div><span class="chip">Certificate earned</span><h3 class="space-top">{{courseTitle}}</h3><p class="small muted">{{date}}</p>{{else}}<p class="small muted">Complete a course to unlock your first certificate and badge.</p>{{/each}}<a class="small" href="/student/achievements">My achievement collection →</a></section></div></div>
<div class="section-heading"><h2>Explore your next course</h2><a href="/student/courses">Browse catalog →</a></div><div class="grid cols-4 course-grid">{{#each recommended}}<a class="card course-card dashboard-link dashboard-summary" href="/student/courses/{{id}}"><div class="course-art">{{> icon name="book"}}<span>BSTM LEARNING</span></div><span class="chip">{{domain}}</span><h3 class="space-top">{{title}}</h3><p>{{description}}</p><div class="course-meta"><span>{{minutes}} min estimated</span><span>{{level}}</span></div><span class="dashboard-card-action">View course →</span></a>{{else}}<div class="card empty">No courses have been published yet.</div>{{/each}}</div>
{{#if requiredCourses}}<section class="card space-top"><h2>Assigned learning</h2>{{#each requiredCourses}}<p class="assignment-item"><a class="text-link" href="/student/courses/{{id}}">{{title}} →</a><span>{{#if done}}Completed ✓{{else}}Required{{/if}} · Due: {{due}}</span></p>{{/each}}</section>{{/if}}{{> studentBottom}}

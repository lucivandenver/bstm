{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">YOUR LEARNING JOURNEY</p><h1>My learning</h1><p class="muted">Pick up where you left off. Your progress is saved with your account.</p></div><a class="button secondary" href="/student/courses">Explore courses →</a></div>
<div class="section-heading"><h2>In progress</h2></div><div class="grid cols-3">{{#each ongoing}}<article class="card"><span class="chip">{{domain}}</span><h2 class="space-top">{{title}}</h2><p class="small muted">Attempt {{attemptNumber}} · Started {{started}}</p><div class="progress-label"><span>{{done}} / {{total}} requirements</span><strong>{{percent}}%</strong></div><div class="progress-track"><div class="progress-fill" style="--progress:{{percent}}%"></div></div><div class="course-meta"><span>{{learningMinutes}} min estimated activity</span><span>{{elapsedDays}} elapsed day(s)</span></div><a class="button full" href="/student/learn/{{id}}">Continue learning →</a></article>{{else}}<div class="card empty"><strong>No courses in progress.</strong><a class="button" href="/student/courses">Choose a course</a></div>{{/each}}</div>
<div class="section-heading"><h2>Completed attempts</h2></div><section class="card"><div class="table-wrap"><table><thead><tr><th>Course</th><th>Attempt</th><th>Completed</th><th>Final score</th><th></th></tr></thead><tbody>{{#each completed}}<tr><td>{{title}}</td><td>#{{attemptNumber}}</td><td>{{finished}}</td><td>{{finalScore}}%</td><td><a href="/student/courses/{{courseId}}">Review / retake →</a></td></tr>{{else}}<tr><td colspan="5" class="empty">Your completed courses will appear here.</td></tr>{{/each}}</tbody></table></div></section>
{{> studentBottom}}

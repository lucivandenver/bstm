{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">YOUR LEARNING JOURNEY</p><h1>My Learning</h1><p class="muted">Pick up where you left off. Lesson and assessment progress is saved to your account.</p></div><a class="button secondary" href="/student/courses">Explore Courses →</a></div>
<div class="section-heading"><h2>In progress</h2></div><div class="grid cols-3">{{#each ongoing}}<article class="card learning-card"><div class="progress-circle progress-state {{#if done}}is-partial{{else}}is-empty{{/if}}" style="--angle:{{percent}}%"><div>{{#if (eq percent 100)}}✓{{else}}{{percent}}%{{/if}}<small>{{#if (eq percent 0)}}NOT STARTED{{else}}IN PROGRESS{{/if}}</small></div></div><span class="chip">{{domain}}</span><h2 class="space-top">{{title}}</h2><p class="small muted">Attempt {{attemptNumber}} · Started {{started}}</p><div class="progress-label"><span>{{done}} / {{total}} requirements</span><strong>{{percent}}%</strong></div><div class="progress-track"><div class="progress-fill" style="--progress:{{percent}}%"></div></div><div class="course-meta"><span>{{learningMinutes}} min activity</span><span>{{elapsedDays}} day(s)</span></div><a class="button full" href="{{resumeHref}}">Continue Learning →</a></article>{{else}}<div class="card empty"><strong>No courses in progress.</strong><a class="button" href="/student/courses">Explore Courses</a></div>{{/each}}</div>
<div class="section-heading"><h2>Completed attempts</h2></div><section class="card"><div class="table-wrap"><table><thead><tr><th>Status</th><th>Course</th><th>Attempt</th><th>Completed</th><th>Final score</th><th></th></tr></thead><tbody>{{#each completed}}<tr><td><span class="check-circle is-complete" aria-label="Completed">✓</span></td><td>{{title}}</td><td>#{{attemptNumber}}</td><td>{{finished}}</td><td>{{finalScore}}%</td><td><a href="/student/courses/{{courseId}}">Review completed course →</a></td></tr>{{else}}<tr><td colspan="6" class="empty">Your completed courses will appear here.</td></tr>{{/each}}</tbody></table></div></section>
<div class="section-heading"><h2>Assessment history</h2><span class="small muted">Latest attempts</span></div><section class="card"><div class="table-wrap"><table><thead><tr><th>Course</th><th>Assessment</th><th>Attempt</th><th>Result</th><th>Date</th></tr></thead><tbody>{{#each learningHistory}}<tr><td>{{title}}</td><td>{{scope}}</td><td>#{{attemptNumber}}</td><td><span class="chip {{#unless passed}}rose{{/unless}}">{{score}}% · {{#if passed}}Passed{{else}}Not passed{{/if}}</span></td><td>{{date}}</td></tr>{{else}}<tr><td colspan="5" class="empty">Submitted quiz and final assessment results will appear here.</td></tr>{{/each}}</tbody></table></div></section>
{{> studentBottom}}

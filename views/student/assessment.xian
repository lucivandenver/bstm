{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">KNOW YOUR STARTING POINT</p><h1>Knowledge diagnostic</h1><p class="muted">A short check across four learning areas. Retakes are saved in your history.</p></div></div><div class="notice info">This starter diagnostic checks knowledge only. It is not yet a validated readiness instrument and does not replace faculty evaluation of practical skills.</div>
<form action="/student/assessment" method="post" class="card" data-quiz="baseline"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="challenge" value="{{challenge}}">{{> questions}}<p class="quiz-draft" role="status">Answers stay in this tab until submission or refresh.</p><button class="button">Save diagnostic results →</button></form>
<section class="card space-top"><h2>Previous diagnostics</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Knowledge score</th><th>Version</th></tr></thead><tbody>{{#each history}}<tr><td>{{date}}</td><td>{{score}}%</td><td>{{version}}</td></tr>{{else}}<tr><td colspan="3" class="empty">You have not completed a diagnostic yet.</td></tr>{{/each}}</tbody></table></div></section>
{{> studentBottom}}

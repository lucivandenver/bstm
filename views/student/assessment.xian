{{> studentTop}}
<div class="page-heading"><div><p class="muted">A short check across four learning areas. Retakes are saved in your history.</p></div></div><div class="notice info">This starter diagnostic checks knowledge only. It is not yet a validated readiness instrument and does not replace faculty evaluation of practical skills.</div>
<form action="/student/assessment" method="post" class="card" data-quiz="baseline" data-draft-url="/student/assessment/draft" data-revision="{{draftRevision}}"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="challenge" value="{{challenge}}">{{#each questions}}<fieldset class="question"><legend>{{prompt}}</legend>{{#each choices}}<label class="answer"><input type="radio" name="answers[{{../id}}]" value="{{index}}" {{#if checked}}checked{{/if}} required><span>{{label}}</span></label>{{/each}}</fieldset>{{/each}}<p class="quiz-draft" role="status">Previously saved answers have been restored. Answers save to your account as you work.</p><button class="button">Save diagnostic results →</button></form>
<section class="card space-top"><h2>Previous diagnostics</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Knowledge score</th><th>Version</th></tr></thead><tbody>{{#each history}}<tr><td>{{date}}</td><td>{{score}}%</td><td>{{version}}</td></tr>{{else}}<tr><td colspan="3" class="empty">You have not completed a diagnostic yet.</td></tr>{{/each}}</tbody></table></div></section>
{{> studentBottom}}

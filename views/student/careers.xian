{{> studentTop}}
<div class="page-heading"><div><h1>Find My Career</h1><p class="muted">Explore roles connected to the competencies you’ve assessed in your modules.</p></div></div>
{{#if hasPassedModule}}
<section class="card career-finder">
  <div class="row wrap"><h2>Your career matches</h2><a class="button secondary" href="/student/careers?find=matches#career-matches" data-career-match-search aria-controls="career-matches">{{> icon name="search"}} Find My Career Matches</a></div>
  <p class="small muted">Passed module assessments inform your matches. Below-passing module quiz scores identify areas to work on.</p>
  <div class="career-cloud-search" data-career-match-loading hidden role="status"><strong>Finding your career matches…</strong></div>
  {{#if aiReady}}<details class="space-top"><summary>Get an optional AI explanation</summary>
    <form action="/student/careers/generate" method="post" data-career-form>
      <input type="hidden" name="provider" value="{{aiProvider}}"><input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="answer"><input type="checkbox" name="consent" value="yes" required><span>I agree to share anonymised module titles, progress, and assessment scores with {{aiProviderLabel}}.</span></label>
      <button type="submit" class="button secondary space-top">Ask AI to explain my matches</button>
      <p class="notice error" data-career-error role="alert" hidden></p><p data-career-loading hidden role="status">Preparing your explanation…</p>
    </form>
  </details>{{/if}}
</section>
<script src="/js/career-finder.js" defer></script>
<section id="career-matches" aria-live="polite">
  {{#if showCareerMatches}}
    {{#if ai}}<div id="ai-results" class="card space-top"><h2>AI career guidance</h2><p>{{ai.summary}}</p>
      <div class="grid cols-2">{{#each ai.matches}}<article class="career-ai-match"><h3>{{title}}</h3><p class="small">These passed module assessments overlap with the pathway:</p>{{> careerModuleEvidence}}</article>{{/each}}</div>
    </div>{{/if}}
    <div class="grid cols-2 space-top">{{#each tracks}}<article class="card">
      <span class="chip">{{label}}</span><h2 class="space-top">{{title}}</h2><p>{{explanation}}</p>{{> careerModuleEvidence}}
      <h3>Assessed areas to improve</h3><ul class="list-clean">{{#each gaps}}<li>{{this}}</li>{{else}}<li>No below-target scores in the linked assessed areas.</li>{{/each}}</ul>
    </article>{{else}}<article class="card">No configured pathway matches the scored competencies in your passed modules yet.</article>{{/each}}</div>
    <div class="grid cols-2 space-top">
      <section class="card"><h2>Passed module evidence</h2>{{#each passedModules}}<p>{{title}} · Quiz {{score}}% · {{percent}}% progress</p>{{/each}}</section>
      <section class="card"><h2>Areas to work on</h2>{{#each developingCourses}}<p>{{title}} · {{percent}}% progress · Quiz {{score}}%</p>{{else}}<p>No below-passing module quiz results.</p>{{/each}}</section>
    </div>
  {{else}}<div class="card empty space-top"><h2>Your matches will appear here</h2></div>{{/if}}
</section>
{{else}}<section class="card"><h2>Pass a module to see career matches</h2><a class="button secondary" href="/student/learning">Open My Learning →</a></section>{{/if}}
{{> studentBottom}}

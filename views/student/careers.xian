{{> studentTop}}
<div class="page-heading"><div><p class="muted">Explore roles connected to the competencies you’ve assessed in your modules.</p></div></div>
{{#if hasPassedModule}}
<section class="card career-finder">
  <div class="row wrap"><h2>Your career matches</h2><a class="button secondary" href="/student/careers?find=matches#career-matches" data-career-match-search aria-controls="career-matches">{{> icon name="search"}} Find My Career Matches</a></div>
  <p class="small muted">Passed module assessments inform your matches. Below-passing module quiz scores identify areas to work on.</p>
  <div class="career-cloud-search" data-career-match-loading hidden role="status" aria-live="polite"><span class="career-clouds" aria-hidden="true"></span><span class="career-magnifier" aria-hidden="true">{{> icon name="search"}}</span><strong>Finding your career matches…</strong><p>Comparing your assessed competencies and earned learning evidence.</p></div>
  {{#if aiReady}}<details class="space-top"><summary>Get an optional AI explanation</summary>
    <form action="/student/careers/generate" method="post" data-career-form>
      <input type="hidden" name="provider" value="{{aiProvider}}"><input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="answer"><input type="checkbox" name="consent" value="yes" required><span>I agree to share anonymised module titles, progress, and assessment scores with {{aiProviderLabel}}.</span></label>
      <button type="submit" class="button secondary space-top">Ask AI to explain my matches</button>
      <p class="notice error" data-career-error role="alert" hidden></p><p class="career-ai-loading" data-career-loading hidden role="status"><span class="career-spinner" aria-hidden="true"></span> Preparing explanations for your matched pathways…</p>
    </form>
  </details>{{/if}}
</section>
<script src="/js/career-finder.js" defer></script>
<section id="career-matches" aria-live="polite">
  {{#if showCareerMatches}}
    <section class="card space-top"><h2>Matched career pathways</h2>
      {{#each sectorGroups}}<section class="space-top" data-career-sector>
        <h3>{{name}}</h3>
        <ul>{{#each tracks}}<li data-career-pathway>{{title}}</li>{{/each}}</ul>
      </section>{{/each}}
    </section>
    {{#if ai}}<section id="ai-results" class="card space-top"><h2>AI career guidance</h2><p>{{ai.summary}}</p><p class="small muted">Alignment reflects quiz evidence and coverage of the pathway’s required competencies.</p>
      {{#each sectorGroups}}{{#if explanations}}<section class="space-top" data-career-guidance-sector>
        <h3>{{name}}</h3>
        <div class="career-results-grid">{{#each explanations}}<article class="career-ai-match"><h4>{{title}}</h4>{{#if alignment}}<p><strong>{{alignment}}% evidence alignment</strong> · {{assessedAreas}} of {{totalAreas}} required areas assessed</p>{{/if}}<p>{{reason}}</p><p><strong>Next learning step:</strong> {{nextStep}}</p><details><summary>View supporting assessments and certificates</summary>{{> careerModuleEvidence}}</details>{{#if failedModules}}<details><summary>Related assessment gaps</summary>{{#each failedModules}}<p>{{title}} · {{score}}% · {{passingScore}}% to pass · {{retakeCount}} retake(s)</p>{{/each}}</details>{{/if}}</article>{{/each}}</div>
      </section>{{/if}}{{/each}}
    </section>{{/if}}
  {{else}}<div class="card empty space-top"><h2>Your matches will appear here</h2></div>{{/if}}
</section>
{{else}}<section class="card"><h2>Take and pass a module assessment to see career matches</h2><a class="button secondary" href="/student/courses">Explore Courses →</a></section>{{#if developingCourses}}<section class="card space-top"><h2>Assessments to review</h2>{{#each developingCourses}}<p>{{title}} · {{score}}% · {{passingScore}}% to pass · {{retakeCount}} retake(s)</p>{{/each}}</section>{{/if}}{{/if}}
{{> studentBottom}}

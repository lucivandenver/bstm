{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">YOUR STUDENT RECORD</p><h1>Personal &amp; academic details</h1><p class="muted">Update your student information directly. Changes do not need Admin approval.</p></div><span class="chip">{{#if profile.complete}}Profile complete{{else}}Setup needed{{/if}}</span></div>
<form action="/student/profile" method="post" class="stack"><input type="hidden" name="_csrf" value="{{csrf}}"><section class="card"><h2 class="field-title">Personal details</h2><div class="grid cols-2"><div class="field"><label for="name">Full name *</label><input id="name" name="name" value="{{currentUser.name}}" required minlength="2" maxlength="100"></div><div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" value="{{currentUser.email}}" required maxlength="254" autocomplete="email"></div><div class="field"><label for="gender">Gender *</label><select id="gender" name="gender" required><option value="">Select gender</option>{{#each genders}}<option {{selected this ../currentUser.gender}}>{{this}}</option>{{/each}}</select></div><div class="field"><label for="bio">Short introduction</label><textarea id="bio" name="bio" rows="3" maxlength="600" placeholder="Optional introduction">{{profile.bio}}</textarea></div></div></section>
<section class="card"><h2 class="field-title">Academic details</h2><div class="grid cols-2"><div class="field"><label for="studentId">Student ID *</label><input id="studentId" name="studentId" value="{{currentUser.studentId}}" required pattern="[A-Za-z0-9_-]{3,40}" maxlength="40"></div><div class="field"><label for="section">Section *</label><select id="section" name="section" required><option value="">Select section</option>{{#each sections}}<option {{selected this ../currentUser.section}}>{{this}}</option>{{/each}}</select></div><div class="field"><label for="yearLevel">Year level *</label><select id="yearLevel" name="yearLevel" required><option value="">Select year level</option><option {{selected profile.yearLevel '1st year'}}>1st year</option><option {{selected profile.yearLevel '2nd year'}}>2nd year</option><option {{selected profile.yearLevel '3rd year'}}>3rd year</option><option {{selected profile.yearLevel '4th year'}}>4th year</option><option {{selected profile.yearLevel 'Graduating'}}>Graduating</option></select></div><div class="field"><label for="academicYear">Academic year *</label><input id="academicYear" name="academicYear" value="{{profile.academicYear}}" required pattern="[0-9]{4}-[0-9]{4}" placeholder="2026-2027"></div><div class="field"><label for="graduationYear">Expected graduation year *</label><input id="graduationYear" name="graduationYear" value="{{profile.graduationYear}}" required pattern="20[0-9]{2}" maxlength="4" placeholder="2027"></div></div></section>
<div class="form-actions"><button class="button" type="submit">Save personal &amp; academic details</button></div></form>
{{> studentBottom}}

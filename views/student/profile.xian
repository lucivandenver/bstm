{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">YOUR STARTING POINT</p><h1>My student profile</h1><p class="muted">Keep your academic background and career interests up to date.</p></div><span class="chip">{{#if profile.complete}}Profile complete{{else}}Setup needed{{/if}}</span></div>
<form action="/student/profile" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="grid cols-2"><section class="card"><h2 class="field-title">Personal & academic details</h2><div class="grid cols-2"><div class="field"><label for="name">Full name *</label><input id="name" name="name" value="{{currentUser.name}}" required minlength="2" maxlength="100"></div><div class="field"><label for="email">Account email</label><input id="email" value="{{currentUser.email}}" readonly><small>Account identity is managed separately.</small></div><div class="field"><label for="studentId">Student ID *</label><input id="studentId" name="studentId" value="{{currentUser.studentId}}" required pattern="[A-Za-z0-9_-]{3,40}" maxlength="40"></div><div class="field"><label for="section">Section *</label><input id="section" name="section" value="{{currentUser.section}}" required maxlength="60" placeholder="BSTM 4-1"></div><div class="field"><label for="yearLevel">Year level *</label><select id="yearLevel" name="yearLevel" required><option value="">Select year level</option><option {{selected profile.yearLevel '4th year'}}>4th year</option><option {{selected profile.yearLevel 'Graduating'}}>Graduating</option></select></div><div class="field"><label for="academicYear">Academic year *</label><input id="academicYear" name="academicYear" value="{{profile.academicYear}}" required pattern="[0-9]{4}-[0-9]{4}" placeholder="2026-2027"></div><div class="field"><label for="graduationYear">Expected graduation year *</label><input id="graduationYear" name="graduationYear" value="{{profile.graduationYear}}" required pattern="20[0-9]{2}" maxlength="4" placeholder="2027"></div></div><div class="field space-top"><label for="bio">Short introduction</label><textarea id="bio" name="bio" rows="3" maxlength="600" placeholder="Tell us about your learning goals.">{{profile.bio}}</textarea></div></section><section class="card"><h2 class="field-title">OJT / practicum experience</h2><div class="grid cols-2"><div class="field"><label for="ojtStatus">OJT status *</label><select id="ojtStatus" name="ojtStatus" required><option value="">Select status</option><option {{selected profile.ojtStatus 'Not yet started'}}>Not yet started</option><option {{selected profile.ojtStatus 'Ongoing'}}>Ongoing</option><option {{selected profile.ojtStatus 'Completed'}}>Completed</option></select></div><div class="field"><label for="ojtHours">Completed hours</label><input id="ojtHours" name="ojtHours" type="number" min="0" max="10000" value="{{profile.ojtHours}}"></div><div class="field"><label for="ojtCompany">Employer / organisation</label><input id="ojtCompany" name="ojtCompany" value="{{profile.ojtCompany}}" maxlength="160"></div><div class="field"><label for="ojtArea">OJT area</label><input id="ojtArea" name="ojtArea" value="{{profile.ojtArea}}" maxlength="100" placeholder="Hotel front office"></div></div><h2 class="field-title space-top">Career direction</h2><div class="field"><label for="careerInterest">Preferred career area *</label><select id="careerInterest" name="careerInterest" required><option value="">Choose an area</option><option {{selected profile.careerInterest 'Travel and tour operations'}}>Travel and tour operations</option><option {{selected profile.careerInterest 'Hospitality and guest services'}}>Hospitality and guest services</option><option {{selected profile.careerInterest 'Airline and airport services'}}>Airline and airport services</option><option {{selected profile.careerInterest 'Events and MICE'}}>Events and MICE</option><option {{selected profile.careerInterest 'Cruise services'}}>Cruise services</option><option {{selected profile.careerInterest 'Destination and visitor services'}}>Destination and visitor services</option><option {{selected profile.careerInterest 'Still exploring'}}>Still exploring</option></select></div><div class="field space-top"><label for="preferredLocation">Preferred work location *</label><input id="preferredLocation" name="preferredLocation" value="{{profile.preferredLocation}}" required maxlength="120" placeholder="Philippines, international, or a specific location"></div></section></div><section class="card space-top"><h2 class="field-title">Self-declared skills & qualifications</h2><p class="small muted">These details describe your background. They are separate from assessed course results.</p><div class="grid cols-3"><div class="field"><label for="languages">Languages</label><input id="languages" name="languages" value="{{profile.languages}}" maxlength="200" placeholder="Filipino, English"></div><div class="field"><label for="skills">Skills and digital tools</label><textarea id="skills" name="skills" rows="3" maxlength="1500">{{profile.skills}}</textarea></div><div class="field"><label for="qualifications">Training / qualifications</label><textarea id="qualifications" name="qualifications" rows="3" maxlength="1500">{{profile.qualifications}}</textarea></div></div><div class="form-actions"><button class="button" type="submit">Save my profile</button></div></section></form>
<section class="card space-top"><h2>Google account connection</h2>{{#if googleConnected}}<span class="chip">Connected · Google-verified email</span><p class="small muted space-top">Use Sign in with Google on your next visit.</p>{{else}}<p class="small muted">Connect the Google account with the same email as this account. Your existing learning history stays with you.</p><form action="/student/connect-google" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary" {{#unless googleReady}}disabled{{/unless}}>Connect Google account</button></form>{{#unless googleReady}}<p class="small muted space-top">Google OAuth credentials need to be configured by the system owner.</p>{{/unless}}{{/if}}</section>
{{> studentBottom}}

{{> studentTop}}
<p class="small"><a href="/student/courses">← Back to catalog</a></p><div class="page-heading"><div><span class="chip">{{course.domain}}</span><h1 class="space-top">{{course.title}}</h1><p class="muted">{{course.description}}</p></div></div><div class="grid dashboard-columns"><section class="card"><h2>What you will learn</h2><div class="stack space-top">{{#each modules}}<div class="module"><h3>{{title}}</h3><ul class="list-clean small muted">{{#each lessons}}<li>{{title}}</li>{{/each}}</ul><span class="chip gray">Module quiz included</span></div>{{/each}}</div><div class="module"><h3>Final assessment & achievement</h3><p class="small muted">Complete all required lessons, pass module quizzes, then pass the final assessment to earn your certificate and badge.</p></div></section><aside class="card"><p class="eyebrow">AT A GLANCE</p><h2>{{course.level}} course</h2><div class="divider"></div><p class="small">Estimated learning time: <strong>{{course.minutes}} minutes</strong></p><p class="small">Passing score: <strong>{{course.passingScore}}%</strong></p><p class="small">Course version: <strong>{{course.version}}</strong></p><p class="small">Includes: <strong>Certificate · Badge · Stars</strong></p>{{#if course.starter}}<div class="notice info">Starter content · requires faculty validation.</div>{{/if}}{{#if active}}<a class="button full" href="/student/learn/{{active.id}}">Resume learning →</a>{{else}}<form action="/student/courses/{{course.id}}/enroll" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button full">{{#if attempts.length}}Start a new attempt{{else}}Enroll & start learning{{/if}}</button></form>{{/if}}<p class="small muted space-top">Retakes keep previous results and credentials. Each completed attempt receives its own credential.</p></aside></div>
{{#if attempts.length}}<section class="card space-top"><h2>Your attempt history</h2><div class="table-wrap"><table><thead><tr><th>Attempt</th><th>Started</th><th>Status</th><th>Progress</th><th>Final score</th><th></th></tr></thead><tbody>{{#each attempts}}<tr><td>#{{attemptNumber}}</td><td>{{started}}</td><td>{{status}}</td><td>{{percent}}%</td><td>{{#if completed}}{{finalScore}}%{{else}}Pending{{/if}}</td><td><a href="/student/learn/{{id}}">View →</a></td></tr>{{/each}}</tbody></table></div></section>{{/if}}
{{> studentBottom}}

{{> studentTop}}<a class="text-link" href="/student/learn/{{attempt.id}}">← Return to course</a><div class="page-heading"><div><p class="eyebrow">APPLY WHAT YOU LEARNED</p><h1>Activities & feedback</h1><p class="muted">{{attempt.title}} · Attempt {{attempt.attemptNumber}}</p></div></div>{{#each tasks}}<article class="card space-top"><h2>{{title}}</h2><p class="lesson-body">{{instructions}}</p><div class="table-wrap"><table><thead><tr><th>Rubric criterion</th><th>Maximum</th><th>Your score</th></tr></thead><tbody>{{#each rubric}}<tr><td>{{label}}</td><td>{{max}}</td><td>{{score}}</td></tr>{{/each}}</tbody></table></div>{{#if submission}}<p class="chip">{{submission.status}} {{#if submission.gradedAt}}· {{submission.grade}}%{{/if}}</p><p class="lesson-body">{{submission.response}}</p><p class="feedback-item">{{submission.feedback}}</p>{{/if}}{{#if canSubmit}}<form method="post" action="/student/learn/{{../attempt.id}}/activities/{{id}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><label class="field">Your response<textarea name="response" rows="5" required minlength="30" maxlength="12000">{{submission.response}}</textarea></label><label class="field">Evidence / recording link (optional, HTTPS)<input type="url" name="link" value="{{submission.link}}" placeholder="https://…" maxlength="1000"></label><p class="small muted">Make sure your assigned faculty can access the link. Complete the module quizzes before submitting.</p><button class="button">Submit for faculty grading</button></form>{{/if}}</article>{{else}}<div class="card empty">This course has no practical tasks.</div>{{/each}}<section class="card space-top"><h2>Course feedback</h2><p class="small muted">Available after passing the final assessment. This rating does not affect your grade.</p><form method="post" action="/student/learn/{{attempt.id}}/feedback"><input type="hidden" name="_csrf" value="{{csrf}}"><label class="field">How useful was this course?<select name="rating" required><option value="">Choose a rating</option><option value="5" {{selected feedback.rating 5}}>5 · Very useful</option><option value="4" {{selected feedback.rating 4}}>4 · Useful</option><option value="3" {{selected feedback.rating 3}}>3 · Neutral</option><option value="2" {{selected feedback.rating 2}}>2 · Needs improvement</option><option value="1" {{selected feedback.rating 1}}>1 · Not useful</option></select></label><label class="field">Comments (optional)<textarea name="comment" rows="3" maxlength="1500">{{feedback.comment}}</textarea></label><button class="button secondary">Save course feedback</button></form></section>{{> studentBottom}}

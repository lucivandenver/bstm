{{> studentTop}}
<p class="muted">Your earned badges and certificates.</p>
<form method="get" class="award-filters" aria-label="Find achievements">
<label class="field award-search">Search<input type="search" name="q" value="{{gallery.q}}" placeholder="Search by name, course, academy"></label>
<label class="field">Type<select name="type"><option value="">All</option><option value="badge" {{selected gallery.type 'badge'}}>Badge</option><option value="certificate" {{selected gallery.type 'certificate'}}>Certificate</option></select></label>
<label class="field">Sort<select name="sort"><option value="latest" {{selected gallery.sort 'latest'}}>Latest</option><option value="az" {{selected gallery.sort 'az'}}>A–Z</option></select></label><button class="button">Search</button></form>
<p class="small muted" role="status">{{gallery.count}} achievements</p>
<div class="award-gallery award-gallery-flow">{{#each gallery.records}}{{> awardGalleryItem}}{{else}}<section class="card empty">No matching achievements. Try another search or type.</section>{{/each}}</div>

<nav class="record-pagination actions" aria-label="Achievement pages">{{#if gallery.previous}}<a class="button secondary" href="{{gallery.previous}}">← Previous</a>{{/if}}<span>Page {{gallery.page}} of {{gallery.pages}}</span>{{#if gallery.next}}<a class="button secondary" href="{{gallery.next}}">Next →</a>{{/if}}</nav>
{{#if pendingAwards}}<details class="card space-top"><summary>Pending course certificates</summary>{{#each pendingAwards}}<p>{{title}} · Eligibility check pending</p>{{/each}}</details>{{/if}}
{{> studentBottom}}

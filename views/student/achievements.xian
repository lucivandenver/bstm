{{> studentTop}}
<div class="page-heading"><div><p class="muted">Browse your course and module awards.</p></div></div><div class="notice info">Pass a module assessment in a certificate-enabled course to earn its badge and certificate. Open a badge or certificate to see its details. Direct source citations are not an eligibility requirement. Stars reflect the assessment score: 75–84% = 1, 85–94% = 2, 95–100% = 3.</div>
{{#if pendingAwards}}<section class="card space-top"><h2>Completed courses awaiting certificate setup</h2><p class="small muted">Your course completion is saved. A certificate is issued automatically when all published course requirements are met.</p>{{#each pendingAwards}}<p class="assignment-item"><strong>{{title}}</strong><span>Completed {{date}} · eligibility check pending</span></p>{{/each}}</section>{{/if}}<div class="achievement-gallery space-top">{{#each credentials}}<article class="achievement">
<div class="award-pair">
  <button type="button" class="award-tile" data-open-award="badge-{{id}}"><span class="chip">Badge</span><span class="award-badge" aria-hidden="true">🏅</span><small>{{#if moduleTitle}}Module achievement{{else}}Course completion{{/if}}</small><strong>{{courseTitle}}</strong><span class="award-issued">Issued {{date}}</span></button>
  <button type="button" class="award-tile" data-open-award="certificate-{{id}}"><span class="chip">Certificate</span><span class="award-certificate" aria-hidden="true">▤</span><small>{{#if moduleTitle}}Module{{else}}Course{{/if}}</small><strong>{{#if moduleTitle}}{{moduleTitle}}{{else}}{{courseTitle}}{{/if}}</strong><span class="award-issued">Issued {{date}}</span></button>
</div>
<dialog id="badge-{{id}}" class="card award-dialog" aria-labelledby="badge-title-{{id}}">
  <form method="dialog"><button class="button ghost" aria-label="Close badge details">Close</button></form>
  <p class="eyebrow">Course badge</p><h2 id="badge-title-{{id}}">{{courseTitle}}</h2>
  {{#if moduleTitle}}<p>Earned for {{moduleTitle}}</p>{{/if}}<p>Issued {{date}} · MinSU Bongabong Campus</p>
  <p class="stars" aria-label="{{stars}} stars">{{starsText}}</p>
  {{#if skills}}<h3>Skills covered</h3><ul class="award-skills">{{#each skills}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  <a class="button" href="/verify/{{id}}" target="_blank" rel="noopener">View badge</a> <button class="button secondary" type="button" data-share-badge="/verify/{{id}}">Share badge</button><p role="status" data-share-status></p>
  <p class="small muted">The verification link shows your name and course completion when shared.</p>
</dialog>
<dialog id="certificate-{{id}}" class="card award-dialog" aria-labelledby="certificate-title-{{id}}">
  <form method="dialog"><button class="button ghost" aria-label="Close certificate details">Close</button></form>
  <p class="eyebrow">{{#if moduleTitle}}Module certificate{{else}}Course certificate{{/if}}</p><h2 id="certificate-title-{{id}}">{{#if moduleTitle}}{{moduleTitle}}{{else}}{{courseTitle}}{{/if}}</h2>
  <p>Awarded to {{recipientName}} · Issued {{date}}</p><p>{{#if moduleTitle}}Module assessment{{else}}Final assessment{{/if}} {{score}}%</p>
  <div class="actions"><a class="button secondary" data-download-certificate="/student/credentials/{{id}}/certificate" href="/student/credentials/{{id}}/certificate?view=1" target="_blank" rel="noopener">View &amp; download</a>
  <a class="button" href="/student/credentials/{{id}}/certificate">Download PDF</a></div>
</dialog></article>{{else}}{{#unless pendingAwards}}<section class="card empty"><strong>Your first achievement is ahead.</strong>Complete all requirements, pass the final assessment and meet the published course requirements to earn your certificate and badge.<br><a class="button" href="/student/courses">Explore courses →</a></section>{{/unless}}{{/each}}</div>
<section class="card space-top"><h2>Completion & improvement history</h2><div class="table-wrap"><table><thead><tr><th>Course</th><th>First / latest completion</th><th>Passed completions</th><th>Repeat completions</th><th>Latest / best final knowledge score</th></tr></thead><tbody>{{#each completionHistory}}<tr><td>{{title}}</td><td>{{first}}<small>{{latest}}</small></td><td>{{completions}}</td><td>{{repeats}}</td><td>{{latestScore}}% / {{best}}%</td></tr>{{else}}<tr><td colspan="5" class="empty">Complete your first course to start your history.</td></tr>{{/each}}</tbody></table></div></section><section class="card space-top"><h2>Published award criteria</h2><p>1 star: course passing score to 84% · 2 stars: 85–94% · 3 stars: 95–100%. Practical courses use the published weighted grade. A course can be completed once; after that, you can review it but cannot start another attempt.</p></section>{{> studentBottom}}


{{> studentTop}}
<p class="muted">Your earned badges and certificates.</p>
<form method="get" class="award-filters" aria-label="Find achievements">
<label class="field award-search">Search<input type="search" name="q" value="{{gallery.q}}" placeholder="Search by name, course, academy"></label>
<label class="field">Type<select name="type"><option value="">All</option><option value="badge" {{selected gallery.type 'badge'}}>Badge</option><option value="certificate" {{selected gallery.type 'certificate'}}>Certificate</option></select></label>
<label class="field">Sort<select name="sort"><option value="latest" {{selected gallery.sort 'latest'}}>Latest</option><option value="az" {{selected gallery.sort 'az'}}>A–Z</option></select></label><button class="button">Search</button></form>
<p class="small muted" role="status">{{gallery.count}} achievements</p>
<div class="award-gallery">{{#each gallery.records}}<article class="award-gallery-item">
<button type="button" class="award-gallery-card" data-open-award="{{dialogId}}" aria-label="View {{type}}: {{title}}"><span class="award-type">{{#if (eq type 'badge')}}Badge{{else}}Certificate{{/if}}</span><span class="award-art {{type}}">{{> achievementArt type=type}}</span><small>{{#if moduleTitle}}MODULE{{else}}COURSE{{/if}}</small><strong>{{title}}</strong><span class="award-date">Issued On: {{date}}</span></button>
<dialog id="{{dialogId}}" class="award-dialog award-detail" aria-labelledby="title-{{dialogId}}"><form method="dialog" class="award-close"><button type="submit" aria-label="Close achievement details">×</button></form><h2 id="title-{{dialogId}}">{{title}}</h2><div class="award-intro"><span class="award-art {{type}}">{{> achievementArt type=type}}</span><div><h3>{{courseTitle}}</h3><p>{{description}}</p></div></div>
<dl class="award-metadata"><div><dt>ISSUED DATE</dt><dd>{{date}}</dd></div><div><dt>ESTIMATED COURSE DURATION</dt><dd>{{#if minutes}}{{minutes}} minutes{{else}}Not specified{{/if}}</dd></div><div><dt>ACADEMY</dt><dd>{{academy}}</dd></div></dl>
<h3 class="award-section-label">SKILLS YOU LEARN</h3>{{#if (eq type 'badge')}}{{#each modules}}<section class="award-module-skills"><h4>{{moduleTitle}}</h4><ul>{{#each skills}}<li>{{this}}</li>{{else}}<li>No skills listed for this earned module.</li>{{/each}}</ul></section>{{else}}<p>No separate module skill records available.</p>{{/each}}{{else}}<ul>{{#each skills}}<li>{{this}}</li>{{else}}<li>{{title}}</li>{{/each}}</ul>{{/if}}
<footer class="award-detail-footer">{{#if (eq type 'badge')}}<a class="button" href="{{shareUrl}}" target="_blank" rel="noopener">View badge</a><button class="button" type="button" data-share-badge="{{shareUrl}}">View &amp; Share Badge</button><p data-share-status role="status"></p>{{else}}<a class="button" data-download-certificate="/student/credentials/{{id}}/certificate" href="/student/credentials/{{id}}/certificate?view=1" target="_blank" rel="noopener">View &amp; Download</a>{{/if}}</footer></dialog></article>{{else}}<section class="card empty">No matching achievements. Try another search or type.</section>{{/each}}</div>
<nav class="record-pagination actions" aria-label="Achievement pages">{{#if gallery.previous}}<a class="button secondary" href="{{gallery.previous}}">← Previous</a>{{/if}}<span>Page {{gallery.page}} of {{gallery.pages}}</span>{{#if gallery.next}}<a class="button secondary" href="{{gallery.next}}">Next →</a>{{/if}}</nav>
{{#if pendingAwards}}<details class="card space-top"><summary>Pending course certificates</summary>{{#each pendingAwards}}<p>{{title}} · Eligibility check pending</p>{{/each}}</details>{{/if}}
{{> studentBottom}}

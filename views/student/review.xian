{{> studentTop}}<a class="text-link" href="/student/learn/{{attempt.id}}">← Return to course</a><div class="page-heading"><div><p class="eyebrow">REVIEW & IMPROVE</p><h1>Assessment explanations</h1><p class="muted">{{attempt.title}}</p></div></div>{{#each questions}}<article class="card space-top"><h2>{{prompt}}</h2><p><strong>Correct answer:</strong> {{answer}}</p><p class="lesson-body">{{explanation}}</p>{{#if sourceReference}}<p class="small muted">Source: {{sourceReference}}</p>{{/if}}</article>{{/each}}{{> studentBottom}}

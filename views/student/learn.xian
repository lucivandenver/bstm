{{> studentTop}}
<p class="small"><a href="/student/learning">← My learning</a></p><div class="page-heading"><div><p class="eyebrow">ATTEMPT {{attempt.attemptNumber}}</p><h1>{{attempt.title}}</h1></div><span class="save-status" id="save-status" role="status">Progress saved to your account</span></div>
{{#if completed}}<div class="notice">Course completed. <a href="/student/achievements"><strong>View your certificate and badge →</strong></a> You can review the lessons and results here.</div>{{/if}}
{{#if pretestNeeded}}<div class="notice info">Start with the course pre-test to record your initial knowledge. <a class="text-link" href="/student/learn/{{attempt.id}}/quiz/pretest">Take pre-test →</a></div>{{/if}}<div class="toolbar"><a class="button secondary" href="/student/learn/{{attempt.id}}/activities">Practical activities & feedback →</a><span class="small muted">{{#if attempt.snapshot.deadline}}Recommended deadline: {{attempt.snapshot.deadline}}{{/if}}</span></div><div class="lesson-layout" data-attempt="{{attempt.id}}"><aside class="card lesson-sidebar"><div class="progress-circle" style="--angle:{{attempt.percent}}%"><div>{{attempt.percent}}%<small>COURSE PROGRESS</small></div></div><p class="small center muted">{{attempt.done}} of {{attempt.total}} checklist items complete</p><details class="lesson-outline" open><summary>Course outline</summary>{{#each modules}}<section class="module {{#unless available}}locked{{/unless}}"><h3>{{#if passed}}✓{{else}}{{#unless available}}🔒{{/unless}}{{/if}} Module {{number}} · {{title}}</h3>{{#each lessons}}{{#if ../available}}<a class="lesson-link {{#if (eq id ../../selected.id)}}active{{/if}}" {{#if (eq id ../../selected.id)}}aria-current="step"{{/if}} href="/student/learn/{{../../attempt.id}}?lesson={{id}}"><span class="check-circle {{#if completed}}is-complete{{else}}{{#if (eq id ../../selected.id)}}is-current{{else}}is-empty{{/if}}{{/if}}" aria-hidden="true">{{#if completed}}✓{{/if}}</span><span>{{number}} {{title}}</span></a>{{else}}<span class="lesson-link"><span class="check-circle is-empty" aria-hidden="true"></span><span>{{number}} {{title}}</span></span>{{/if}}{{/each}}{{#if quizAvailable}}<a class="lesson-link" href="/student/learn/{{../attempt.id}}/quiz/{{id}}"><span class="check-circle {{#if passed}}is-complete{{else}}is-empty{{/if}}" aria-hidden="true">{{#if passed}}✓{{/if}}</span>Module quiz {{#if passed}}· {{score}}%{{/if}}</a>{{#if passed}}<a class="small text-link" href="/student/learn/{{../attempt.id}}/review/{{id}}">Review quiz feedback →</a>{{/if}}{{else}}<span class="lesson-link"><span class="check-circle is-empty" aria-hidden="true">{{#unless available}}🔒{{/unless}}</span>Module quiz</span>{{/if}}</section>{{/each}}<section class="module">{{#if finalAvailable}}<a class="button secondary full" href="/student/learn/{{attempt.id}}/final">{{#if completed}}Course completed ✓{{else}}Take final assessment →{{/if}}</a>{{else}}<span class="small muted">🔒 Final assessment · pass all module quizzes first</span>{{/if}}<p class="small space-top"><a class="text-link" href="/student/learn/{{attempt.id}}/review/final">Review submitted final feedback →</a></p></section></details></aside>
<article class="card lesson-content">
  <p class="eyebrow">{{selected.moduleTitle}}</p>
  <div class="lesson-position">
    <span class="check-circle {{#if selected.completed}}is-complete{{else}}is-current{{/if}}" aria-hidden="true">{{#if selected.completed}}✓{{/if}}</span>
    <span>Lesson {{selected.number}} · {{#if selected.completed}}Completed{{else}}In progress{{/if}}</span>
  </div>
  <h1>{{selected.title}}</h1>
  {{#if iataIllustration}}
    <figure class="lesson-visual">
      <img src="/images/lessons/iata-airport.webp" alt="Illustration of an airplane, an airport terminal and a baggage tag" width="1200" height="614">
    </figure>
  {{/if}}
  {{#if materials}}
  <section class="notice info">
    <h2>Original learning materials</h2>
    <ul>{{#each materials}}<li><a href="{{href}}" target="_blank" rel="noopener">{{filename}}</a></li>{{/each}}</ul>
    {{#if readingConfirmed}}<p>Reading confirmed.</p>{{else}}{{#unless completed}}
    <form method="post" action="/student/learn/{{attempt.id}}/materials/{{readingModuleId}}/confirm">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="checkbox"><input type="checkbox" name="read" value="yes" required> I opened and read the module materials.</label>
      <button class="button">Confirm reading</button>
    </form>
    {{/unless}}{{/if}}
  </section>
  {{/if}}
  <div class="lesson-body space-top">{{selected.body}}</div>
  {{#if selected.takeaways}}
    <section class="takeaways">
      <h3>Key concepts for this lesson</h3>
      <ul class="lesson-concepts">{{#each selected.takeaways}}<li>{{this}}</li>{{/each}}</ul>
    </section>
  {{/if}}
  {{#unless completed}}
    <form action="/student/learn/{{attempt.id}}/complete" method="post" {{#if lessonChallenge}}data-lesson-completion data-lesson-challenge="{{lessonChallenge}}"{{/if}}>
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <input type="hidden" name="lessonId" value="{{selected.id}}">
      {{#if lessonChallenge}}
        <p class="small muted" tabindex="0" data-lecture-end role="status">Reach the end of the lecture to unlock Continue.</p>
        <input type="hidden" name="lessonChallenge">
        <noscript><p class="small">Enable JavaScript to record lecture completion.</p></noscript>
      {{/if}}
      <button class="button" {{#if lessonChallenge}}disabled{{/if}}>{{#if selected.completed}}Completed ✓ · Continue{{else}}Complete &amp; Continue →{{/if}}</button>
    </form>
  {{/unless}}
</article></div>
{{#if lessonChallenge}}<script src="/js/lesson-completion.js" defer></script>{{/if}}
{{> studentBottom}}

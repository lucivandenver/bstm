{{> studentTop}}
<p class="small"><a href="/student/learning">← My learning</a></p><div class="page-heading"><div><p class="eyebrow">ATTEMPT {{attempt.attemptNumber}} · VERSION {{attempt.courseVersion}}</p><h1>{{attempt.title}}</h1></div><span class="save-status" id="save-status" role="status">Progress saved to your account</span></div>
{{#if completed}}<div class="notice">Course completed. <a href="/student/achievements"><strong>View your certificate and badge →</strong></a> You can review lessons here or start a new attempt from the course page.</div>{{/if}}
<div class="lesson-layout" data-attempt="{{attempt.id}}"><aside class="card lesson-sidebar"><div class="progress-circle" style="--angle:{{attempt.percent}}%"><div>{{attempt.percent}}%<small>COURSE PROGRESS</small></div></div><p class="small center muted">{{attempt.done}} of {{attempt.total}} requirements complete</p><h2>Course outline</h2>{{#each modules}}<section class="module {{#unless available}}locked{{/unless}}"><h3>{{#if passed}}✓{{else}}{{#unless available}}🔒{{/unless}}{{/if}} {{title}}</h3>{{#each lessons}}{{#if ../available}}<a class="lesson-link {{#if (eq id ../../selected.id)}}active{{/if}}" href="/student/learn/{{../../attempt.id}}?lesson={{id}}">{{#if completed}}✓{{else}}○{{/if}} {{title}}</a>{{else}}<span class="lesson-link">○ {{title}}</span>{{/if}}{{/each}}{{#if quizAvailable}}<a class="lesson-link" href="/student/learn/{{../attempt.id}}/quiz/{{id}}">{{#if passed}}✓{{else}}○{{/if}} Module quiz {{#if passed}}· {{score}}%{{/if}}</a>{{else}}<span class="lesson-link">🔒 Module quiz</span>{{/if}}</section>{{/each}}<section class="module">{{#if finalAvailable}}<a class="button secondary full" href="/student/learn/{{attempt.id}}/final">{{#if completed}}Course completed ✓{{else}}Take final assessment →{{/if}}</a>{{else}}<span class="small muted">🔒 Final assessment · pass all module quizzes first</span>{{/if}}</section></aside>
<article class="card lesson-content"><p class="eyebrow">{{selected.moduleTitle}}</p><h1>{{selected.title}}</h1><p class="lesson-body space-top">{{selected.body}}</p><section class="takeaways"><h3>Keep these in mind</h3><ul class="list-clean">{{#each selected.takeaways}}<li>{{this}}</li>{{/each}}</ul></section>{{#unless completed}}<form action="/student/learn/{{attempt.id}}/complete" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="lessonId" value="{{selected.id}}"><button class="button">{{#if selected.completed}}Completed ✓ · Continue{{else}}Mark lesson complete & continue →{{/if}}</button></form>{{/unless}}<p class="small muted space-top">Lesson completion records your progress. Quizzes and the final assessment check your knowledge.</p></article></div>
{{> studentBottom}}

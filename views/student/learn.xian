{{> studentTop}}
<p class="small"><a href="/student/learning">← My learning</a></p><div class="page-heading"><div><p class="eyebrow">ATTEMPT {{attempt.attemptNumber}} · VERSION {{attempt.courseVersion}}</p><h1>{{attempt.title}}</h1></div><span class="save-status" id="save-status" role="status">Progress saved to your account</span></div>
{{#if completed}}<div class="notice">Course completed. <a href="/student/achievements"><strong>View your certificate and badge →</strong></a> You can review the lessons and results here. A second attempt is not available after completion.</div>{{/if}}
{{#if pretestNeeded}}<div class="notice info">Start with the course pre-test to record your initial knowledge. <a class="text-link" href="/student/learn/{{attempt.id}}/quiz/pretest">Take pre-test →</a></div>{{/if}}<div class="toolbar"><a class="button secondary" href="/student/learn/{{attempt.id}}/activities">Practical activities & feedback →</a><span class="small muted">{{#if attempt.snapshot.deadline}}Recommended deadline: {{attempt.snapshot.deadline}}{{/if}}</span></div><div class="lesson-layout" data-attempt="{{attempt.id}}"><aside class="card lesson-sidebar"><div class="progress-circle" style="--angle:{{attempt.percent}}%"><div>{{attempt.percent}}%<small>COURSE PROGRESS</small></div></div><p class="small center muted">{{attempt.done}} of {{attempt.total}} checklist items complete</p><details class="lesson-outline" open><summary>Course completion checklist</summary>{{#each modules}}<section class="module {{#unless available}}locked{{/unless}}"><h3>{{#if passed}}✓{{else}}{{#unless available}}🔒{{/unless}}{{/if}} {{title}}</h3>{{#each lessons}}{{#if ../available}}<a class="lesson-link {{#if (eq id ../../selected.id)}}active{{/if}}" href="/student/learn/{{../../attempt.id}}?lesson={{id}}"><span class="check-circle {{#if completed}}is-complete{{else}}{{#if (eq id ../../selected.id)}}is-current{{else}}is-empty{{/if}}{{/if}}" aria-hidden="true">{{#if completed}}✓{{/if}}</span>{{title}}</a>{{else}}<span class="lesson-link"><span class="check-circle is-empty" aria-hidden="true"></span>{{title}}</span>{{/if}}{{/each}}{{#if quizAvailable}}<a class="lesson-link" href="/student/learn/{{../attempt.id}}/quiz/{{id}}"><span class="check-circle {{#if passed}}is-complete{{else}}is-empty{{/if}}" aria-hidden="true">{{#if passed}}✓{{/if}}</span>Module quiz {{#if passed}}· {{score}}%{{/if}}</a>{{#if passed}}<a class="small text-link" href="/student/learn/{{../attempt.id}}/review/{{id}}">Review quiz feedback →</a>{{/if}}{{else}}<span class="lesson-link"><span class="check-circle is-empty" aria-hidden="true">{{#unless available}}🔒{{/unless}}</span>Module quiz</span>{{/if}}</section>{{/each}}<section class="module">{{#if finalAvailable}}<a class="button secondary full" href="/student/learn/{{attempt.id}}/final">{{#if completed}}Course completed ✓{{else}}Take final assessment →{{/if}}</a>{{else}}<span class="small muted">🔒 Final assessment · pass all module quizzes first</span>{{/if}}<p class="small space-top"><a class="text-link" href="/student/learn/{{attempt.id}}/review/final">Review submitted final feedback →</a></p></section></details></aside>
<article class="card lesson-content"><p class="eyebrow">{{selected.moduleTitle}}</p><h1>{{selected.title}}</h1><p class="lesson-body space-top">{{selected.body}}</p><section class="takeaways"><h3>Keep these in mind</h3><ul class="list-clean">{{#each selected.takeaways}}<li>{{this}}</li>{{/each}}</ul></section>{{#unless completed}}<form action="/student/learn/{{attempt.id}}/complete" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="lessonId" value="{{selected.id}}"><button class="button">{{#if selected.completed}}Completed ✓ · Continue{{else}}Mark lesson complete & continue →{{/if}}</button></form>{{/unless}}<p class="small muted space-top">Lesson completion records your progress. Quizzes and the final assessment check your knowledge.</p></article></div>
{{> studentBottom}}

{{> studentTop}}
<p class="small"><a href="/student/learning">← My learning</a></p><div class="row between"><span class="small muted">Attempt {{attempt.attemptNumber}}</span><span class="save-status" id="save-status" role="status">Progress saved to your account</span></div>
{{#if completed}}<div class="notice">Course completed. <a href="/student/achievements"><strong>View your certificate and badge →</strong></a> You can review the lessons and results here.</div>{{/if}}
{{#if pretestNeeded}}<div class="notice info">Start with the course pre-test to record your initial knowledge. <a class="text-link" href="/student/learn/{{attempt.id}}/quiz/pretest">Take pre-test →</a></div>{{/if}}<div class="toolbar"><a class="button secondary" href="/student/learn/{{attempt.id}}/activities">Practical activities & feedback →</a><span class="small muted">{{#if attempt.snapshot.deadline}}Recommended deadline: {{attempt.snapshot.deadline}}{{/if}}</span></div><div class="lesson-layout" data-attempt="{{attempt.id}}">{{> studentTopicOutline}}
<article class="card lesson-content">
  {{#unless moduleOnly}}<p class="eyebrow">{{selected.moduleTitle}}</p>{{/unless}}
  <div class="lesson-position">
    <span class="check-circle {{#if selected.completed}}is-complete{{else}}is-current{{/if}}" aria-hidden="true">{{#if selected.completed}}✓{{/if}}</span>
    <span>Topic {{selected.number}} · {{#if selected.completed}}Completed{{else}}{{#if readingRequired}}Confirm reading to start{{else}}Current topic{{/if}}{{/if}}</span>
  </div>
  <h1>{{selected.title}}</h1>
  {{#if iataIllustration}}
    <figure class="lesson-visual">
      <img src="/images/lessons/iata-airport.webp" alt="Illustration of an airplane, an airport terminal and a baggage tag" width="1200" height="614">
    </figure>
  {{/if}}
  {{#if materials.length}}
  <section class="notice info">
    <h2>Original learning materials</h2>
    <ul>{{#each materials}}<li><a href="{{href}}" target="_blank" rel="noopener">{{filename}}</a></li>{{/each}}</ul>
  </section>
  {{/if}}
  {{#if readingConfirmed}}<p class="small muted">Reading confirmed.</p>{{else}}{{#if readingRequired}}{{#unless completed}}
    <form method="post" action="/student/learn/{{attempt.id}}/materials/{{readingModuleId}}/confirm">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <label class="checkbox"><input type="checkbox" name="read" value="yes" required> I opened and read the module materials.</label>
      <button class="button">Confirm reading</button>
    </form>
    {{/unless}}{{/if}}{{/if}}
  <div class="lesson-body space-top">{{selected.body}}</div>
  {{#if selected.takeaways}}
    <section class="takeaways">
      <h3>Key concepts for this lesson</h3>
      <ul class="lesson-concepts">{{#each selected.takeaways}}<li>{{this}}</li>{{/each}}</ul>
    </section>
  {{/if}}
  {{#if selected.questions.length}}
  <section id="topic-quiz" class="space-top">
    <h2>Topic {{selected.number}} Quiz</h2>
    {{#if timedTopic}}<p class="chip" data-timer="{{remainingSeconds}}" role="timer"></p>{{/if}}
    {{#if topicExpired}}
    <form method="post" action="/student/learn/{{attempt.id}}/restart/{{selected.moduleId}}">
      <input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary">Restart expired quiz</button>
    </form>
    {{else}}{{#if selected.quizOpen}}
    <form data-draft-url="/student/learn/{{attempt.id}}/draft/{{selected.moduleId}}?topic={{selected.id}}" data-revision="{{topicRevision}}" data-inline-topic="{{selected.id}}" data-no-dirty>
      {{#each selected.questions}}<fieldset class="question"><legend>{{prompt}}</legend>
      {{#each options}}<label class="answer"><input type="radio" name="answers[{{../id}}]" value="{{index}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}
      </fieldset>{{/each}}
      <p class="quiz-draft" role="status">Answers save as you work.</p>
    </form>
    {{else}}<p class="muted">{{#if selected.quizDone}}Quiz answered.{{else}}Complete the topic and any required reading to unlock its questions.{{/if}}</p>{{/if}}
    {{/if}}
  </section>
  {{/if}}
  {{#unless completed}}
    {{#unless readingRequired}}{{#unless pretestNeeded}}{{#unless topicExpired}}
    <form {{#if selected.quizOpen}}data-topic-continue="{{selected.id}}"{{/if}} action="/student/learn/{{attempt.id}}/complete" method="post" {{#if lessonChallenge}}data-lesson-completion data-lesson-challenge="{{lessonChallenge}}"{{/if}}>
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <input type="hidden" name="lessonId" value="{{selected.id}}">
      {{#if lessonChallenge}}
        <p class="small muted" tabindex="0" data-lecture-end role="status">Reach the end of the lecture to unlock Continue.</p>
        <input type="hidden" name="lessonChallenge">
        <noscript><p class="small">Enable JavaScript to record lecture completion.</p></noscript>
      {{/if}}
      <button class="button" {{#if lessonChallenge}}disabled{{else}}{{#if selected.quizOpen}}{{#unless selected.quizDone}}disabled{{/unless}}{{/if}}{{/if}}>{{#if selected.lectureDone}}Continue →{{else}}Complete &amp; Continue →{{/if}}</button>
    </form>
    {{/unless}}{{/unless}}{{/unless}}
  {{/unless}}
</article></div>
{{#if lessonChallenge}}<script src="/js/lesson-completion.js" defer></script>{{/if}}
{{> studentBottom}}

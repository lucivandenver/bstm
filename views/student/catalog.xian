{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">LEARN SOMETHING THAT MOVES YOU FORWARD</p><h1>Explore courses</h1><p class="muted">Choose a learning path and build your tourism knowledge, one module at a time.</p></div></div>
<form class="filters" action="/student/courses" method="get"><label class="sr-only" for="q">Search courses</label><input class="search-input" id="q" name="q" placeholder="Search courses or topics…" value="{{query}}"><label class="sr-only" for="domain">Competency area</label><select id="domain" class="search-input" name="domain"><option value="">All competency areas</option>{{#each domains}}<option {{selected this ../selectedDomain}}>{{this}}</option>{{/each}}</select><button class="button">Find courses</button><a class="small" href="/student/courses">Reset</a></form>
<div class="notice info">Starter courses are short practice materials. Faculty should validate their content and assessments before academic use.</div>
<div class="grid cols-3">{{#each courses}}<article class="card course-card"><div class="course-art">↗<span>{{level}}</span></div><div class="row wrap"><span class="chip">{{domain}}</span>{{#if starter}}<span class="chip gray">Starter content</span>{{/if}}</div><h2 class="space-top">{{title}}</h2><p>{{description}}</p><div class="course-meta"><span>{{minutes}} min estimated</span><span>{{moduleCount}} modules</span><span>{{lessonCount}} lessons</span></div><div class="small muted">{{#if active}}In progress{{else}}{{#if done}}Previously completed · Retake available{{else}}{{#if locked}}Prerequisites required{{else}}Available to enroll{{/if}}{{/if}}{{/if}}</div><div class="divider"></div><a class="button {{#unless active}}secondary{{/unless}}" href="{{#if active}}/student/learn/{{active.id}}{{else}}/student/courses/{{id}}{{/if}}">{{#if active}}Resume learning{{else}}View course{{/if}} →</a></article>{{else}}<div class="card empty"><strong>No matching courses yet.</strong>Try another search or return when faculty publishes new content.</div>{{/each}}</div>
{{> studentBottom}}

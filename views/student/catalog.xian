{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">LEARN SOMETHING THAT MOVES YOU FORWARD</p><h1>Explore Courses</h1><p class="muted">Search faculty-published BSTM learning paths.</p></div></div>
<nav class="course-tabs" aria-label="Course lists"><a class="{{#if (eq view 'all')}}active{{/if}}" href="/student/courses">All courses</a><a class="{{#if (eq view 'saved')}}active{{/if}}" href="/student/courses?view=saved">Saved for later <span>{{savedCount}}</span></a><a class="{{#if (eq view 'enrolled')}}active{{/if}}" href="/student/courses?view=enrolled">Enrolled <span>{{enrolledCount}}</span></a></nav>
<form class="filters" action="/student/courses" method="get"><input type="hidden" name="view" value="{{view}}"><label class="sr-only" for="q">Search courses</label><input class="search-input" id="q" name="q" placeholder="Search courses or topics…" value="{{query}}"><label class="sr-only" for="domain">Competency area</label><select id="domain" class="search-input" name="domain"><option value="">All competency areas</option>{{#each domains}}<option {{selected this ../selectedDomain}}>{{this}}</option>{{/each}}</select><label class="sr-only" for="author">Faculty author</label><select id="author" class="search-input" name="author"><option value="">All faculty</option>{{#each faculty}}<option value="{{id}}" {{selected id ../selectedAuthor}}>{{name}}</option>{{/each}}</select><button class="button">Search</button><a class="small" href="/student/courses?view={{view}}">Reset</a></form>
{{#if hasRequired}}<h2 class="space-top">Required learning</h2>{{/if}}
<div class="grid cols-3">{{#each courses}}<article class="card course-card"><div class="course-art">↗<span>{{level}}</span></div><div class="row wrap"><span class="chip">{{areaLabels competencyAreas domain}}</span>{{#if required}}<span class="chip rose">Required</span>{{/if}}</div><h2 class="space-top">{{title}}</h2><p class="small muted">Created by {{author}}</p>{{#if required}}<p class="small">Due: {{due}}</p>{{/if}}<p>{{description}}</p><div class="course-meta"><span>{{minutes}} min estimated</span><span>{{moduleCount}} modules</span><span>{{lessonCount}} lessons</span></div><div class="small muted">{{#if active}}In progress{{else}}{{#if done}}Completed · review only{{else}}{{#if locked}}Prerequisites required{{else}}Published by faculty{{/if}}{{/if}}{{/if}}</div><div class="course-actions"><a class="button {{#unless active}}secondary{{/unless}}" href="{{#if active}}/student/learn/{{active.id}}{{else}}/student/courses/{{id}}{{/if}}">{{#if active}}Resume learning{{else}}{{#if done}}Review course{{else}}View course{{/if}}{{/if}} →</a>{{#if saved}}<form method="post" action="/student/courses/{{id}}/unsave"><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button ghost" aria-label="Remove {{title}} from saved courses">Saved ✓</button></form>{{else}}<form method="post" action="/student/courses/{{id}}/save"><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button ghost">Save for later</button></form>{{/if}}</div></article>{{else}}<div class="card empty"><strong>{{#if (eq view 'saved')}}No saved courses yet.{{else}}{{#if (eq view 'enrolled')}}No enrolled courses yet.{{else}}No matching courses yet.{{/if}}{{/if}}</strong>Courses published by faculty will appear here.</div>{{/each}}</div>
{{> studentBottom}}

{{> studentTop}}
<div class="page-heading"><div><p class="eyebrow">LEARN SOMETHING THAT MOVES YOU FORWARD</p><h1>Explore Courses</h1><p class="muted">Search faculty-published BSTM learning paths.</p></div></div>
<nav class="course-tabs" aria-label="Course lists"><a class="{{#if (eq view 'all')}}active{{/if}}" href="/student/courses">All courses</a><a class="{{#if (eq view 'saved')}}active{{/if}}" href="/student/courses?view=saved">Saved for later <span>{{savedCount}}</span></a><a class="{{#if (eq view 'enrolled')}}active{{/if}}" href="/student/courses?view=enrolled">Enrolled <span>{{enrolledCount}}</span></a></nav>
<form class="filters" action="/student/courses" method="get"><input type="hidden" name="view" value="{{view}}"><label class="sr-only" for="q">Search courses</label><input class="search-input" id="q" name="q" placeholder="Search courses or topics…" value="{{query}}"><label class="sr-only" for="domain">Competency area</label><select id="domain" class="search-input" name="domain"><option value="">All competency areas</option>{{#each domains}}<option {{selected this ../selectedDomain}}>{{this}}</option>{{/each}}</select><button class="button">Search</button><a class="small" href="/student/courses?view={{view}}">Reset</a></form>
{{#if hasRequired}}<h2 class="space-top">Required learning</h2>{{/if}}
<div class="grid cols-3">{{#each courses}}<article class="card student-catalog-card">
<a class="catalog-card-link" href="/student/courses/{{id}}">
<div class="catalog-card-meta"><span class="chip">{{areaLabels competencyAreas domain}}</span>{{#if required}}<span class="chip rose">Required</span>{{/if}}</div>
<h2>{{title}}</h2>
<p class="small muted">{{author}}{{#if due}} · Due {{due}}{{/if}}</p>
<div class="catalog-card-meta"><strong>{{moduleCount}} {{#if (eq moduleCount 1)}}module{{else}}modules{{/if}}</strong><span>View modules →</span></div>
</a></article>{{else}}<div class="card empty"><strong>{{#if (eq view 'saved')}}No saved courses yet.{{else}}{{#if (eq view 'enrolled')}}No enrolled courses yet.{{else}}No matching courses yet.{{/if}}{{/if}}</strong>Courses published by faculty will appear here.</div>{{/each}}</div>
{{> studentBottom}}

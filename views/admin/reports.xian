{{> adminTop}}<div class="student-progress-heading"><p class="muted">Latest 500 course attempts and diagnostics. The Excel workbook includes all course attempts and diagnostics.</p><a class="button secondary" href="/admin/reports/export">Download learning report · Excel ↓</a></div><div class="notice info">Knowledge scores and completion are learning evidence. They do not alone verify practical readiness or employment qualifications.</div><section class="card"><h2>Course activity</h2><div class="table-wrap"><table><thead><tr><th>Student / section</th><th>Course</th><th>Attempt</th><th>Status</th><th>Final score</th><th>Started</th></tr></thead><tbody>{{#each attempts}}<tr><td>{{User.name}}<br>{{User.section}}</td><td>{{title}}</td><td>{{attemptNumber}}</td><td>{{status}}</td><td>{{#if (eq finalScore null)}}Not assessed{{else}}{{finalScore}}%{{/if}}</td><td>{{date}}</td></tr>{{else}}<tr><td colspan="6" class="empty">No course activity yet.</td></tr>{{/each}}</tbody></table></div></section><section class="card space-top"><h2>Knowledge diagnostics</h2><div class="table-wrap"><table><thead><tr><th>Student account</th><th>Date</th><th>Overall knowledge score</th></tr></thead><tbody>{{#each diagnostics}}<tr><td><a href="/admin/users/{{userId}}">{{User.name}} · {{User.section}}</a></td><td>{{date}}</td><td>{{score}}%</td></tr>{{else}}<tr><td colspan="3" class="empty">No diagnostics yet.</td></tr>{{/each}}</tbody></table></div></section><div class="grid cols-2 space-top"><section class="card"><h2>System-wide competency evidence</h2><div class="table-wrap"><table><thead><tr><th>Area</th><th>Students assessed</th><th>Average</th><th>Below 75%</th></tr></thead><tbody>{{#each domainSummary}}<tr><td>{{name}}</td><td>{{assessed}}</td><td>{{average}}</td><td>{{gaps}}</td></tr>{{else}}<tr><td colspan="4" class="empty">No student evidence yet.</td></tr>{{/each}}</tbody></table></div><p class="small muted">Latest valid evidence per student. Unassessed areas are excluded. Completed rubric evidence uses the published 70/30 alignment policy.</p></section><section class="card"><h2>Section summary</h2><div class="table-wrap"><table><thead><tr><th>Section</th><th>Students</th><th>Attempts</th><th>Completions</th></tr></thead><tbody>{{#each sectionSummary}}<tr><td>{{name}}</td><td>{{students}}</td><td>{{attempts}}</td><td>{{completed}}</td></tr>{{/each}}</tbody></table></div></section></div>{{> adminBottom}}

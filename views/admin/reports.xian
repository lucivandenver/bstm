{{> adminTop}}<div class="row wrap"><p class="muted">Latest 500 course attempts and diagnostics. The CSV includes all course attempts.</p><a class="button secondary" href="/admin/reports/export">Download learning report · CSV ↓</a></div><div class="notice info">Knowledge scores and completion are learning evidence. They do not alone verify practical readiness or employment qualifications.</div><section class="card"><h2>Course activity</h2><div class="table-wrap"><table><thead><tr><th>Student / section</th><th>Course</th><th>Attempt</th><th>Status</th><th>Final score</th><th>Started</th></tr></thead><tbody>{{#each attempts}}<tr><td>{{User.name}}<br>{{User.section}}</td><td>{{title}}</td><td>{{attemptNumber}}</td><td>{{status}}</td><td>{{#if (eq finalScore null)}}Not assessed{{else}}{{finalScore}}%{{/if}}</td><td>{{date}}</td></tr>{{else}}<tr><td colspan="6" class="empty">No course activity yet.</td></tr>{{/each}}</tbody></table></div></section><section class="card space-top"><h2>Knowledge diagnostics</h2><div class="table-wrap"><table><thead><tr><th>Student account</th><th>Date</th><th>Overall knowledge score</th></tr></thead><tbody>{{#each diagnostics}}<tr><td><a href="/admin/users/{{userId}}">Account #{{userId}}</a></td><td>{{date}}</td><td>{{score}}%</td></tr>{{else}}<tr><td colspan="3" class="empty">No diagnostics yet.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

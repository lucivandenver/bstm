{{> adminTop}}
<form class="filters" method="get" action="/admin/faculty"><select class="search-input" name="approval"><option value="">All statuses</option><option value="pending" {{selected approval 'pending'}}>Pending</option><option value="returned" {{selected approval 'returned'}}>Returned</option><option value="approved" {{selected approval 'approved'}}>Approved</option><option value="rejected" {{selected approval 'rejected'}}>Rejected</option></select><button class="button">Filter</button></form>
{{#each faculty}}<section class="card space-top"><div class="row"><div><h2>{{name}}</h2><p>{{email}} · Faculty ID: {{facultyId}}</p></div><span class="chip">{{approvalStatus}}</span></div><div class="grid cols-3"><p><strong>Position</strong><br>{{facultyPosition}}</p><p><strong>Education</strong><br>{{facultyEducation}}</p><p><strong>Qualifications</strong><br>{{facultyQualifications}}</p></div>{{#if facultyReviewedAt}}<p>Last review: {{facultyReviewedAt}} by admin #{{facultyReviewedBy}}</p>{{/if}}{{#if facultyReviewRemarks}}<p>Latest feedback: {{facultyReviewRemarks}}</p>{{/if}}{{#if courses}}<h3>Courses and credentials</h3><ul>{{#each courses}}<li>{{title}} · Credential: {{request}} · certificates issued: {{awardsIssued}}</li>{{/each}}</ul>{{/if}}{{#if (eq approvalStatus 'pending')}}<form method="post" action="/admin/users/{{id}}/approval" class="space-top"><input type="hidden" name="_csrf" value="{{../csrf}}"><label class="checkbox"><input type="checkbox" name="verifyIdentity" value="yes"> Faculty identity and registration details verified</label><label class="checkbox"><input type="checkbox" name="verifyQualifications" value="yes"> Education and qualifications reviewed</label><label class="field">Review notes<textarea name="remarks" maxlength="1000"></textarea></label><div class="actions"><button class="button" name="status" value="approved">Approve</button><button class="button secondary" name="status" value="returned">Return for updates</button><button class="button danger" name="status" value="rejected">Reject</button></div></form>{{/if}}</section>{{else}}<section class="card"><p>No faculty registrations found.</p></section>{{/each}}
{{> adminBottom}}

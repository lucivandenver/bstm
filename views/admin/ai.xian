{{> adminTop}}<div class="grid cols-2"><section class="card"><h2>Provider status</h2><p class="chip">{{#if configured}}{{providerLabel}} configured{{else}}Not configured{{/if}}</p><p class="small">Model: {{model}}</p><p class="muted">Selected course provider: {{providerLabel}}. Configure provider credentials and model privately in Render. Secrets are never shown or edited here.</p><p class="small">{{sources}} source documents stored. Requests contain teaching material; student identity details are excluded from career guidance.</p></section><section class="card"><h2>Generation usage limit</h2><form method="post" action="/admin/ai"><input type="hidden" name="_csrf" value="{{csrf}}"><label class="field">Course draft requests per faculty in 24 hours<input name="limit" value="{{limit}}" type="number" min="1" max="50" required></label><button class="button">Save usage limit</button></form><p class="small muted">Failed requests count toward the limit. This is a request cap; provider billing is managed separately.</p></section></div><section class="card space-top"><h2>Generation jobs</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>User ID</th><th>Job</th><th>Status</th><th>Failure code</th><th>Course ID</th></tr></thead><tbody>{{#each jobs}}<tr><td>{{date}}</td><td>{{userId}}</td><td>{{type}}</td><td>{{status}}</td><td>{{errorCode}}</td><td>{{courseId}}</td></tr>{{else}}<tr><td colspan="6" class="empty">No AI generation jobs yet.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

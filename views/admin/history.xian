{{> adminTop}}<a class="text-link" href="/admin/courses">← Course oversight</a><section class="card space-top"><h2>{{course.title}}</h2><p class="muted">Current version: {{course.version}}. Published changes do not alter snapshots of existing student attempts.</p><div class="table-wrap"><table><thead><tr><th>Date</th><th>Version</th><th>Action</th><th>Actor ID</th><th>Snapshot title</th></tr></thead><tbody>{{#each revisions}}<tr><td>{{date}}</td><td>{{version}}</td><td>{{action}}</td><td>{{actorId}}</td><td>{{snapshot.title}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No recorded publication changes yet.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

{{> adminTop}}<div class="notice info">Required competency areas drive the student's transparent learning-alignment rules. These pathways need academic validation and do not represent employment probabilities.</div><div class="stack">{{#each paths}}<form class="card" action="/admin/careers/{{id}}" method="post"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="grid cols-2"><div class="field"><label>Career title<input name="title" value="{{title}}" required maxlength="160"></label></div><div class="field"><label>Focus / sector<input name="focus" value="{{focus}}" maxlength="160"></label></div></div><p class="small space-top"><strong>Required competency areas</strong></p>{{#each domainOptions}}<label class="checkbox"><input type="checkbox" name="required" value="{{name}}" {{#if chosen}}checked{{/if}}>{{name}}</label>{{/each}}<div class="row"><label class="checkbox"><input type="checkbox" name="active" value="true" {{#if active}}checked{{/if}}>Active pathway</label><button class="button secondary">Save pathway</button></div></form>{{/each}}</div><section class="card space-top"><h2>Add pathway</h2><form action="/admin/careers" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="grid cols-2"><div class="field"><label>Career title<input name="title" required maxlength="160"></label></div><div class="field"><label>Focus / sector<input name="focus" maxlength="160"></label></div></div>{{#each domains}}<label class="checkbox"><input type="checkbox" name="required" value="{{this}}">{{this}}</label>{{/each}}<input type="hidden" name="active" value="true"><button class="button">Add pathway</button></form></section>{{> adminBottom}}

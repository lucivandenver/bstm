{{> adminTop}}
<form class="filters" method="get" action="/admin/credential-approvals"><select class="search-input" name="status"><option value="">All statuses</option><option value="pending" {{selected status 'pending'}}>Pending</option><option value="returned" {{selected status 'returned'}}>Returned</option><option value="approved" {{selected status 'approved'}}>Approved</option><option value="rejected" {{selected status 'rejected'}}>Rejected</option></select><button class="button">Filter</button></form>
{{#each requests}}<section class="card space-top"><div class="row"><div><h2>{{course.title}}</h2><p>Faculty: {{faculty.name}} · {{faculty.facultyPosition}} · Badge: {{badge.label}}</p></div><span class="chip">{{status}}</span></div><h3>Standard certificate preview</h3>{{> certificatePreview title=course.title institution=../institutionName signature=facultySignature name=faculty.name position=faculty.facultyPosition}}<p>Faculty signature review</p><img src="{{facultySignature}}" alt="Faculty signature preview" style="max-width:320px;max-height:120px;background:#f5f5f5"><form method="post" action="/admin/credential-approvals/{{id}}" class="space-top"><input type="hidden" name="_csrf" value="{{../csrf}}"><label class="checkbox"><input type="checkbox" name="verifyCourse" value="yes" required> Course and badge information verified</label><label class="checkbox"><input type="checkbox" name="verifyFacultySignature" value="yes" required> Faculty signature verified</label><label class="checkbox"><input type="checkbox" name="verifyTemplate" value="yes" required> Standard certificate layout checked</label><label class="field">Remarks / return reason<textarea name="remarks" maxlength="1000"></textarea></label><div class="actions"><button class="button" name="status" value="approved">Approve</button><button class="button secondary" name="status" value="returned">Return for changes</button><button class="button danger" name="status" value="rejected">Reject</button></div></form>{{#if reviewedAt}}<small>Reviewed {{reviewedAt}} · {{remarks}}</small>{{/if}}</section>{{else}}<section class="card"><p>No credential requests in this status.</p></section>{{/each}}
{{> adminBottom}}

{{> adminTop}}<section class="card"><h2>Publish a notice</h2><form method="post" action="/admin/announcements"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="inline-fields"><div class="field"><label>Title<input name="title" required maxlength="160"></label></div><div class="field"><label>Audience<select name="audience"><option value="all">All users</option><option value="student">Students</option><option value="faculty">Faculty</option></select></label></div></div><div class="field space-top"><label>Message<textarea name="body" required maxlength="3000" rows="4"></textarea></label></div><label class="checkbox"><input type="checkbox" name="published" value="true" checked>Published</label><button class="button">Save notice</button></form></section><div class="stack space-top">{{#each announcements}}<details class="card"><summary>{{title}} · {{audience}} · {{#if published}}Published{{else}}Draft{{/if}}</summary><form method="post" action="/admin/announcements/{{id}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="grid cols-2"><div class="field"><label>Title<input name="title" value="{{title}}" required maxlength="160"></label></div><div class="field"><label>Audience<select name="audience"><option {{selected audience 'all'}}>all</option><option {{selected audience 'student'}}>student</option><option {{selected audience 'faculty'}}>faculty</option></select></label></div></div><div class="field space-top"><label>Message<textarea name="body" required maxlength="3000" rows="4">{{body}}</textarea></label></div><label class="checkbox"><input type="checkbox" name="published" value="true" {{#if published}}checked{{/if}}>Published</label><button class="button secondary">Save changes</button></form></details>{{/each}}</div>{{> adminBottom}}

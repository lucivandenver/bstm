{{> adminTop}}<p class="muted">Latest 200 issued credentials. Revoked certificates stop verifying as valid and disappear from student downloads.</p><section class="card"><div class="table-wrap"><table><thead><tr><th>Recipient</th><th>Course / issued</th><th>Score</th><th>Status</th><th>Verification / action</th></tr></thead><tbody>{{#each credentials}}<tr><td>{{recipientName}}</td><td>{{courseTitle}}<br>{{date}}</td><td>{{score}}%</td><td>{{#if revoked}}Revoked{{else}}Valid{{/if}}</td><td><a href="/verify/{{id}}" target="_blank" rel="noopener">View verification ↗</a>{{#unless revoked}}<form action="/admin/credentials/{{id}}/revoke" method="post" class="space-top"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="field"><label>Revocation reason<input name="reason" required minlength="5" maxlength="300"></label></div><button class="button danger compact space-top">Revoke credential</button></form>{{/unless}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No credentials issued yet.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

{{> adminTop}}<div class="grid cols-2"><section class="card"><h2>{{currentUser.name}}</h2><p>{{currentUser.email}}</p><span class="chip">Administrator</span><div class="divider"></div><h2>Google sign-in</h2>{{#if googleConnected}}<p class="small">Your Google account is connected.</p>{{else}}<p class="small muted">Connect the Google account with the same email as your administrator account.</p><form method="post" action="/admin/connect-google"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary" {{#unless googleConfigured}}disabled{{/unless}}>Connect Google</button></form>{{/if}}</section><section class="card"><h2>{{#if hasPassword}}Change password{{else}}Set a password{{/if}}</h2><p class="small muted">Use your current password, or sign in with Google again and set the password within 10 minutes. Other sessions are invalidated.</p><form method="post" action="/admin/account/password"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Current password<input type="password" name="currentPassword" autocomplete="current-password"></label></div><div class="field space-top"><label>New password<input type="password" name="newPassword" required minlength="14" maxlength="72" autocomplete="new-password"></label></div><div class="field space-top"><label>Confirm password<input type="password" name="confirmPassword" required minlength="14" maxlength="72" autocomplete="new-password"></label></div><button class="button space-top">Save password</button></form></section></div>{{> adminBottom}}

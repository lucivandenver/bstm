{{> adminTop}}<p class="muted">Assign approved faculty to a section. Assigned faculty can monitor its students. Archive sections to hide them from new registration.</p><div class="stack">{{#each sections}}<form class="card" method="post" action="/admin/sections/{{id}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="inline-fields"><div class="field"><label>Section name<input name="name" value="{{name}}" required maxlength="60"></label></div><div class="field"><label>Academic year<input name="academicYear" value="{{academicYear}}" required pattern="[0-9]{4}-[0-9]{4}"></label></div><div class="field"><label>Faculty<select name="facultyId"><option value="">Unassigned</option>{{#each ../faculty}}<option value="{{id}}" {{selected id ../facultyId}}>{{name}}</option>{{/each}}</select></label></div></div><div class="row space-top"><label class="checkbox"><input type="checkbox" name="active" value="true" {{#if active}}checked{{/if}}>Available for registration</label><button class="button secondary">Save section</button></div></form>{{/each}}</div><section class="card space-top"><h2>Add section</h2><form method="post" action="/admin/sections"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="active" value="true"><div class="inline-fields"><div class="field"><label>Section name<input name="name" required maxlength="60" placeholder="BSTM 4-5"></label></div><div class="field"><label>Academic year<input name="academicYear" required pattern="[0-9]{4}-[0-9]{4}" placeholder="2026-2027"></label></div><div class="field"><label>Faculty<select name="facultyId"><option value="">Unassigned</option>{{#each faculty}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label></div></div><button class="button space-top">Add section</button></form></section>{{> adminBottom}}

{{> adminTop}}
<p class="muted">Active sections appear in new student registrations. Deactivate a section to hide it while preserving records. Faculty are not assigned to sections.</p>
<div class="stack">
{{#each sections}}
<section class="card">
<form method="post" action="/admin/sections/{{id}}">
<input type="hidden" name="_csrf" value="{{../csrf}}">
<div class="inline-fields"><div class="field"><label>Section name<input name="name" value="{{name}}" required maxlength="60"></label></div><div class="field"><label>Academic year<input name="academicYear" value="{{academicYear}}" required pattern="[0-9]{4}-[0-9]{4}"></label></div></div>
<div class="row space-top"><label class="checkbox"><input type="checkbox" name="active" value="true" {{#if active}}checked{{/if}}>Active and available for registration</label><button class="button secondary" type="submit">Save section</button></div>
</form>
<form method="post" action="/admin/sections/{{id}}/delete" data-confirm="Delete this section? Sections with student or course records are protected."><input type="hidden" name="_csrf" value="{{../csrf}}"><button class="button danger space-top" type="submit">Delete section</button></form>
</section>
{{else}}<section class="card empty">No sections yet.</section>{{/each}}
</div>
<section class="card space-top"><h2>Add section</h2><form method="post" action="/admin/sections"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="active" value="true"><div class="inline-fields"><div class="field"><label>Section name<input name="name" required maxlength="60" placeholder="BSTM 4-5"></label></div><div class="field"><label>Academic year<input name="academicYear" required pattern="[0-9]{4}-[0-9]{4}" placeholder="2026-2027"></label></div></div><button class="button space-top">Add section</button></form></section>
{{> adminBottom}}

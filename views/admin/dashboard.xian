{{> adminTop}}<p class="muted">Manage access, oversee learning activity and keep academic records consistent.</p><div class="grid cols-4"><div class="card stat"><span class="label">Students</span><strong class="value">{{students}}</strong><a class="small" href="/admin/users?role=student">Manage students →</a></div><div class="card stat"><span class="label">Faculty</span><strong class="value">{{faculty}}</strong><a class="small" href="/admin/users?role=faculty">Manage faculty →</a></div><div class="card stat rose"><span class="label">Awaiting approval</span><strong class="value">{{pending}}</strong><a class="small" href="/admin/users?role=faculty&amp;approval=pending">Review registrations →</a></div><div class="card stat"><span class="label">Valid certificates</span><strong class="value">{{credentials}}</strong><a class="small" href="/admin/credentials">View credentials →</a></div></div><div class="grid cols-3 space-top"><div class="card"><h2>{{courses}} courses</h2><p class="small muted">Review published and archived learning content.</p><a href="/admin/courses">Course oversight →</a></div><div class="card"><h2>{{completed}} / {{enrollments}} attempts completed</h2><div class="progress-track"><div class="progress-fill" style="--progress:{{completionRate}}%"></div></div><p class="small muted">Course completion is separate from assessed readiness.</p></div><div class="card"><h2>Academic organisation</h2><p class="small muted">Assign approved faculty members to sections for monitoring.</p><a href="/admin/sections">Sections & assignments →</a></div></div><section class="card space-top"><h2>Recent activity</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Action</th><th>Actor ID</th><th>Target</th></tr></thead><tbody>{{#each recent}}<tr><td>{{date}}</td><td>{{action}}</td><td>{{actorId}}</td><td>{{targetType}} {{targetId}}</td></tr>{{else}}<tr><td colspan="4" class="empty">No recorded activity yet.</td></tr>{{/each}}</tbody></table></div><a class="small" href="/admin/audit">View activity log →</a></section>{{> adminBottom}}

{{> adminTop}}<p class="muted">Manage faculty registrations, credential approvals and learning activity.</p><div class="grid cols-4"><div class="card stat"><span class="accent">{{> icon name="users"}}</span><span class="label">Students</span><strong class="value">{{students}}</strong><a class="small" href="/admin/users?role=student">Manage students</a></div><div class="card stat"><span class="accent">{{> icon name="user"}}</span><span class="label">Faculty</span><strong class="value">{{faculty}}</strong><a class="small" href="/admin/faculty">Faculty records</a></div><div class="card stat rose"><span class="accent">{{> icon name="clock"}}</span><span class="label">Pending faculty</span><strong class="value">{{pending}}</strong><a class="small" href="/admin/faculty?approval=pending">Review registrations</a></div><div class="card stat {{#if pendingCredentials}}publication-needs-review{{else}}{{#if pendingPublications}}publication-needs-review{{/if}}{{/if}}"><span class="accent">{{> icon name="certificate"}}</span><span class="label">Pending credentials</span><strong class="value">{{pendingCredentials}}</strong><a class="small" href="/admin/credential-approvals?status=pending">Review requests</a>{{#if pendingPublications}}<p><a class="chip publication-review-label" href="/admin/courses?status=pending">{{pendingPublications}} pending publications</a></p>{{/if}}</div></div><div class="grid cols-3 space-top"><div class="card"><h2>{{courses}} courses</h2><p class="small muted">Review published and archived learning content.</p><a href="/admin/courses">Course oversight →</a></div><div class="card"><h2>{{completed}} / {{enrollments}} attempts completed</h2><div class="progress-track"><div class="progress-fill" style="--progress:{{completionRate}}%"></div></div><p class="small muted">Course completion is separate from assessed readiness.</p></div><div class="card"><h2>Academic organisation</h2><p class="small muted">Activate sections for student registration and assign courses to sections when needed.</p><a href="/admin/sections">Sections & assignments →</a></div></div><section class="card space-top"><h2>Recent activity</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Action</th><th>Actor ID</th><th>Target</th></tr></thead><tbody>{{#each recent}}<tr><td>{{date}}</td><td>{{action}}</td><td>{{actorId}}</td><td>{{targetType}} {{targetId}}</td></tr>{{else}}<tr><td colspan="4" class="empty">No recorded activity yet.</td></tr>{{/each}}</tbody></table></div><a class="small" href="/admin/audit">View activity log →</a></section>{{> adminBottom}}

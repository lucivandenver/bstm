{{> adminTop}}
<form action="/admin/users" method="get" class="filters"><input class="search-input" name="q" value="{{q}}" placeholder="Search name, email or ID" aria-label="Search users"><select class="search-input" name="role" aria-label="Role"><option value="">All roles</option><option {{selected role 'student'}}>student</option><option {{selected role 'faculty'}}>faculty</option><option {{selected role 'admin'}}>admin</option><option {{selected role 'staff'}}>staff</option></select><select class="search-input" name="approval" aria-label="Approval status"><option value="">All approval states</option><option {{selected approval 'pending'}}>pending</option><option {{selected approval 'approved'}}>approved</option><option {{selected approval 'rejected'}}>rejected</option></select><button class="button">Search</button></form>
<section class="card"><div class="row"><h2>{{count}} matching accounts</h2></div><div class="table-wrap"><table><thead><tr><th>Name / email</th><th>Role / ID</th><th>Status</th><th>Approval</th><th>Actions</th></tr></thead><tbody>{{#each users}}<tr><td><strong>{{name}}</strong><br>{{email}}{{#if owner}}<br><span class="chip">System owner</span>{{/if}}</td><td>{{role}}<br>{{studentId}}{{facultyId}}</td><td>{{#if active}}Active{{else}}Inactive{{/if}}</td><td>{{approvalStatus}}</td><td><div class="actions"><a class="button secondary compact" href="/admin/users/{{id}}">Details / edit</a>}</div></td></tr>{{else}}<tr><td colspan="5" class="empty">No matching accounts.</td></tr>{{/each}}</tbody></table></div><nav class="pagination" aria-label="Accounts pagination">{{#if previous}}<a href="{{previous}}">← Previous</a>{{/if}}<span class="small muted">Page {{page}}</span>{{#if next}}<a href="{{next}}">Next →</a>{{/if}}</nav></section>
<details class="card space-top"><summary>Create an account</summary><p class="small muted space-top">Create student or faculty accounts. Faculty accounts are activated on creation and are not assigned to student sections.</p><form method="post" action="/admin/users"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="inline-fields"><div class="field"><label>Full name<input name="name" required maxlength="100"></label></div><div class="field"><label>Email<input name="email" type="email" required></label></div><div class="field"><label>Role<select name="role"><option value="student">Student</option><option value="faculty">Faculty</option></select></label></div><div class="field student-account-field"><label>Student ID<input name="studentId" maxlength="40"></label></div><div class="field student-account-field"><label>Section<select name="section"><option value="">Select active section</option>{{#each sections}}<option>{{name}}</option>{{/each}}</select></label></div><div class="field student-account-field"><label>Student gender<select name="gender"><option value="">Select</option><option>Female</option><option>Male</option></select></label></div><div class="field faculty-account-field" hidden><label>Faculty ID<input name="facultyId" maxlength="40" disabled></label></div><div class="field faculty-account-field" hidden><label>Position<input name="facultyPosition" maxlength="120" disabled></label></div><div class="field faculty-account-field" hidden><label>Degree<input name="facultyEducation" maxlength="200" disabled></label></div><div class="field"><label>Initial password<input name="password" type="password" minlength="14" maxlength="72" required autocomplete="new-password"></label></div></div><button class="button space-top">Create account</button></form></details>{{> adminBottom}}

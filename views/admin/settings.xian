{{> adminTop}}<div class="grid cols-2"><section class="card"><h2>Institutional certificate setup</h2><form method="post" action="/admin/settings" data-signature-form><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Institution name<input name="institutionName" value="{{portalSettings.institutionName}}" required maxlength="160"></label></div><div class="field space-top"><label>Academic year<input name="academicYear" value="{{portalSettings.academicYear}}" required pattern="[0-9]{4}-[0-9]{4}"></label></div><input type="hidden" name="certificateTemplate" value="classic"><div class="field space-top"><label>Certificate footer<textarea name="certificateFooter" rows="3" maxlength="250">{{portalSettings.certificateFooter}}</textarea></label></div><div class="field"><label>Administrator signatory name<input name="certificateSignatory" maxlength="160" value="{{portalSettings.certificateSignatory}}"></label></div><div class="field"><label>Administrator position<input name="certificateSignatoryPosition" maxlength="160" value="{{portalSettings.certificateSignatoryPosition}}" placeholder="e.g. Campus Administrator"></label></div><div class="field space-top"><label>Administrator signature image<input type="file" accept="image/png,image/jpeg,image/webp" data-signature-file></label><p class="small muted" role="status" aria-live="polite" data-signature-status></p><input type="hidden" name="adminSignature" value="{{portalSettings.adminSignature}}" data-signature-value><small>Upload dark ink on a plain light background. Preview the transparent PNG before saving.</small><img alt="Processed administrator signature" src="{{portalSettings.adminSignature}}" data-signature-preview {{#unless portalSettings.adminSignature}}hidden{{/unless}} style="max-width:320px;max-height:120px;background:#f5f5f5"></div><label class="checkbox"><input type="checkbox" name="registrationEnabled" value="true" {{#if (eq portalSettings.registrationEnabled 'true')}}checked{{/if}}>Allow new registrations</label><label class="checkbox"><input type="checkbox" name="facultyRegistrationEnabled" value="true" {{#if (eq portalSettings.facultyRegistrationEnabled 'true')}}checked{{/if}}>Allow faculty registration requests</label><button class="button space-top">Save institutional settings</button></form></section><section class="card"><h2>Platform tools</h2><div class="grid"><a class="button secondary" href="/admin/audit">Search system logs</a><a class="button secondary" href="/admin/users">Manage student accounts</a><a class="button secondary" href="/admin/sections">Manage sections</a><a class="button secondary" href="/admin/courses">Course oversight</a><a class="button secondary" href="/admin/academic">Academic corrections</a><a class="button secondary" href="/admin/competencies">Competency framework</a><a class="button secondary" href="/admin/careers">Career pathways</a><a class="button secondary" href="/admin/announcements">Announcements</a><a class="button secondary" href="/admin/reports">Learning reports</a><a class="button secondary" href="/admin/ai">AI operations</a><a class="button secondary" href="/admin/maintenance">Maintenance</a></div><div class="divider"></div><h2>Integration status</h2><dl class="key-value"><dt>Google OAuth</dt><dd>{{#if googleConfigured}}Configured{{else}}Not configured{{/if}}</dd><dt>Gemini</dt><dd>{{#if aiConfigured}}Key configured{{else}}Not configured{{/if}}</dd></dl><p class="small muted">Secrets are managed in Render environment settings.</p></section></div><script src="/js/signature.js" defer></script>{{> adminBottom}}

{{> adminTop}}<div class="grid cols-2"><section class="card"><h2>Academic & portal settings</h2><form method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>Institution name<input name="institutionName" value="{{portalSettings.institutionName}}" required maxlength="160"></label></div><div class="field space-top"><label>Academic year<input name="academicYear" value="{{portalSettings.academicYear}}" required pattern="[0-9]{4}-[0-9]{4}"></label></div><div class="field space-top"><label>Certificate footer<textarea name="certificateFooter" rows="3" maxlength="250">{{portalSettings.certificateFooter}}</textarea></label><small>Future PDF downloads use this wording. Do not imply external accreditation.</small></div><label class="checkbox"><input type="checkbox" name="registrationEnabled" value="true" {{#if (eq portalSettings.registrationEnabled 'true')}}checked{{/if}}>Allow new registrations</label><label class="checkbox"><input type="checkbox" name="facultyRegistrationEnabled" value="true" {{#if (eq portalSettings.facultyRegistrationEnabled 'true')}}checked{{/if}}>Allow faculty registration requests</label><button class="button">Save settings</button></form></section><section class="card"><h2>Integration status</h2><dl class="key-value"><dt>Google OAuth</dt><dd>{{#if googleConfigured}}Configured{{else}}Not configured{{/if}}</dd><dt>Gemini</dt><dd>{{#if aiConfigured}}Key configured{{else}}Not configured{{/if}}</dd></dl><p class="small muted space-top">Secrets are managed in Render environment portalSettings. This screen never displays or edits API keys, database passwords or OAuth secrets.</p><div class="divider"></div><h2>Deployment and data</h2><p class="small muted">Review changes through feature branches and PRs. Keep database backups in your database provider. This portal does not expose database dumps, execute shell commands or run migrations through the browser.</p></section></div>{{> adminBottom}}

{{> adminTop}}<p class="muted">Students request official ID or section corrections here. Approvals update academic records and notify the student.</p><section class="card"><div class="table-wrap"><table><thead><tr><th>Student</th><th>Current record</th><th>Requested record</th><th>Reason</th><th>Review</th></tr></thead><tbody>{{#each corrections}}<tr><td>{{User.name}}</td><td>{{User.studentId}}<small>{{User.section}}</small></td><td>{{studentId}}<small>{{section}}</small></td><td>{{reason}}</td><td>{{#if pending}}<form method="post" action="/admin/academic/{{id}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="actions"><button class="button" name="status" value="approved">Approve</button><button class="button secondary" name="status" value="rejected">Reject</button></div></form>{{else}}<span class="chip">{{status}}</span>{{/if}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No academic correction requests.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

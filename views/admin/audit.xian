{{> adminTop}}<p class="muted">Search recorded reviewer actions by user, action or date. Passwords and tokens are excluded.</p><form method="get" class="filters"><label class="field">Actor user ID<input name="actor" value="{{actor}}" inputmode="numeric"></label><label class="field">Action<input name="q" value="{{q}}" placeholder="faculty.approved"></label><label class="field">From<input type="date" name="from" value="{{from}}"></label><label class="field">To<input type="date" name="to" value="{{to}}"></label><button class="button">Search logs</button></form><section class="card"><div class="table-wrap"><table><thead><tr><th>Date</th><th>Actor ID</th><th>Action</th><th>Target</th><th>Details</th></tr></thead><tbody>{{#each logs}}<tr><td>{{date}}</td><td>{{actorId}}</td><td>{{action}}</td><td>{{targetType}} #{{targetId}}</td><td>{{detail}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No matching activity.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

{{> adminTop}}<p class="muted">Latest 200 activity records. Passwords, tokens, client secrets and complete user profiles are excluded.</p><section class="card"><div class="table-wrap"><table><thead><tr><th>Date</th><th>Actor ID</th><th>Action</th><th>Target</th><th>Details</th></tr></thead><tbody>{{#each logs}}<tr><td>{{date}}</td><td>{{actorId}}</td><td>{{action}}</td><td>{{targetType}} #{{targetId}}</td><td>{{detail}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No recorded activity.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

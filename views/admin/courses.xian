{{> adminTop}}<nav class="actions" aria-label="Course review filters"><a class="button {{#if pendingOnly}}secondary{{/if}}" href="/admin/courses">All courses</a><a class="button {{#unless pendingOnly}}secondary{{/unless}}" href="/admin/courses?status=pending">Pending publication ({{pendingCount}})</a></nav><div class="notice info">Faculty own the courses they create. Review submitted modules here before publishing them in the student catalog.</div><div class="stack">{{#each courses}}<details id="course-{{id}}" class="card editor-card" {{#if pendingReview}}open{{/if}}><summary>{{title}} · {{#if published}}Published{{else}}{{#if pendingReview}}Pending review{{else}}Unpublished{{/if}}{{/if}}</summary><p class="small muted space-top">{{moduleCount}} modules{{#if starter}} · Starter content requiring faculty validation{{/if}}</p>{{#if pendingReview}}
{{#if certificateEnabled}}<p><a href="/admin/credential-approvals">Review certificate configuration before publishing</a></p>{{/if}}<h3>Submitted modules</h3>
{{#each modules}}<details><summary>{{title}}</summary>{{#each lessons}}<h4>{{title}}</h4><p>{{body}}</p>{{/each}}</details>{{/each}}
<h3>Assessment questions</h3>
<ol>{{#each questions}}<li>{{prompt}}<ul>{{#each options}}<li>{{this}}</li>{{/each}}</ul></li>{{/each}}</ol>
<form method="post" action="/admin/courses/{{id}}/approve-publication">
<input type="hidden" name="_csrf" value="{{../csrf}}"><input type="hidden" name="version" value="{{version}}">
<button class="button">Approve &amp; publish</button>
</form>
{{/if}}{{#unless pendingReview}}<form method="post" action="/admin/courses/{{id}}"><input type="hidden" name="version" value="{{version}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="grid cols-2"><div class="field"><label>Title<input name="title" value="{{title}}" required maxlength="160"></label></div><div class="field"><label>Competency area<select name="domain">{{#each ../domains}}<option {{selected this ../domain}}>{{this}}</option>{{/each}}</select></label></div><div class="field"><label>Passing score<input name="passingScore" type="number" min="50" max="100" value="{{passingScore}}" required></label></div><div class="field"><label>Description<textarea name="description" rows="3" maxlength="2000">{{description}}</textarea></label></div></div>{{#if published}}<button class="button secondary" name="unpublish" value="yes">Unpublish</button>{{/if}}<button class="button">Save settings</button></form>{{/unless}}</details>{{else}}<div class="card empty">{{#if pendingOnly}}No courses are pending publication.{{else}}No courses yet.{{/if}}</div>{{/each}}</div>{{> adminBottom}}

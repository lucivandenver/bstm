{{> adminTop}}<div class="notice info">Changing course settings creates a new version for future enrollments. Existing attempts retain their original snapshot. Assign a faculty owner below; that faculty can author lessons, upload sources and review questions in their workspace.</div><div class="stack">{{#each courses}}<details class="card editor-card"><summary>{{title}} · {{#if published}}Published{{else}}{{#if pendingReview}}Pending review{{else}}Unpublished{{/if}}{{/if}} · v{{version}}</summary><p class="small muted space-top">{{moduleCount}} modules{{#if starter}} · Starter content requiring faculty validation{{/if}}</p>{{#if pendingReview}}
{{#if certificateEnabled}}<p><a href="/admin/credential-approvals">Review certificate configuration</a></p>{{/if}}<h3>Submitted modules</h3>
{{#each modules}}<details><summary>{{title}}</summary>{{#each lessons}}<h4>{{title}}</h4><p>{{body}}</p>{{/each}}</details>{{/each}}
<h3>Assessment questions</h3>
<ol>{{#each questions}}<li>{{prompt}}<ul>{{#each options}}<li>{{this}}</li>{{/each}}</ul></li>{{/each}}</ol>
<form method="post" action="/admin/courses/{{id}}/approve-publication">
<input type="hidden" name="_csrf" value="{{../csrf}}"><input type="hidden" name="version" value="{{version}}">
<button class="button">Approve &amp; publish</button>
</form>
{{/if}}<form method="post" action="/admin/courses/{{id}}"><input type="hidden" name="version" value="{{version}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="grid cols-2"><div class="field"><label>Title<input name="title" value="{{title}}" required maxlength="160"></label></div><div class="field"><label>Competency area<select name="domain">{{#each ../domains}}<option {{selected this ../domain}}>{{this}}</option>{{/each}}</select></label></div><div class="field"><label>Passing score<input name="passingScore" type="number" min="50" max="100" value="{{passingScore}}" required></label></div><div class="field"><label>Description<textarea name="description" rows="3" maxlength="2000">{{description}}</textarea></label></div></div><label class="checkbox"><input type="checkbox" name="published" value="true" {{#if published}}checked{{/if}}>Published in student catalog</label><button class="button">Save new version</button></form></details>{{else}}<div class="card empty">No courses yet. Run the optional starter seed or ask an approved faculty member to create a course.</div>{{/each}}</div><section class="card space-top"><h2>Faculty ownership & publication history</h2>{{#each courses}}<form method="post" action="/admin/courses/{{id}}/ownership" class="assignment-item"><input type="hidden" name="_csrf" value="{{../csrf}}"><div><strong>{{title}}</strong><small>Current faculty owner ID: {{ownerId}}</small><a class="text-link small" href="/admin/courses/{{id}}/history">View version history →</a></div><div class="actions"><label class="field">Faculty owner<select name="ownerId" required><option value="">Select faculty</option>{{#each ../faculty}}<option value="{{id}}" {{selected id ../ownerId}}>{{name}}</option>{{/each}}</select></label><button class="button secondary">Assign owner</button></div></form>{{/each}}</section>{{> adminBottom}}

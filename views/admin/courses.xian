{{> adminTop}}<div class="notice info">Changing course settings creates a new version for future enrollments. Existing attempts retain their original snapshot. This screen oversees existing courses; full faculty course authoring/upload is separate work.</div><div class="stack">{{#each courses}}<details class="card editor-card"><summary>{{title}} · {{#if published}}Published{{else}}Archived{{/if}} · v{{version}}</summary><p class="small muted space-top">{{moduleCount}} modules{{#if starter}} · Starter content requiring faculty validation{{/if}}</p><form method="post" action="/admin/courses/{{id}}"><input type="hidden" name="_csrf" value="{{../csrf}}"><div class="grid cols-2"><div class="field"><label>Title<input name="title" value="{{title}}" required maxlength="160"></label></div><div class="field"><label>Competency area<select name="domain">{{#each ../domains}}<option {{selected this ../domain}}>{{this}}</option>{{/each}}</select></label></div><div class="field"><label>Passing score<input name="passingScore" type="number" min="50" max="100" value="{{passingScore}}" required></label></div><div class="field"><label>Description<textarea name="description" rows="3" maxlength="2000">{{description}}</textarea></label></div></div><label class="checkbox"><input type="checkbox" name="published" value="true" {{#if published}}checked{{/if}}>Published in student catalog</label><button class="button">Save new version</button></form></details>{{else}}<div class="card empty">No courses yet. Run the optional starter seed or add courses through a future faculty builder.</div>{{/each}}</div>{{> adminBottom}}

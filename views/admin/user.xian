{{> adminTop}}<p><a href="/admin/users">← All users</a></p><div class="grid cols-2"><section class="card"><h2>{{account.name}}</h2><p class="small muted">{{account.email}} · Account #{{account.id}}</p>{{#if account.owner}}<div class="notice">System owner · protected from deactivation and demotion.</div>{{/if}}<form action="/admin/users/{{account.id}}" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="grid cols-2"><div class="field"><label>Full name<input name="name" value="{{account.name}}" required maxlength="100"></label></div><div class="field"><label>Role<select name="role"><option {{selected account.role 'student'}}>student</option><option {{selected account.role 'faculty'}}>faculty</option>{{#if canManageAdmins}}<option {{selected account.role 'admin'}}>admin</option>{{else}}{{#if (eq account.role 'admin')}}<option selected>admin</option>{{/if}}{{/if}}</select></label></div><div class="field"><label>Student ID<input name="studentId" value="{{account.studentId}}" maxlength="40"></label></div><div class="field"><label>Faculty ID<input name="facultyId" value="{{account.facultyId}}" maxlength="40"></label></div><div class="field"><label>Student section<select name="section"><option value="">None</option>{{#each sections}}<option {{selected name ../account.section}}>{{name}}</option>{{/each}}</select></label></div><div class="field"><label>Student gender<select name="gender"><option value="">None</option>{{#each genders}}<option {{selected this ../account.gender}}>{{this}}</option>{{/each}}</select></label></div><div class="field"><label>Faculty approval<select name="approvalStatus"><option {{selected account.approvalStatus 'approved'}}>approved</option><option {{selected account.approvalStatus 'pending'}}>pending</option><option {{selected account.approvalStatus 'rejected'}}>rejected</option></select></label></div><div class="field"><label>Account status<select name="active"><option value="true" {{#if account.active}}selected{{/if}}>Active</option><option value="false" {{#unless account.active}}selected{{/unless}}>Inactive</option></select></label></div></div><p class="small muted space-top">Role changes preserve historical learning records. Email and linked Google identity cannot be changed through this form.</p><button class="button">Save account</button></form></section><section class="card"><h2>Account background</h2><dl class="key-value"><dt>Google connection</dt><dd>{{#if account.googleConnected}}Connected{{else}}Not connected{{/if}}</dd><dt>Profile complete</dt><dd>{{#if profile.complete}}Yes{{else}}Not completed{{/if}}</dd><dt>OJT status</dt><dd>{{profile.ojtStatus}}</dd><dt>OJT company</dt><dd>{{profile.ojtCompany}}</dd><dt>Career interest</dt><dd>{{profile.careerInterest}}</dd></dl>{{#unless isSelf}}<div class="divider"></div><h2>Reset account password</h2><p class="small muted">Invalidates previous sessions. Share the new password privately.</p><form method="post" action="/admin/users/{{account.id}}/password"><input type="hidden" name="_csrf" value="{{csrf}}"><div class="field"><label>New password<input type="password" name="newPassword" required minlength="14" maxlength="72" autocomplete="new-password"></label></div><button class="button secondary space-top">Reset password</button></form>{{/unless}}</section></div><section class="card space-top"><h2>Learning history</h2><div class="table-wrap"><table><thead><tr><th>Course</th><th>Attempt</th><th>Status</th><th>Final score</th><th>Started</th></tr></thead><tbody>{{#each attempts}}<tr><td>{{title}}</td><td>{{attempt}}</td><td>{{status}}</td><td>{{score}}</td><td>{{date}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No learning records.</td></tr>{{/each}}</tbody></table></div></section>{{> adminBottom}}

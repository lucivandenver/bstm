<details class="account-dropdown" data-account-menu><summary aria-label="Open account menu for {{currentUser.name}}"><span class="avatar">{{#if currentUser.googlePicture}}<img src="{{currentUser.googlePicture}}" alt="">{{else}}{{currentUser.avatarInitials}}{{/if}}</span><span class="account-menu-name">{{currentUser.name}}</span><span class="account-chevron" aria-hidden="true">{{> icon name="chevron"}}</span></summary><div class="account-dropdown-panel"><p class="account-menu-heading">{{currentUser.name}}<small>{{roleLabel}}</small></p><a href="{{profileUrl}}">{{> icon name="user"}}My profile</a>{{#if settingsUrl}}<a href="{{settingsUrl}}">{{> icon name="settings"}}System settings</a>{{/if}}<a href="/notifications">{{> icon name="bell"}}Notifications</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="{{csrf}}"><button type="submit">{{> icon name="logout"}}Log out</button></form></div></details>

<form action="/register" method="POST" class="space-y-4" data-registration-form>
<input type="hidden" name="_csrf" value="{{csrf}}">
<div><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}account_type">Register as</label><select id="{{prefix}}account_type" name="account_type" class="w-full px-4 py-2.5 border border-gray-300 bg-white text-sm" data-account-type {{#if pendingGoogle}}disabled{{/if}}><option value="student" {{selected registrationRole 'student'}}>Student</option><option value="faculty" {{selected registrationRole 'faculty'}}>Faculty</option></select>{{#if pendingGoogle}}<input type="hidden" name="account_type" value="{{registrationRole}}"><p class="text-xs text-gray-500 mt-2">Google account verified. Complete the remaining fields to register.</p>{{/if}}</div>
<div><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}name">Full name</label><input id="{{prefix}}name" name="name" value="{{registrationName}}" required minlength="2" maxlength="100" autocomplete="name" placeholder="Juan Dela Cruz" class="w-full px-4 py-2.5 border border-gray-300 text-sm"></div>
<div><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}identityId" data-id-label>{{#if isFaculty}}Faculty ID{{else}}Student ID{{/if}}</label><input id="{{prefix}}identityId" name="identityId" required pattern="[A-Za-z0-9_-]{3,40}" maxlength="40" placeholder="Institutional ID" class="w-full px-4 py-2.5 border border-gray-300 text-sm"></div>
<div data-student-only {{#if isFaculty}}hidden{{/if}}><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}section">Section</label><select id="{{prefix}}section" name="section" class="w-full px-4 py-2.5 border border-gray-300 bg-white text-sm" {{#unless isFaculty}}required{{else}}disabled{{/unless}}><option value="">Select section</option>{{#each sections}}<option value="{{name}}">{{name}}</option>{{/each}}</select></div>
<div data-student-only {{#if isFaculty}}hidden{{/if}}><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}gender">Gender</label><select id="{{prefix}}gender" name="gender" class="w-full px-4 py-2.5 border border-gray-300 bg-white text-sm" {{#unless isFaculty}}required{{else}}disabled{{/unless}}><option value="">Select gender</option><option>Female</option><option>Male</option><option>Other</option><option>Prefer not to say</option></select></div>
<div><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}email">Email address</label><input type="email" id="{{prefix}}email" name="email" value="{{registrationEmail}}" {{#if pendingGoogle}}readonly{{/if}} required maxlength="254" autocomplete="email" placeholder="you@example.com" class="w-full px-4 py-2.5 border border-gray-300 text-sm"></div>
{{#unless pendingGoogle}}<div><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}password">Password</label><div class="relative"><input type="password" id="{{prefix}}password" name="password" required minlength="10" maxlength="72" autocomplete="new-password" class="w-full pl-4 pr-14 py-2.5 border border-gray-300 text-sm"><button type="button" data-toggle-password class="absolute right-3 top-3 text-xs text-gray-500" aria-label="Show password">Show</button></div></div><div><label class="block text-sm font-semibold text-slate-700 mb-1" for="{{prefix}}confirm_password">Confirm password</label><input type="password" id="{{prefix}}confirm_password" name="confirm_password" required minlength="10" maxlength="72" autocomplete="new-password" class="w-full px-4 py-2.5 border border-gray-300 text-sm"></div>{{/unless}}
<p class="text-xs text-gray-500" data-faculty-note {{#unless isFaculty}}hidden{{/unless}}>Faculty registrations require administrator approval before sign-in.</p>
<button type="submit" class="w-full py-3.5 bg-[#007042] hover:bg-[#005a35] text-white font-bold text-sm">Create account</button>
</form>

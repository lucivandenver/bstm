<!DOCTYPE html>\n<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/student-features.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script></head>\n<body>\n<a class="sr-only" href="#main">Skip to content</a>\n<aside class="app-sidebar" id="sidebar" aria-label="Student navigation"><button class="mobile-close" id="close-menu" aria-label="Close navigation">×</button><a class="brand" href="/student"><img class="sidebar-brand-logo" src="/images/careerbridge_brand_logo.png" alt="CareerBridge" width="196" height="92"></a><p class="portal-label">STUDENT LEARNING PORTAL</p>\n<nav class="side-nav" aria-label="Main navigation">\n<a href="/student" class="{{#if (eq nav 'dashboard')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">▦</span>Dashboard</a>\n<a href="/student/courses" class="{{#if (eq nav 'catalog')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">▤</span>Explore Courses</a>\n<a href="/student/learning" class="{{#if (eq nav 'learning')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">▷</span>My Learning</a>\n<a href="/student/careers" class="{{#if (eq nav 'careers')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">↗</span>Find My Career</a>\n<a href="/student/achievements" class="{{#if (eq nav 'achievements')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">☆</span>My Achievements</a>\n<div class="nav-label">ACCOUNT</div>\n<a href="/student/profile" class="{{#if (eq nav 'profile')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">◎</span>My Profile</a>\n<a href="/notifications" class="{{#if (eq nav 'notifications')}}active{{/if}}"><span class="nav-icon" aria-hidden="true">♧</span>Notifications</a>\n</nav></aside>\n<div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">☰</button><div class="breadcrumb">STUDENT / WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu">{{> notificationBell}}<span class="avatar" aria-hidden="true">S</span><div class="user-copy"><strong>{{currentUser.name}}</strong><small>Student account</small></div><form action="/logout" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="logout" type="submit">Log out</button></form></div></header>\n<main id="main" class="page">{{> messages}}{{> announcements}}\n
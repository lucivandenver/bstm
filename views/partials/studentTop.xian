<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/student-features.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#007042"><script src="/js/pwa.js" defer></script><link rel="icon" type="image/svg+xml" href="/images/icons/airplane.svg?v=3"></head>
<body>
<a class="sr-only" href="#main">Skip to content</a>
<aside class="app-sidebar" id="sidebar" aria-label="Student navigation"><button class="mobile-close" id="close-menu" aria-label="Close navigation">{{> icon name="close"}}</button><a class="brand" href="/student"><img class="sidebar-brand-logo" src="/images/careerbridge_brand_logo.png" alt="CareerBridge" width="196" height="92"></a><p class="portal-label">STUDENT LEARNING PORTAL</p>
<nav class="side-nav" aria-label="Main navigation">
<a href="/student" class="{{#if (eq nav 'dashboard')}}active{{/if}}"><span class="nav-icon">{{> icon name="dashboard"}}</span>Dashboard</a>
<a href="/student/courses" class="{{#if (eq nav 'catalog')}}active{{/if}}"><span class="nav-icon">{{> icon name="book"}}</span>Explore Courses</a>
<a href="/student/learning" class="{{#if (eq nav 'learning')}}active{{/if}}"><span class="nav-icon">{{> icon name="play"}}</span>My Learning</a>
<a href="/student/careers" class="{{#if (eq nav 'careers')}}active{{/if}}"><span class="nav-icon">{{> icon name="search"}}</span>Find My Career</a>
<a href="/student/achievements" class="{{#if (eq nav 'achievements')}}active{{/if}}"><span class="nav-icon">{{> icon name="award"}}</span>My Achievements</a>
<div class="nav-label">ACCOUNT</div>
<a href="/student/profile" class="{{#if (eq nav 'profile')}}active{{/if}}"><span class="nav-icon">{{> icon name="user"}}</span>My Profile</a>
<a href="/notifications" class="{{#if (eq nav 'notifications')}}active{{/if}}"><span class="nav-icon">{{> icon name="bell"}}</span>Notifications</a>
</nav></aside>
<div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">{{> icon name="menu"}}</button><div class="breadcrumb">STUDENT / WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu">{{> notificationBell}}{{> accountMenu profileUrl="/student/profile" roleLabel="Student account"}}</div></header>
<main id="main" class="page">{{> messages}}{{> announcements}}

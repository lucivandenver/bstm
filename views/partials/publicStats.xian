<div class="cb-stats" aria-label="Current platform totals"><div class="cb-stat"><span class="cb-stat-icon">{{> publicIcon name="students"}}</span><div><strong>{{stats.students}}</strong><span>Registered students</span></div></div><div class="cb-stat"><span class="cb-stat-icon">{{> publicIcon name="faculty"}}</span><div><strong>{{stats.faculty}}</strong><span>Active faculty</span></div></div><div class="cb-stat"><span class="cb-stat-icon">{{> publicIcon name="book"}}</span><div><strong>{{stats.courses}}</strong><span>Published courses</span></div></div><div class="cb-stat"><span class="cb-stat-icon">{{> publicIcon name="match"}}</span><div><strong>{{stats.pathways}}</strong><span>Active career pathways</span></div></div><div class="cb-stat"><span class="cb-stat-icon">{{> publicIcon name="award"}}</span><div><strong>{{stats.completions}}</strong><span>Completed course attempts</span></div></div></div><p class="cb-data-note">Current platform totals · Counts update as records are added.</p>

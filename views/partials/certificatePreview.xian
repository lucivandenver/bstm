<article class="faculty-certificate-preview" style="border:6px double #007042;padding:clamp(20px,4vw,48px);text-align:center;background:linear-gradient(145deg,#eef7f1,#fff 30%,#fff 70%,#f8f1e3)"><div class="faculty-certificate-logos" aria-label="MinSU, College of Business and Management, and Council of Tourism Students logos" style="display:flex;align-items:center;justify-content:center;gap:24px;margin:0 auto 8px"><img src="/images/certificates/minsu-seal.png" alt="MinSU seal" width="58" height="58" style="object-fit:contain"><img src="/images/certificates/cbm-logo.png" alt="College of Business and Management logo" width="58" height="58" style="object-fit:contain"><img src="/images/certificates/cts-logo.png" alt="Council of Tourism Students logo" width="58" height="58" style="object-fit:contain"></div><p>{{#if institution}}{{institution}}{{else}}MinSU Bongabong Campus{{/if}}</p><h2>Certificate of Completion</h2><p class="eyebrow">Presented to</p><h2>Sample Student Name</h2><p>For successfully completing</p><h2>{{title}}</h2><div class="grid cols-2"><div><img alt="Faculty signature preview" src="{{signature}}" data-course-signature-preview {{#unless signature}}hidden{{/unless}} style="max-width:160px;max-height:60px"><p>{{name}}</p><p class="small muted">{{position}}</p></div></div></article>

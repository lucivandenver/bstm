<article class="faculty-certificate-preview" style="border:3px solid #007042;padding:24px;text-align:center;background:#fff"><div class="faculty-certificate-logos" aria-label="MinSU, College of Business and Management, and Council of Tourism Students logos" style="display:flex;align-items:center;justify-content:center;gap:24px;margin:0 auto 8px"><img src="/images/certificates/minsu-seal.png" alt="MinSU seal" width="58" height="58" style="object-fit:contain"><img src="/images/certificates/cbm-logo.png" alt="College of Business and Management logo" width="58" height="58" style="object-fit:contain"><img src="/images/certificates/cts-logo.png" alt="Council of Tourism Students logo" width="58" height="58" style="object-fit:contain"></div><p>{{institution}}</p><h2>Certificate of Completion</h2><p>Sample Student Name</p><h2>{{title}}</h2><div class="grid cols-2"><div><img alt="Faculty signature preview" src="{{signature}}" data-course-signature-preview {{#unless signature}}hidden{{/unless}} style="max-width:160px;max-height:60px"><p>{{name}}</p><p class="small muted">{{position}}</p></div></div></article>

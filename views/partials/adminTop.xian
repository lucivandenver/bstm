<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}} · CareerBridge Admin</title><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/admin.css"><script src="/js/student.js" defer></script></head><body>
<aside class="app-sidebar" id="sidebar"><button class="mobile-close" id="close-menu" aria-label="Close navigation">×</button><a class="brand" href="/admin"><span class="brand-mark">↗</span>CareerBridge</a><p class="portal-label">ADMINISTRATION</p><nav class="side-nav">
<a href="/admin" class="{{#if (eq adminNav 'dashboard')}}active{{/if}}">▦ Overview</a><a href="/admin/users" class="{{#if (eq adminNav 'users')}}active{{/if}}">◎ Users & approvals</a><a href="/admin/sections" class="{{#if (eq adminNav 'sections')}}active{{/if}}">▤ Sections & assignments</a><a href="/admin/courses" class="{{#if (eq adminNav 'courses')}}active{{/if}}">▷ Course oversight</a><a href="/admin/careers" class="{{#if (eq adminNav 'careers')}}active{{/if}}">↗ Career pathway rules</a><a href="/admin/credentials" class="{{#if (eq adminNav 'credentials')}}active{{/if}}">☆ Certificates & badges</a><a href="/admin/announcements" class="{{#if (eq adminNav 'announcements')}}active{{/if}}">♧ Announcements</a><a href="/admin/reports" class="{{#if (eq adminNav 'reports')}}active{{/if}}">▥ Learning reports</a><a href="/admin/audit" class="{{#if (eq adminNav 'audit')}}active{{/if}}">☷ Activity log</a><a href="/admin/settings" class="{{#if (eq adminNav 'settings')}}active{{/if}}">⚙ System settings</a><a href="/admin/account" class="{{#if (eq adminNav 'account')}}active{{/if}}">◉ My account</a></nav><div class="sidebar-bottom"><small>BSTM · System administration</small><a href="/">View public website →</a></div></aside>
<div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">☰</button><div class="breadcrumb">ADMIN WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu"><span class="chip">Administrator</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="logout">Log out</button></form></div></header><main class="page"><div class="page-heading"><div><p class="eyebrow">BSTM CAREERBRIDGE</p><h1>{{title}}</h1></div></div>{{> messages}}

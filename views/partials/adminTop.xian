<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge Admin</title><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#007042"><script src="/js/pwa.js" defer></script><link rel="icon" type="image/svg+xml" href="/images/icons/airplane.svg"></head><body>
<aside class="app-sidebar" id="sidebar"><button class="mobile-close" id="close-menu" aria-label="Close navigation">{{> icon name="close"}}</button><a class="brand" href="/admin"><img class="sidebar-brand-logo" src="/images/careerbridge_brand_logo.png" alt="CareerBridge" width="196" height="92"></a><p class="portal-label">ADMINISTRATION</p><nav class="side-nav"><div class="nav-label">OVERVIEW</div><a href="/admin" class="{{#if (eq adminNav 'dashboard')}}active{{/if}}"><span class="nav-icon">{{> icon name="dashboard"}}</span>Dashboard</a><div class="nav-label">PEOPLE</div><a href="/admin/faculty" class="{{#if (eq adminNav 'faculty')}}active{{/if}}"><span class="nav-icon">{{> icon name="users"}}</span>Faculty Management</a><a href="/admin/users" class="{{#if (eq adminNav 'users')}}active{{/if}}"><span class="nav-icon">{{> icon name="user"}}</span>Accounts</a><a href="/admin/sections" class="{{#if (eq adminNav 'sections')}}active{{/if}}"><span class="nav-icon">{{> icon name="book"}}</span>Sections</a><div class="nav-label">CREDENTIALS</div><a href="/admin/credential-approvals" class="{{#if (eq adminNav 'credentialApprovals')}}active{{/if}}"><span class="nav-icon">{{> icon name="shield"}}</span>Credential Approvals</a><div class="nav-label">SYSTEM</div><a href="/admin/settings" class="{{#if (eq adminNav 'settings')}}active{{/if}}"><span class="nav-icon">{{> icon name="settings"}}</span>System Settings</a><a href="/admin/account"><span class="nav-icon">{{> icon name="user"}}</span>My Profile</a></nav></aside>
<div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">{{> icon name="menu"}}</button><div class="breadcrumb">ADMIN WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu">{{> notificationBell}}{{> accountMenu profileUrl="/admin/account" roleLabel="Admin account" settingsUrl="/admin/settings"}}</div></header><main class="page"><div class="page-heading"><div><p class="eyebrow">BSTM CAREERBRIDGE</p><h1>{{title}}</h1></div></div>{{> messages}}{{#if backUrl}}<a class="page-back" href="{{backUrl}}">← Back</a>{{/if}}

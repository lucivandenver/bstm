<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge Admin</title><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script></head><body>
<aside class="app-sidebar" id="sidebar"><button class="mobile-close" id="close-menu" aria-label="Close navigation">×</button><a class="brand" href="/admin"><img class="sidebar-brand-logo" src="/images/careerbridge_brand_logo.png" alt="CareerBridge" width="196" height="92"></a><p class="portal-label">ADMINISTRATION</p><nav class="side-nav"><div class="nav-label">ACCOUNTS</div><a href="/admin" class="{{#if (eq adminNav 'dashboard')}}active{{/if}}">▦ Overview</a><a href="/admin/users" class="{{#if (eq adminNav 'users')}}active{{/if}}">◎ Users & approvals</a><div class="nav-label">ACADEMIC OPERATIONS</div><a href="/admin/sections" class="{{#if (eq adminNav 'sections')}}active{{/if}}">▤ Sections & faculty</a><a href="/admin/academic" class="{{#if (eq adminNav 'academic')}}active{{/if}}">◇ Academic corrections</a><a href="/admin/courses" class="{{#if (eq adminNav 'courses')}}active{{/if}}">▷ Course oversight</a><a href="/admin/competencies" class="{{#if (eq adminNav 'competencies')}}active{{/if}}">◈ Competency framework</a><a href="/admin/careers" class="{{#if (eq adminNav 'careers')}}active{{/if}}">↗ Career pathways</a><a href="/admin/credentials" class="{{#if (eq adminNav 'credentials')}}active{{/if}}">☆ Certificates & badges</a><a href="/admin/announcements" class="{{#if (eq adminNav 'announcements')}}active{{/if}}">♧ Announcements</a><div class="nav-label">REPORTS & SYSTEM</div><a href="/admin/reports" class="{{#if (eq adminNav 'reports')}}active{{/if}}">▥ Learning reports</a><a href="/admin/audit" class="{{#if (eq adminNav 'audit')}}active{{/if}}">☷ Activity log</a><a href="/admin/ai" class="{{#if (eq adminNav 'ai')}}active{{/if}}">✦ AI operations</a><a href="/admin/settings" class="{{#if (eq adminNav 'settings')}}active{{/if}}">⚙ System settings</a><a href="/admin/maintenance" class="{{#if (eq adminNav 'maintenance')}}active{{/if}}">⚙ Maintenance</a><a href="/admin/account" class="{{#if (eq adminNav 'account')}}active{{/if}}">◉ My account</a></nav></aside>
<div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">☰</button><div class="breadcrumb">ADMIN WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu">{{> notificationBell}}<span class="chip">Administrator</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="logout">Log out</button></form></div></header><main class="page"><div class="page-heading"><div><p class="eyebrow">BSTM CAREERBRIDGE</p><h1>{{title}}</h1></div></div>{{> messages}}

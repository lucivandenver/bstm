<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge Admin</title><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script></head><body>
<aside class="app-sidebar" id="sidebar"><button class="mobile-close" id="close-menu" aria-label="Close navigation">×</button><a class="brand" href="/admin"><img class="sidebar-brand-logo" src="/images/careerbridge_brand_logo.png" alt="CareerBridge" width="196" height="92"></a><p class="portal-label">ADMINISTRATION</p><nav class="side-nav"><div class="nav-label">OVERVIEW</div><a href="/admin" class="{{#if (eq adminNav 'dashboard')}}active{{/if}}">Dashboard</a><div class="nav-label">PEOPLE</div><a href="/admin/faculty" class="{{#if (eq adminNav 'faculty')}}active{{/if}}">Faculty Management</a><div class="nav-label">CREDENTIALS</div><a href="/admin/credential-approvals" class="{{#if (eq adminNav 'credentialApprovals')}}active{{/if}}">Credential Approvals</a><div class="nav-label">SYSTEM</div><a href="/admin/settings" class="{{#if (eq adminNav 'settings')}}active{{/if}}">System Settings</a><a href="/admin/account">My Profile</a></nav></aside>
<div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">☰</button><div class="breadcrumb">ADMIN WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu">{{> notificationBell}}<span class="chip">Administrator</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="logout">Log out</button></form></div></header><main class="page"><div class="page-heading"><div><p class="eyebrow">BSTM CAREERBRIDGE</p><h1>{{title}}</h1></div></div>{{> messages}}

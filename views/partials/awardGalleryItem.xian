<article class="award-gallery-item">
<button type="button" class="award-gallery-card" data-open-award="{{dialogId}}" aria-label="View {{type}}: {{title}}"><span class="award-type">{{#if (eq type 'badge')}}Badge{{else}}Certificate{{/if}}</span><span class="award-art {{type}}">{{> achievementArt type=type}}</span><small>{{#if moduleTitle}}MODULE{{else}}COURSE{{/if}}</small><strong>{{title}}</strong><span class="award-date">Issued On: {{date}}</span></button>
<dialog id="{{dialogId}}" class="award-dialog award-detail" aria-labelledby="title-{{dialogId}}"><form method="dialog" class="award-close"><button type="submit" aria-label="Close achievement details">×</button></form><h2 id="title-{{dialogId}}">{{title}}</h2><div class="award-intro"><span class="award-art {{type}}">{{> achievementArt type=type}}</span><div><h3>{{courseTitle}}</h3><p>{{description}}</p></div></div>
<dl class="award-metadata"><div><dt>ISSUED DATE</dt><dd>{{date}}</dd></div><div><dt>ESTIMATED COURSE DURATION</dt><dd>{{#if minutes}}{{minutes}} minutes{{else}}Not specified{{/if}}</dd></div><div><dt>ACADEMY</dt><dd>{{academy}}</dd></div></dl>
<h3 class="award-section-label">SKILLS YOU LEARN</h3>{{#if (eq type 'badge')}}<ul class="award-completed-modules">{{#each modules}}<li>{{moduleTitle}}</li>{{else}}<li>No separate completed module records available.</li>{{/each}}</ul>{{else}}<ul>{{#each skills}}<li>{{this}}</li>{{else}}<li>{{title}}</li>{{/each}}</ul>{{/if}}
<footer class="award-detail-footer">{{#if (eq type 'badge')}}<a class="button" href="{{shareUrl}}" target="_blank" rel="noopener" data-share-badge="{{shareUrl}}">View &amp; Share Badge</a><p data-share-status role="status"></p>{{else}}<a class="button" data-download-certificate="/student/credentials/{{id}}/certificate" href="/student/credentials/{{id}}/certificate?view=1" target="_blank" rel="noopener">View &amp; Download</a>{{/if}}</footer></dialog></article>
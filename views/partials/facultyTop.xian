<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}} · CareerBridge</title><link rel="stylesheet" href="/css/student.css"><script src="/js/student.js" defer></script></head><body><aside class="app-sidebar" id="sidebar"><button class="mobile-close" id="close-menu" aria-label="Close navigation">×</button><a class="brand" href="/faculty"><span class="brand-mark">↗</span>CareerBridge</a><p class="portal-label">FACULTY WORKSPACE</p><nav class="side-nav"><a href="/faculty">▦ Assigned students</a><a href="/faculty/profile">◎ My profile</a></nav><div class="sidebar-bottom"><small>Faculty ID: {{currentUser.facultyId}}</small><a href="/">Public website →</a></div></aside><div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">☰</button><strong>{{title}}</strong></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="logout">Log out</button></form></header><main class="page">{{> messages}}{{> announcements}}

<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge</title><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script></head><body><a class="sr-only" href="#main">Skip to content</a><aside class="app-sidebar" id="sidebar" aria-label="Faculty navigation"><button class="mobile-close" id="close-menu" aria-label="Close navigation">×</button><a class="brand" href="/faculty"><span class="brand-mark">↗</span>CareerBridge</a><p class="portal-label">FACULTY WORKSPACE</p><nav class="side-nav"><div class="nav-label">OVERVIEW</div><a href="/faculty" class="{{#if (eq facultyNav 'dashboard')}}active{{/if}}">▦ Dashboard</a><a href="/faculty/students" class="{{#if (eq facultyNav 'students')}}active{{/if}}">◎ Students & sections</a><div class="nav-label">TEACH & ASSESS</div><a href="/faculty/courses" class="{{#if (eq facultyNav 'courses')}}active{{/if}}">▤ My courses</a><a href="/faculty/upload" class="{{#if (eq facultyNav 'upload')}}active{{/if}}">↑ Upload & generate</a><a href="/faculty/questions" class="{{#if (eq facultyNav 'bank')}}active{{/if}}">☑ Question bank</a><a href="/faculty/assignments" class="{{#if (eq facultyNav 'assignments')}}active{{/if}}">◇ Required learning</a><a href="/faculty/monitoring" class="{{#if (eq facultyNav 'monitoring')}}active{{/if}}">◷ Progress monitoring</a><a href="/faculty/evaluations" class="{{#if (eq facultyNav 'evaluations')}}active{{/if}}">✎ Practical evaluations</a><div class="nav-label">COMMUNICATE</div><a href="/faculty/reports" class="{{#if (eq facultyNav 'reports')}}active{{/if}}">▥ Reports</a><a href="/faculty/announcements" class="{{#if (eq facultyNav 'announcements')}}active{{/if}}">♧ Announcements</a><a href="/faculty/profile" class="{{#if (eq facultyNav 'profile')}}active{{/if}}">⚙ My profile</a></nav><div class="sidebar-bottom"><small>Faculty ID: {{currentUser.facultyId}}</small><a href="/">Public website →</a></div></aside><div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">☰</button><div class="breadcrumb">FACULTY / WORKSPACE<strong>{{title}}</strong></div></div><div class="user-menu">{{> notificationBell}}<span class="user-copy">{{currentUser.name}}</span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="logout">Log out</button></form></div></header><main class="page" id="main">{{> messages}}{{> announcements}}<div class="page-heading"><div><p class="eyebrow">TEACH WITH PURPOSE</p><h1>{{title}}</h1></div></div>

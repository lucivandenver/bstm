<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{csrf}}"><title>{{title}} · CareerBridge</title><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/student.css"><link rel="stylesheet" href="/css/portal.css"><script src="/js/student.js" defer></script><script src="/js/portal.js" defer></script><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#007042"><script src="/js/pwa.js" defer></script><link rel="icon" type="image/svg+xml" href="/images/icons/airplane.svg?v=3"></head><body><a class="sr-only" href="#main">Skip to content</a><aside class="app-sidebar" id="sidebar" aria-label="Faculty navigation"><button class="mobile-close" id="close-menu" aria-label="Close navigation">{{> icon name="close"}}</button><a class="brand" href="/faculty"><img class="sidebar-brand-logo" src="/images/careerbridge_brand_logo.png" alt="CareerBridge" width="196" height="92"></a><p class="portal-label">FACULTY WORKSPACE</p><nav class="side-nav"><div class="nav-label">OVERVIEW</div><a href="/faculty" class="{{#if (eq facultyNav 'dashboard')}}active{{/if}}"><span class="nav-icon">{{> icon name="dashboard"}}</span>Dashboard</a><div class="nav-label">COURSES</div><a href="/faculty/upload" class="{{#if (eq facultyNav 'upload')}}active{{/if}}"><span class="nav-icon">{{> icon name="upload"}}</span>Upload &amp; Generate</a><a href="/faculty/courses" class="{{#if (eq facultyNav 'courses')}}active{{/if}}"><span class="nav-icon">{{> icon name="book"}}</span>My Courses</a><div class="nav-label">LEARNERS &amp; CREDENTIALS</div><a href="/faculty/students" class="{{#if (eq facultyNav 'students')}}active{{/if}}{{#if (eq facultyNav 'monitoring')}}active{{/if}}{{#if (eq facultyNav 'evaluations')}}active{{/if}}"><span class="nav-icon">{{> icon name="users"}}</span>Student Progress</a><a href="/faculty/credentials" class="{{#if (eq facultyNav 'credentials')}}active{{/if}}"><span class="nav-icon">{{> icon name="shield"}}</span>Certificates &amp; Badges</a><a href="/faculty/profile"><span class="nav-icon">{{> icon name="user"}}</span>My Profile</a></nav></aside><div class="workspace"><header class="app-header"><div class="row"><button class="mobile-menu" id="open-menu" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">{{> icon name="menu"}}</button><div class="breadcrumb">FACULTY / WORKSPACE<h1 class="workspace-title">{{title}}</h1></div></div><div class="user-menu">{{> notificationBell}}{{> accountMenu profileUrl="/faculty/profile" roleLabel="Faculty account"}}</div></header><main class="page" id="main"{{#if (eq facultyNav 'dashboard')}} data-role-dashboard="faculty"{{/if}}>{{> messages}}{{> announcements}}{{#if backUrl}}<a class="page-back" href="{{backUrl}}">← Back</a>{{/if}}

<section class="card space-top learning-analytics" data-learning-analytics="{{endpoint}}" aria-labelledby="analytics-title">
  <header>
    <h2 id="analytics-title">Learning analytics</h2>
    <p class="muted small">Course publishing, module quiz activity and learner progress.</p>
  </header>
  <div class="dashboard-period-panel">
    <form class="dashboard-period-form" data-no-dirty>
      {{> dashboardPeriodFields period="week" calendarPresets=true}}
    </form>
    <p class="dashboard-period-status small muted" data-analytics-message role="status">Loading learning analytics…</p>
  </div>
  <noscript>Enable JavaScript to view learning analytics.</noscript>
  <div data-analytics-results hidden>
    <p class="small muted analytics-period-note">Activity counts use both dates. Progress shows recorded status through the end date, including earlier work.</p>
    <dl class="analytics-totals">
      <div><dt>Courses first published</dt><dd data-total="published"></dd></div>
      <div><dt>Learners started a course</dt><dd data-total="started"></dd></div>
      <div><dt>Module quiz submissions</dt><dd data-total="submitted"></dd></div>
      <div><dt>Attempts completed</dt><dd data-total="completed"></dd></div>
    </dl>
    <div class="analytics-charts">
      <section><h3>Activity over time</h3><div class="analytics-canvas"><canvas data-chart="trend" role="img" aria-label="Line chart of first publications, starts, quiz submissions and completions by date"></canvas></div></section>
      <section><h3>Learner progress by status</h3><div class="analytics-canvas"><canvas data-chart="progress" role="img" aria-label="Pie chart of learner progress by status"></canvas></div></section>
      <section><h3>Learner progress by course</h3><p class="small muted">Up to 8 courses with the most learners</p><div class="analytics-canvas"><canvas data-chart="courses" role="img" aria-label="Stacked bar chart of progress by course"></canvas></div></section>
      <section><h3>Course completion rates</h3><p class="small muted">Each dot shows a course’s learner count and completion rate</p><div class="analytics-canvas"><canvas data-chart="completion" role="img" aria-label="Scatter chart of course completion rate by learner count"></canvas></div></section>
    </div>
    <p class="small muted">Progress uses each learner’s latest attempt through the end date and current section membership. Answering means an unfinished attempt with saved quiz answers. Not started means a section assignment with no attempt.</p>
    <section class="module-analytics" aria-labelledby="module-analytics-title">
      <div class="dashboard-toolbar">
        <h3 id="module-analytics-title">Module progress by course</h3>
        <label class="dashboard-period-field"><span>Course</span><select data-module-course></select></label>
      </div>
      <p class="small muted">One student per module. Status totals include assigned students and learners with recorded attempts. Retake counts can overlap with any status.</p>
      <p class="small muted" data-module-empty hidden>No modules to show for this course and period.</p>
      <div data-module-results hidden>
        <div class="analytics-canvas module-analytics-canvas"><canvas data-module-chart role="img" aria-label="Stacked bar chart of student statuses by module"></canvas></div>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Module progress and retake counts">
          <table><thead><tr><th>Module</th><th>Students</th><th>Passed</th><th>Failed · no retake</th><th>Failed after retake</th><th>Ongoing</th><th>Not started</th><th>History unavailable</th><th>Students who retook</th><th>Students with a dated retake in period</th></tr></thead>
            <tbody data-module-rows></tbody>
          </table>
        </div>
        <p class="small muted">Older retakes with no recorded start date can still appear under Students who retook when the saved results or counter support it.</p>
        <p class="small muted">Historical progress uses available records, current section membership and course module records. When older progress cannot be determined, it appears under History unavailable.</p>
      </div>
    </section>
    <details>
      <summary>View chart data</summary>
      <div class="table-wrap"><table>
        <caption>Progress by course</caption>
        <thead><tr><th>Course</th><th>Learners</th><th>Not started</th><th>In progress</th><th>Answering</th><th>Completed</th><th>Completion</th></tr></thead>
        <tbody data-course-rows></tbody>
      </table></div>
      <div class="table-wrap"><table>
        <caption>Daily activity</caption>
        <thead><tr><th>Date</th><th>Published</th><th>Started</th><th>Module quiz submissions</th><th>Completed</th></tr></thead>
        <tbody data-day-rows></tbody>
      </table></div>
    </details>
  </div>
</section>

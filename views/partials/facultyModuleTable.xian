<div class="table-wrap" tabindex="0" role="region" aria-label="Module assessment records"><table><thead><tr><th scope="col">Module / Record</th><th scope="col">Quiz score / Details</th><th scope="col">Status</th><th scope="col">Retakes</th></tr></thead><tbody data-page-list>
{{#each moduleResults}}<tr data-page-item><td>{{title}}</td><td>{{#if assessed}}{{score}}%{{else}}—{{/if}}</td><td>{{#if assessed}}{{#if passed}}<span class="chip">Passed</span>{{else}}<span class="chip pink">Needs retake</span>{{/if}}{{else}}Not assessed{{/if}}</td><td>{{retakes}}</td></tr>{{/each}}
</tbody><tfoot><tr><th scope="row">Final assessment</th><td>{{#if (eq finalScore null)}}—{{else}}{{finalScore}}%{{/if}}</td><td colspan="2">{{#if (eq finalScore null)}}Not submitted{{else}}Submitted{{/if}}</td></tr><tr><th scope="row">Last activity</th><td>{{lastActivity}}</td><td colspan="2">{{#if inactive}}Inactive 7+ days{{else}}—{{/if}}</td></tr></tfoot></table></div>
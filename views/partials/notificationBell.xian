<div class="notification-menu" data-notification-menu><button class="notification-bell" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="notification-preview"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span class="notification-count" data-notification-count {{#unless unreadCount}}hidden{{/unless}}>{{unreadCount}}</span></button><section class="notification-preview" id="notification-preview" data-notification-preview hidden aria-label="Recent notifications"><h2>Recent notifications</h2><div data-notification-items><p class="small muted">Loading…</p></div><a href="/notifications" class="notification-view-all">View All Notifications</a></section></div>

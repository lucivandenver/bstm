<aside class="card lesson-sidebar">
  <div class="progress-circle" style="--angle:{{attempt.percent}}%"><div>{{attempt.percent}}%<small>COURSE PROGRESS</small></div></div>
  <p class="small center muted">{{attempt.done}} of {{attempt.total}} checklist items complete</p>
  <details class="lesson-outline" open>
    <summary>Topic outline{{#if selected.number}} <span class="outline-current-topic">Topic {{selected.number}}</span>{{/if}}</summary>
    {{#each modules}}
    <section class="module">
      <h3>{{#if passed}}✓ {{/if}}{{title}}</h3>
      {{#if questionCount}}<p class="small muted">{{questionCount}} {{#if (eq questionCount 1)}}question{{else}}questions{{/if}} across this module’s topics</p>{{/if}}
      {{#each lessons}}
        {{#if unlocked}}
        <a class="lesson-link {{#if (eq id ../../selected.id)}}active{{/if}}" {{#if (eq id ../../selected.id)}}aria-current="step"{{/if}} href="/student/learn/{{../../attempt.id}}?lesson={{id}}">
          <span class="check-circle {{#if done}}is-complete{{else}}{{#if (eq id ../../selected.id)}}is-current{{else}}is-empty{{/if}}{{/if}}" aria-hidden="true">{{#if done}}✓{{/if}}</span>
          <span>Topic {{number}} · {{title}}</span>
        </a>
        {{#if questions.length}}{{#if lectureDone}}
        <a data-outline-quiz="{{id}}" class="lesson-link outline-topic-quiz" href="/student/learn/{{../../attempt.id}}?lesson={{id}}#topic-quiz">
          <span class="check-circle {{#if quizDone}}is-complete{{else}}is-empty{{/if}}" aria-hidden="true">{{#if quizDone}}✓{{/if}}</span>
          <span>Topic {{number}} Quiz ({{questions.length}}) · <span data-topic-state>{{#if quizDone}}Answered{{else}}To do{{/if}}</span></span>
        </a>
        {{else}}<span class="lesson-link outline-topic-quiz muted">Topic {{number}} Quiz ({{questions.length}}) · Locked</span>{{/if}}{{/if}}
        {{else}}
        <span class="lesson-link muted" aria-disabled="true"><span class="check-circle is-empty" aria-hidden="true">🔒</span><span>Topic {{number}} · {{title}} <small>(Locked)</small></span></span>
        {{/if}}
      {{/each}}
      {{#if passed}}
      <p class="small muted">Module quiz · Passed ({{score}}%)</p>
      {{#if reviewAvailable}}<a class="small text-link" href="/student/learn/{{../attempt.id}}/review/{{id}}">Review quiz feedback →</a>{{/if}}
      {{else}}{{#if quizAvailable}}{{#unless ../completed}}
      <a class="lesson-link" href="/student/learn/{{../attempt.id}}/quiz/{{id}}" {{#if (eq id ../currentScope)}}aria-current="step"{{/if}}>
        {{#if answered}}Module quiz · Failed ({{score}}%) · Retry{{else}}Review and submit module answers{{/if}}
      </a>
      {{/unless}}{{/if}}{{/if}}
    </section>
    {{/each}}
    <section class="module">
      {{#if finalAvailable}}{{#unless completed}}{{#unless finalFeedbackAvailable}}
      <a class="button secondary full" href="/student/learn/{{attempt.id}}/final" {{#if (eq currentScope 'final')}}aria-current="step"{{/if}}>Take final assessment →</a>
      {{/unless}}{{/unless}}{{else}}<span class="small muted">🔒 Final assessment · pass all module quizzes first</span>{{/if}}
      {{#if finalFeedbackAvailable}}<p class="small space-top"><a class="text-link" href="/student/learn/{{attempt.id}}/review/final">Review submitted final feedback →</a></p>{{/if}}
    </section>
  </details>
</aside>

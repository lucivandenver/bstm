{{> head }}
<body data-initial-auth="{{#if openLoginModal}}login{{else}}{{#if openRegisterModal}}register{{/if}}{{/if}}" class="bg-[#FAFAFA] text-slate-800 antialiased selection:bg-rose-500 selection:text-white">
{{#unless openLoginModal}}{{#unless openRegisterModal}}<div class="auth-status">{{> messages}}</div>{{/unless}}{{/unless}}

  {{> publicHeader}}

  <!-- 1. HERO SECTION WITH BACKGROUND CAROUSEL -->
  <section id="home" class="relative overflow-hidden pt-8 pb-16 lg:pt-14 lg:pb-24">

    <!-- Hero Background Image Carousel -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <!-- Slide 1 -->
      <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100">
        <img src="/images/minsu_campus_1.jpg" alt="Mindoro State University Bongabong Campus" class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]" />
      </div>
      <!-- Slide 2 -->
      <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 pointer-events-none">
        <img src="/images/minsu_hostel_2.jpg" alt="MinSU Bongabong Hostel" class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]" />
      </div>
      <!-- Slide 3 -->
      <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 pointer-events-none">
        <img src="/images/minsu_building_3.jpg" alt="MinSU Academic Building" class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]" />
      </div>

      <!-- Gradient Overlay for readability -->
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 backdrop-blur-[0.5px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <!-- Left Hero Content -->
        <div class="lg:col-span-7 space-y-6">

          <!-- Campus Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-none bg-rose-50/90 border border-rose-200/80 backdrop-blur-sm shadow-sm">
            <span class="w-2 h-2 rounded-none bg-[#E11D48] animate-pulse"></span>
            <span class="text-xs font-bold tracking-wide uppercase text-rose-700">MINDORO STATE UNIVERSITY • BONGABONG CAMPUS</span>
          </div>

          <!-- Main Hero Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-extrabold text-slate-900 tracking-tight leading-[1.15]">
            Bridge the Gap Between <br />
            <span class="text-[#E11D48]">Learning</span> & <span class="text-[#10B981]">Tourism</span> <br />
            <span class="text-[#16a34a]">Careers</span>
          </h1>

          <!-- Description Subtext -->
          <p class="text-base sm:text-lg text-slate-700 max-w-xl font-normal leading-relaxed">
            A technology-based knowledge-readiness and career-matching platform for graduating Bachelor of Science in Tourism Management (BSTM) students. Discover your strengths, identify skill gaps, and navigate your professional journey.
          </p>

          <!-- Primary Call-to-actions (Boxy Type) -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <button onclick="openRegisterModal()" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-none text-base font-bold text-white bg-[#007042] hover:bg-[#005a35] shadow-lg shadow-green-900/10 hover:shadow-xl hover:-translate-y-0.5 transition-all">
              <span>Take the Assessment</span>
              <span class="text-lg">→</span>
            </button>
            <button onclick="openLoginModal()" class="inline-flex items-center px-7 py-3.5 rounded-none text-base font-bold text-[#E11D48] bg-white border-2 border-rose-200 hover:border-rose-400 hover:bg-rose-50/60 shadow-sm transition-all">
              Log In to Account
            </button>
          </div>

          <!-- Highlights Pills -->
          <div class="flex flex-wrap items-center gap-2.5 pt-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
              <span>{{> publicIcon name="students"}}</span> Graduating BSTM Students
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
              <span>{{> publicIcon name="match"}}</span> Tourism & Hospitality Focus
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
              <span>{{> publicIcon name="chart"}}</span> Research-Backed System
            </div>
          </div>

        </div>

        <div class="lg:col-span-5">{{> learningJourneyPreview}}</div>

      </div>

      <!-- Carousel Pagination Indicator Dots -->
      <div class="flex items-center justify-center gap-2.5 pt-10">
        <button onclick="setCarouselSlide(0)" class="carousel-dot w-3 h-3 rounded-full bg-rose-500 transition-all shadow-sm" aria-label="Slide 1"></button>
        <button onclick="setCarouselSlide(1)" class="carousel-dot w-3 h-3 rounded-full bg-rose-200 transition-all hover:bg-rose-300 shadow-sm" aria-label="Slide 2"></button>
        <button onclick="setCarouselSlide(2)" class="carousel-dot w-3 h-3 rounded-full bg-rose-200 transition-all hover:bg-rose-300 shadow-sm" aria-label="Slide 3"></button>
      </div>

    </div>
  </section>

  <section class="cb-stats-band"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">{{> publicStats}}</div></section>

  <!-- 3. SYSTEM FEATURES SECTION (BOXY TYPE DESIGN) -->
  <section id="features" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-100 border border-rose-200">
          SYSTEM FEATURES
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Everything You Need to Plan Your Career
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          CareerBridge gives students a complete set of tools to assess readiness and find the right tourism career path.
        </p>
      </div>

      {{> systemFeatures}}

    </div>
  </section>

  <!-- 4. HOW IT WORKS SECTION (BOXY DESIGN) -->
  <section id="how-it-works" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 border border-emerald-200">
          HOW IT WORKS
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Your Path to Career Clarity
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          In a few simple steps, CareerBridge helps you discover your readiness level and find a career that fits you.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mt-14">

        <!-- Three compact learning steps -->
        <div class="lg:col-span-7 space-y-6 cb-process-steps">
          <article class="cb-process-step"><span>STEP 01</span><h4>Build Your Profile</h4><p>Your academic background, interests and OJT experience.</p></article>
          <article class="cb-process-step"><span>STEP 02</span><h4>Learn &amp; Assess</h4><p>Faculty-published courses with lessons and knowledge checks.</p></article>
          <article class="cb-process-step"><span>STEP 03</span><h4>Earn &amp; Explore</h4><p>Track achievements and explore career matches from your evidence.</p></article>
        </div>
        <!-- Right: Process Status Card Preview (Boxy) -->
        <div class="lg:col-span-5">
          <div class="cb-process-preview bg-[#F6FAF6] border border-emerald-100 rounded-none p-6 shadow-md space-y-3.5">

            <div class="cb-process-card bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl"><img class="cb-fluent-emoji" src="/images/fluent-emoji/identification-card.png" alt="" width="30" height="30" loading="lazy"></span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Profile Created</h5>
                <p class="text-xs text-gray-500">Student ID & academic background captured</p>
              </div>
            </div>

            <div class="cb-process-card bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl"><img class="cb-fluent-emoji" src="/images/fluent-emoji/clipboard.png" alt="" width="30" height="30" loading="lazy"></span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Assessment Done</h5>
                <p class="text-xs text-gray-500">Readiness results are shown after submission</p>
              </div>
            </div>

            <div class="cb-process-card bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl"><img class="cb-fluent-emoji" src="/images/fluent-emoji/bullseye.png" alt="" width="30" height="30" loading="lazy"></span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Top Match Found</h5>
                <p class="text-xs text-gray-500">Ranked career options from your assessed evidence</p>
              </div>
            </div>

            <div class="cb-process-card bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl"><img class="cb-fluent-emoji" src="/images/fluent-emoji/chart-increasing.png" alt="" width="30" height="30" loading="lazy"></span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Gap Report Ready</h5>
                <p class="text-xs text-gray-500">Review assessed areas needing more practice</p>
              </div>
            </div>

            <div class="cb-process-card bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl"><img class="cb-fluent-emoji" src="/images/fluent-emoji/robot.png" alt="" width="30" height="30" loading="lazy"></span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">AI Suggestions Sent</h5>
                <p class="text-xs text-gray-500">Optional AI guidance builds on your learning evidence</p>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. WHO IT'S FOR SECTION (BOXY DESIGN AS REQUESTED) -->
  <section id="who-its-for" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-100 border border-rose-200">
          WHO IT'S FOR
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Learning with Guidance & Support
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          CareerBridge serves both graduating students exploring their career path and teachers or administrators overseeing the assessment process.
        </p>
      </div>

      <!-- 2 Boxy Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-14">

        <!-- Graduating BSTM Students Card (Boxy) -->
        <div class="bg-[#FFF5F6] rounded-none p-8 sm:p-10 border border-rose-200/80 shadow-sm hover:shadow-lg transition-all">
          <div class="text-4xl mb-4">{{> publicIcon name="students"}}</div>
          <h3 class="text-2xl font-black text-slate-900 mb-3">Graduating BSTM Students</h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            You're about to enter the tourism and hospitality industry. CareerBridge helps you understand where you stand, what careers suit you best, and what you need to work on.
          </p>

          <ul class="space-y-3 text-sm font-semibold text-slate-700">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-rose-500"></span>
              Take the knowledge-readiness assessment
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-rose-500"></span>
              View personalized career match results
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-rose-500"></span>
              Identify and address skills gaps
            </li>
          </ul>
        </div>

        <!-- Teachers & Administrators Card (Boxy) -->
        <div class="bg-[#F0FDF4] rounded-none p-8 sm:p-10 border border-emerald-200/80 shadow-sm hover:shadow-lg transition-all">
          <div class="text-4xl mb-4">{{> publicIcon name="faculty"}}</div>
          <h3 class="text-2xl font-black text-slate-900 mb-3">Teachers & Administrators</h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            Monitor student progress, analyze class-wide readiness scores, and use the data to improve career guidance, training, and curriculum support.
          </p>

          <ul class="space-y-3 text-sm font-semibold text-slate-700">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Faculty view assigned students; Admin manages system access
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Monitor class readiness scores and trends
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Analyze career match distributions
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Generate and export research reports
            </li>
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- 6. SIGNIFICANCE OF THE STUDY SECTION (BOXY BENEFICIARY CARDS) -->
  <section id="about-significance" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-100 border border-rose-200">
          SIGNIFICANCE OF THE STUDY
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Who Benefits from This Study
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          The findings of this research benefit multiple stakeholders in the education, industry, and research communities.
        </p>
      </div>

      <!-- Top 4 Beneficiaries (Boxy) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-14">

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">{{> publicIcon name="students"}}</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">Graduating BSTM Students</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Understand knowledge readiness, identify areas for improvement, and explore aligned career options before entering the industry.
          </p>
        </div>

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">{{> publicIcon name="book"}}</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">BSTM Program & Faculty</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Gain insights into student preparation and skill gaps to enhance career guidance, training, and curriculum support.
          </p>
        </div>

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">{{> publicIcon name="faculty"}}</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">MinSU Bongabong Campus</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            A technology-based approach for supporting graduating students as they transition from academics to the workforce.
          </p>
        </div>

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">{{> publicIcon name="match"}}</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">Tourism & Hospitality Industry</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Understand the knowledge, skills, and interests that graduating BSTM students associate with available career opportunities.
          </p>
        </div>

      </div>

      <!-- Bottom Centered 5th Beneficiary: Future Researchers (Boxy) -->
      <div class="max-w-md mx-auto mt-6">
        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">{{> publicIcon name="spark"}}</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">Future Researchers</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Serves as a reference and foundation for future studies on career readiness, tourism education, and technology-based assessment systems.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 7. CALL TO ACTION BANNER (BOXY BUTTONS) -->
  <section class="bg-[#1E293B] text-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Ready to Find Your Career Path?
      </h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
        Take the knowledge-readiness assessment and discover which tourism careers are the best match for you.
      </p>
      <div class="flex items-center justify-center gap-4 pt-4">
        <!-- Boxy buttons with corners -->
        <button onclick="openRegisterModal()" class="px-7 py-3.5 rounded-none font-bold text-white bg-[#007042] hover:bg-[#005a35] shadow-md transition-all">
          Create Account
        </button>
        <button onclick="openLoginModal()" class="px-7 py-3.5 rounded-none font-bold text-slate-200 bg-transparent border border-slate-600 hover:bg-slate-800 transition-all">
          Log In
        </button>
      </div>
    </div>
  </section>

  <!-- 8. DETAILED FOOTER (BALANCED LOGOS) -->
  <footer class="bg-[#111827] text-gray-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

        <!-- Col 1: Brand & 3 Perfectly Balanced Logos + Transparent CareerBridge Logo -->
        <div class="space-y-4">
          <div class="flex items-center space-x-2.5">
            <img src="/images/minsu_seal.png" alt="MinSU Seal" class="h-10 w-10 object-contain" />
            <img src="/images/cbm_logo.png" alt="CBM Logo" class="h-10 w-10 object-contain" />
            <img src="/images/council_tourism_logo.png" alt="Council of Tourism Students" class="h-11 w-11 object-contain" />
          </div>
          <div class="mt-2">
            <img src="/images/careerbridge_brand_logo.png" alt="CareerBridge" class="h-12 w-auto object-contain brightness-110 mb-2" />
            <p class="text-xs text-gray-400 leading-relaxed">
              Technology-based knowledge-readiness assessment and career matching platform for graduating BSTM students at Mindoro State University – Bongabong Campus.
            </p>
          </div>
        </div>

        <!-- Col 2: Navigation -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Navigation</h6>
          <ul class="space-y-2 text-xs">
            <li><a href="#home" class="hover:text-white transition-colors">Home</a></li>
            <li><a href="#features" class="hover:text-white transition-colors">Platform Features</a></li>
            <li><a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
            <li><a href="#about-significance" class="hover:text-white transition-colors">Who It's For</a></li>
          </ul>
        </div>

        <!-- Col 3: About & Help (Points to /about) -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">About & Help</h6>
          <ul class="space-y-2 text-xs">
            <li><a href="/about#about-section" class="hover:text-white transition-colors">About CareerBridge</a></li>
            <li><a href="/about#faq-section" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
            <li><a href="#features" class="hover:text-white transition-colors">Core Competencies</a></li>
          </ul>
        </div>

        <!-- Col 4: Access Portal (Opens Modals) -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Access Portal</h6>
          <ul class="space-y-2 text-xs">
            <li><button onclick="openLoginModal()" class="hover:text-white transition-colors text-left">Student Sign In</button></li>
            <li><button onclick="openRegisterModal()" class="hover:text-white transition-colors text-left">Create Student Account</button></li>
            <li><button onclick="openLoginModal()" class="hover:text-white transition-colors text-left">Faculty / Admin Sign In</button></li>
          </ul>
        </div>

      </div>

      <!-- Bottom Line -->
      <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500">
        <div>
          &copy; 2026 BSTM CareerBridge • Mindoro State University Bongabong Campus
        </div>
        <div class="mt-2 sm:mt-0 font-medium text-gray-400">
          College of Business and Management (CBM) • Council of Tourism Students
        </div>
      </div>

    </div>
  </footer>


{{> publicAuthDialogs}}
</body>
</html>

{{> head }}
<body data-initial-auth="{{#if openLoginModal}}login{{else}}{{#if openRegisterModal}}register{{/if}}{{/if}}" class="bg-[#FAFAFA] text-slate-800 antialiased selection:bg-rose-500 selection:text-white">
{{#unless openLoginModal}}{{#unless openRegisterModal}}<div class="auth-status">{{> messages}}</div>{{/unless}}{{/unless}}

  {{> publicHeader}}

  <!-- 1. HERO SECTION WITH BACKGROUND CAROUSEL -->
  <section id="home" class="relative overflow-hidden pt-8 pb-16 lg:pt-14 lg:pb-24">

    <!-- Hero Background Image Carousel -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <!-- Slide 1 -->
      <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100">
        <img src="/images/minsu_campus_1.jpg" alt="Mindoro State University Bongabong Campus" class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]" />
      </div>
      <!-- Slide 2 -->
      <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 pointer-events-none">
        <img src="/images/minsu_hostel_2.jpg" alt="MinSU Bongabong Hostel" class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]" />
      </div>
      <!-- Slide 3 -->
      <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 pointer-events-none">
        <img src="/images/minsu_building_3.jpg" alt="MinSU Academic Building" class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]" />
      </div>

      <!-- Gradient Overlay for readability -->
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 backdrop-blur-[0.5px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <!-- Left Hero Content -->
        <div class="lg:col-span-7 space-y-6">

          <!-- Campus Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-none bg-rose-50/90 border border-rose-200/80 backdrop-blur-sm shadow-sm">
            <span class="w-2 h-2 rounded-none bg-[#E11D48] animate-pulse"></span>
            <span class="text-xs font-bold tracking-wide uppercase text-rose-700">MINDORO STATE UNIVERSITY • BONGABONG CAMPUS</span>
          </div>

          <!-- Main Hero Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-extrabold text-slate-900 tracking-tight leading-[1.15]">
            Bridge the Gap Between <br />
            <span class="text-[#E11D48]">Learning</span> & <span class="text-[#10B981]">Tourism</span> <br />
            <span class="text-[#16a34a]">Careers</span>
          </h1>

          <!-- Description Subtext -->
          <p class="text-base sm:text-lg text-slate-700 max-w-xl font-normal leading-relaxed">
            A technology-based knowledge-readiness and career-matching platform for graduating Bachelor of Science in Tourism Management (BSTM) students. Discover your strengths, identify skill gaps, and navigate your professional journey.
          </p>

          <!-- Primary Call-to-actions (Boxy Type) -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <button onclick="openRegisterModal()" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-none text-base font-bold text-white bg-[#007042] hover:bg-[#005a35] shadow-lg shadow-green-900/10 hover:shadow-xl hover:-translate-y-0.5 transition-all">
              <span>Take the Assessment</span>
              <span class="text-lg">→</span>
            </button>
            <button onclick="openLoginModal()" class="inline-flex items-center px-7 py-3.5 rounded-none text-base font-bold text-[#E11D48] bg-white border-2 border-rose-200 hover:border-rose-400 hover:bg-rose-50/60 shadow-sm transition-all">
              Log In to Account
            </button>
          </div>

          <!-- Highlights Pills -->
          <div class="flex flex-wrap items-center gap-2.5 pt-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
              <span>🎓</span> Graduating BSTM Students
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
              <span>🌴</span> Tourism & Hospitality Focus
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-none bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-sm">
              <span>📊</span> Research-Backed System
            </div>
          </div>

        </div>

        <!-- Right Floating Dashboard Visual Cards: TOP & BOTTOM GREEN OUTLINE, MIDDLE PINK OUTLINE -->
        <div class="lg:col-span-5 relative py-6 flex flex-col items-center lg:items-end">

          <div class="relative w-full max-w-[370px]"><p class="text-xs text-gray-600 mb-3">Illustrative dashboard preview</p>

            <!-- Card 1: Knowledge Readiness (Top Card: GREEN OUTLINE) -->
            <div class="animate-float-1 relative z-10 bg-[#F8F9FA] rounded-[24px] p-6 shadow-xl card-outline-green mb-[-32px] w-[95%]">
              <span class="text-[11px] font-bold tracking-wider uppercase text-gray-400 block mb-1">KNOWLEDGE READINESS</span>
              <div class="flex items-baseline gap-1.5 my-1">
                <span class="text-3xl font-black text-slate-900">78%</span>
                <span class="text-emerald-600 font-bold text-sm">↑</span>
              </div>
              <p class="text-xs text-gray-500 font-medium">Core BSTM Domains Verified</p>
            </div>

            <!-- Card 2: Top Recommended Match (Middle Protruding Card: PINK OUTLINE) -->
            <div class="animate-float-2 relative z-20 bg-[#F8F9FA] rounded-[24px] p-6 shadow-2xl card-outline-pink mb-[-32px] w-full ml-[-12px] sm:ml-[-20px] transition-transform duration-300 hover:scale-105">
              <span class="text-[11px] font-bold tracking-wider uppercase text-gray-400 block mb-1">TOP RECOMMENDED MATCH</span>
              <h4 class="text-[17px] font-extrabold text-slate-900 my-1">Tour Operations Manager</h4>
              <p class="text-xs text-gray-500 font-medium">94% compatibility • Algorithmic Fit</p>
            </div>

            <!-- Card 3: Target Improvement (Bottom Card: GREEN OUTLINE) -->
            <div class="animate-float-3 relative z-10 bg-[#F8F9FA] rounded-[24px] p-6 shadow-xl card-outline-green w-[95%]">
              <span class="text-[11px] font-bold tracking-wider uppercase text-gray-400 block mb-1">TARGET IMPROVEMENT</span>
              <h4 class="text-[15px] font-extrabold text-slate-900 my-1">Digital Skills • PMS Tools</h4>
              <p class="text-xs text-gray-500 font-medium">Smart Development Plan active</p>
            </div>

          </div>

        </div>

      </div>

      <!-- Carousel Pagination Indicator Dots -->
      <div class="flex items-center justify-center gap-2.5 pt-10">
        <button onclick="setCarouselSlide(0)" class="carousel-dot w-3 h-3 rounded-full bg-rose-500 transition-all shadow-sm" aria-label="Slide 1"></button>
        <button onclick="setCarouselSlide(1)" class="carousel-dot w-3 h-3 rounded-full bg-rose-200 transition-all hover:bg-rose-300 shadow-sm" aria-label="Slide 2"></button>
        <button onclick="setCarouselSlide(2)" class="carousel-dot w-3 h-3 rounded-full bg-rose-200 transition-all hover:bg-rose-300 shadow-sm" aria-label="Slide 3"></button>
      </div>

    </div>
  </section>

  <!-- 2. STATS BAR -->
  <section class="relative z-20 py-8 bg-gradient-to-r from-[#DF707E] via-[#5FB875] to-[#4EA965] text-white shadow-inner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/20">

        <div class="pt-3 md:pt-0">
          <div class="text-3xl lg:text-4xl font-extrabold tracking-tight">{{stats.students}}</div>
          <div class="text-xs sm:text-sm font-medium text-white/90 mt-1">Graduating BSTM Students</div>
        </div>

        <div class="pt-3 md:pt-0">
          <div class="text-3xl lg:text-4xl font-extrabold tracking-tight">4</div>
          <div class="text-xs sm:text-sm font-medium text-white/90 mt-1">Skill Areas Assessed</div>
        </div>

        <div class="pt-3 md:pt-0">
          <div class="text-3xl lg:text-4xl font-extrabold tracking-tight">{{stats.pathways}}</div>
          <div class="text-xs sm:text-sm font-medium text-white/90 mt-1">Career Pathways Matched</div>
        </div>

        <div class="pt-3 md:pt-0">
          <div class="text-3xl lg:text-4xl font-extrabold tracking-tight">{{stats.courses}}</div>
          <div class="text-xs sm:text-sm font-medium text-white/90 mt-1">Published Learning Courses</div>
        </div>

        <div class="pt-3 md:pt-0 col-span-2 md:col-span-1">
          <div class="text-3xl lg:text-4xl font-extrabold tracking-tight">6</div>
          <div class="text-xs sm:text-sm font-medium text-white/90 mt-1">Research Objectives</div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. SYSTEM FEATURES SECTION (BOXY TYPE DESIGN) -->
  <section id="features" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-100 border border-rose-200">
          SYSTEM FEATURES
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Everything You Need to Plan Your Career
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          CareerBridge gives students a complete set of tools to assess readiness and find the right tourism career path.
        </p>
      </div>

      <!-- Feature Cards Grid: Fully Adaptive across all screensizes (xs, sm, md, lg, xl, 2xl) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 lg:gap-8 mt-10 sm:mt-14">

        <!-- Feature 1 -->
        <div class="group bg-white rounded-none p-6 sm:p-7 lg:p-8 border border-gray-200 shadow-sm hover:shadow-xl hover:border-emerald-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-orange-50 border border-orange-100 group-hover:scale-110 transition-transform">📋</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-orange-600 bg-orange-50 px-2 py-0.5 border border-orange-200">Assessment</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition-colors">Knowledge-Readiness Assessment</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Structured 10-section comprehensive survey evaluating Tourism Core, Communication, Workplace, and Digital PMS skills.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-emerald-700">
            <span>10 Structured Modules</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="group bg-white rounded-none p-6 sm:p-7 lg:p-8 border border-gray-200 shadow-sm hover:shadow-xl hover:border-rose-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-rose-50 border border-rose-100 group-hover:scale-110 transition-transform">🎯</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-rose-600 bg-rose-50 px-2 py-0.5 border border-rose-200">Matching</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-rose-600 transition-colors">Smart Career Matching</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Algorithmic engine cross-analyzes student scores, interests, OJT, and qualifications against 7+ tourism career tracks.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-rose-600">
            <span>7+ Career Pathways</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="group bg-white rounded-none p-6 sm:p-7 lg:p-8 border border-gray-200 shadow-sm hover:shadow-xl hover:border-blue-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-blue-50 border border-blue-100 group-hover:scale-110 transition-transform">📈</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2 py-0.5 border border-blue-200">Diagnostic</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">Skills Gap Analysis</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Instantly detects specific competencies needing improvement with priority levels and targeted action guidelines.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-blue-600">
            <span>Targeted Skill Action</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="group bg-white rounded-none p-6 sm:p-7 lg:p-8 border border-gray-200 shadow-sm hover:shadow-xl hover:border-purple-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-purple-50 border border-purple-100 group-hover:scale-110 transition-transform">📊</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-purple-600 bg-purple-50 px-2 py-0.5 border border-purple-200">Admin</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-purple-600 transition-colors">Analytics Dashboard</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Equips faculty advisors with real-time class readiness distributions, completion tracking, and cohort evaluations.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-purple-600">
            <span>Realtime Cohort Data</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>

        <!-- Feature 5 -->
        <div class="group bg-white rounded-none p-6 sm:p-7 lg:p-8 border border-gray-200 shadow-sm hover:shadow-xl hover:border-pink-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-pink-50 border border-pink-100 group-hover:scale-110 transition-transform">🤖</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-pink-600 bg-pink-50 px-2 py-0.5 border border-pink-200">AI Logic</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-pink-600 transition-colors">AI-Powered Suggestions</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Personalized algorithmic recommendations based on individual assessment trends and career development priorities.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-pink-600">
            <span>Automated Guidance</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>

        <!-- Feature 6 -->
        <div class="group bg-white rounded-none p-6 sm:p-7 lg:p-8 border border-gray-200 shadow-sm hover:shadow-xl hover:border-teal-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-3 bg-teal-50 border border-teal-100 group-hover:scale-110 transition-transform">⬇️</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-teal-600 bg-teal-50 px-2 py-0.5 border border-teal-200">Export</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-teal-600 transition-colors">Downloadable Reports</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Graduating students can generate and export their comprehensive verified readiness profile and matching certificate.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-teal-600">
            <span>Instant PDF Export</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. HOW IT WORKS SECTION (BOXY DESIGN) -->
  <section id="how-it-works" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 border border-emerald-200">
          HOW IT WORKS
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Your Path to Career Clarity
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          In a few simple steps, CareerBridge helps you discover your readiness level and find a career that fits you.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mt-14">

        <!-- Left: Steps 1-5 -->
        <div class="lg:col-span-7 space-y-6">

          <div class="flex items-start gap-4 p-3 rounded-none hover:bg-slate-50 transition-colors">
            <div class="w-10 h-10 rounded-none bg-[#5FB875] text-white flex items-center justify-center font-bold text-base shrink-0 shadow-sm">
              1
            </div>
            <div>
              <h4 class="text-lg font-bold text-slate-900">Create Your Account</h4>
              <p class="text-slate-600 text-sm mt-0.5">Register with your student ID and set up your academic profile and OJT experience.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-3 rounded-none hover:bg-slate-50 transition-colors">
            <div class="w-10 h-10 rounded-none bg-[#5FB875] text-white flex items-center justify-center font-bold text-base shrink-0 shadow-sm">
              2
            </div>
            <div>
              <h4 class="text-lg font-bold text-slate-900">Take the Assessment</h4>
              <p class="text-slate-600 text-sm mt-0.5">Complete the 10-section knowledge-readiness survey at your own pace.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-3 rounded-none hover:bg-slate-50 transition-colors">
            <div class="w-10 h-10 rounded-none bg-[#5FB875] text-white flex items-center justify-center font-bold text-base shrink-0 shadow-sm">
              3
            </div>
            <div>
              <h4 class="text-lg font-bold text-slate-900">Get Your Career Matches</h4>
              <p class="text-slate-600 text-sm mt-0.5">The system analyzes your profile and generates ranked tourism career options.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-3 rounded-none hover:bg-slate-50 transition-colors">
            <div class="w-10 h-10 rounded-none bg-[#5FB875] text-white flex items-center justify-center font-bold text-base shrink-0 shadow-sm">
              4
            </div>
            <div>
              <h4 class="text-lg font-bold text-slate-900">Explore & Improve</h4>
              <p class="text-slate-600 text-sm mt-0.5">Review your skills gap analysis and follow recommended steps to bridge your gaps.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-3 rounded-none hover:bg-slate-50 transition-colors">
            <div class="w-10 h-10 rounded-none bg-[#839788] text-white flex items-center justify-center font-bold text-base shrink-0 shadow-sm">
              5
            </div>
            <div>
              <h4 class="text-lg font-bold text-slate-900">Submit Your Evaluation</h4>
              <p class="text-slate-600 text-sm mt-0.5">Rate the system and share feedback to contribute to the ongoing research study.</p>
            </div>
          </div>

        </div>

        <!-- Right: Process Status Card Preview (Boxy) -->
        <div class="lg:col-span-5">
          <div class="bg-[#F6FAF6] border border-emerald-100 rounded-none p-6 shadow-md space-y-3.5">

            <div class="bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl">🪪</span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Profile Created</h5>
                <p class="text-xs text-gray-500">Student ID & academic background captured</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl">📋</span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Assessment Done</h5>
                <p class="text-xs text-gray-500">78% overall readiness score recorded</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl">🎯</span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Top Match Found</h5>
                <p class="text-xs text-gray-500">Hotel & Resort Operations – 94% match</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl">📈</span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">Gap Report Ready</h5>
                <p class="text-xs text-gray-500">2 high-priority skill areas identified</p>
              </div>
            </div>

            <div class="bg-white p-4 rounded-none border border-gray-200 flex items-center gap-3.5 shadow-sm">
              <span class="text-2xl">🤖</span>
              <div>
                <h5 class="text-sm font-bold text-slate-900">AI Suggestions Sent</h5>
                <p class="text-xs text-gray-500">5 personalized career tips generated</p>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. WHO IT'S FOR SECTION (BOXY DESIGN AS REQUESTED) -->
  <section id="who-its-for" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-100 border border-rose-200">
          WHO IT'S FOR
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Designed for Two Types of Users
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          CareerBridge serves both graduating students exploring their career path and teachers or administrators overseeing the assessment process.
        </p>
      </div>

      <!-- 2 Boxy Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-14">

        <!-- Graduating BSTM Students Card (Boxy) -->
        <div class="bg-[#FFF5F6] rounded-none p-8 sm:p-10 border border-rose-200/80 shadow-sm hover:shadow-lg transition-all">
          <div class="text-4xl mb-4">🎓</div>
          <h3 class="text-2xl font-black text-slate-900 mb-3">Graduating BSTM Students</h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            You're about to enter the tourism and hospitality industry. CareerBridge helps you understand where you stand, what careers suit you best, and what you need to work on.
          </p>

          <ul class="space-y-3 text-sm font-semibold text-slate-700">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-rose-500"></span>
              Take the knowledge-readiness assessment
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-rose-500"></span>
              View personalized career match results
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-rose-500"></span>
              Identify and address skills gaps
            </li>
          </ul>
        </div>

        <!-- Teachers & Administrators Card (Boxy) -->
        <div class="bg-[#F0FDF4] rounded-none p-8 sm:p-10 border border-emerald-200/80 shadow-sm hover:shadow-lg transition-all">
          <div class="text-4xl mb-4">👨‍🏫</div>
          <h3 class="text-2xl font-black text-slate-900 mb-3">Teachers & Administrators</h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            Monitor student progress, analyze class-wide readiness scores, and use the data to improve career guidance, training, and curriculum support.
          </p>

          <ul class="space-y-3 text-sm font-semibold text-slate-700">
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              View all student assessment records
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Monitor class readiness scores and trends
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Analyze career match distributions
            </li>
            <li class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-none bg-emerald-500"></span>
              Generate and export research reports
            </li>
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- 6. SIGNIFICANCE OF THE STUDY SECTION (BOXY BENEFICIARY CARDS) -->
  <section id="about-significance" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-none text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-100 border border-rose-200">
          SIGNIFICANCE OF THE STUDY
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Who Benefits from This Study
        </h2>
        <p class="text-slate-600 text-base sm:text-lg">
          The findings of this research benefit multiple stakeholders in the education, industry, and research communities.
        </p>
      </div>

      <!-- Top 4 Beneficiaries (Boxy) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-14">

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">🎓</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">Graduating BSTM Students</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Understand knowledge readiness, identify areas for improvement, and explore aligned career options before entering the industry.
          </p>
        </div>

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">📚</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">BSTM Program & Faculty</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Gain insights into student preparation and skill gaps to enhance career guidance, training, and curriculum support.
          </p>
        </div>

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">🏫</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">MinSU Bongabong Campus</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            A technology-based approach for supporting graduating students as they transition from academics to the workforce.
          </p>
        </div>

        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">🌴</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">Tourism & Hospitality Industry</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Understand the knowledge, skills, and interests that graduating BSTM students associate with available career opportunities.
          </p>
        </div>

      </div>

      <!-- Bottom Centered 5th Beneficiary: Future Researchers (Boxy) -->
      <div class="max-w-md mx-auto mt-6">
        <div class="bg-white rounded-none p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col items-center">
          <div class="text-4xl mb-4">🔬</div>
          <h4 class="text-base font-bold text-slate-900 mb-2">Future Researchers</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Serves as a reference and foundation for future studies on career readiness, tourism education, and technology-based assessment systems.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 7. CALL TO ACTION BANNER (BOXY BUTTONS) -->
  <section class="bg-[#1E293B] text-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Ready to Find Your Career Path?
      </h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
        Take the knowledge-readiness assessment and discover which tourism careers are the best match for you.
      </p>
      <div class="flex items-center justify-center gap-4 pt-4">
        <!-- Boxy buttons with corners -->
        <button onclick="openRegisterModal()" class="px-7 py-3.5 rounded-none font-bold text-white bg-[#007042] hover:bg-[#005a35] shadow-md transition-all">
          Create Account
        </button>
        <button onclick="openLoginModal()" class="px-7 py-3.5 rounded-none font-bold text-slate-200 bg-transparent border border-slate-600 hover:bg-slate-800 transition-all">
          Log In
        </button>
      </div>
    </div>
  </section>

  <!-- 8. DETAILED FOOTER (BALANCED LOGOS) -->
  <footer class="bg-[#111827] text-gray-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

        <!-- Col 1: Brand & 3 Perfectly Balanced Logos + Transparent CareerBridge Logo -->
        <div class="space-y-4">
          <div class="flex items-center space-x-2.5">
            <img src="/images/minsu_seal.png" alt="MinSU Seal" class="h-10 w-10 object-contain" />
            <img src="/images/cbm_logo.png" alt="CBM Logo" class="h-10 w-10 object-contain" />
            <img src="/images/council_tourism_logo.png" alt="Council of Tourism Students" class="h-11 w-11 object-contain" />
          </div>
          <div class="mt-2">
            <img src="/images/careerbridge_brand_logo.png" alt="CareerBridge" class="h-12 w-auto object-contain brightness-110 mb-2" />
            <p class="text-xs text-gray-400 leading-relaxed">
              Technology-based knowledge-readiness assessment and career matching platform for graduating BSTM students at Mindoro State University – Bongabong Campus.
            </p>
          </div>
        </div>

        <!-- Col 2: Navigation -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Navigation</h6>
          <ul class="space-y-2 text-xs">
            <li><a href="#home" class="hover:text-white transition-colors">Home</a></li>
            <li><a href="#features" class="hover:text-white transition-colors">Platform Features</a></li>
            <li><a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
            <li><a href="#who-its-for" class="hover:text-white transition-colors">Who It's For</a></li>
          </ul>
        </div>

        <!-- Col 3: About & Help (Points to /about) -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">About & Help</h6>
          <ul class="space-y-2 text-xs">
            <li><a href="/about#about-section" class="hover:text-white transition-colors">About CareerBridge</a></li>
            <li><a href="/about#faq-section" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
            <li><a href="#features" class="hover:text-white transition-colors">Core Competencies</a></li>
          </ul>
        </div>

        <!-- Col 4: Access Portal (Opens Modals) -->
        <div>
          <h6 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Access Portal</h6>
          <ul class="space-y-2 text-xs">
            <li><button onclick="openLoginModal()" class="hover:text-white transition-colors text-left">Student Sign In</button></li>
            <li><button onclick="openRegisterModal()" class="hover:text-white transition-colors text-left">Create Student Account</button></li>
            <li><button onclick="openLoginModal()" class="hover:text-white transition-colors text-left">Faculty / Admin Sign In</button></li>
          </ul>
        </div>

      </div>

      <!-- Bottom Line -->
      <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500">
        <div>
          &copy; 2026 BSTM CareerBridge • Mindoro State University Bongabong Campus
        </div>
        <div class="mt-2 sm:mt-0 font-medium text-gray-400">
          College of Business and Management (CBM) • Council of Tourism Students
        </div>
      </div>

    </div>
  </footer>


{{> publicAuthDialogs}}
</body>
</html>

{{> head}}
<link rel="stylesheet" href="/css/landing.css">
<body class="landing"><a class="landing-skip" href="#main-content">Skip to content</a>
{{#unless openLoginModal}}<div class="auth-status">{{> messages}}</div>{{/unless}}
<header class="landing-header"><div class="landing-container landing-nav"><a class="landing-brand" href="/" aria-label="CareerBridge home"><img src="/images/careerbridge_brand_logo.png" alt="CareerBridge"><span>BSTM LEARNING & CAREER PATHWAYS</span></a><nav class="landing-links" aria-label="Main navigation"><a href="#learning">Learning experience</a><a href="#how-it-works">How it works</a><a href="#who-its-for">For your role</a><a href="/about">About</a></nav><div class="landing-auth"><button class="landing-button subtle" onclick="openLoginModal()">Log in</button><button class="landing-button" onclick="openRegisterModal()">Get started <span>↗</span></button><button id="mobileMenuBtn" class="landing-menu" onclick="toggleMobileNav()" aria-controls="mobileNavMenu" aria-expanded="false" aria-label="Open navigation">☰</button></div></div><nav id="mobileNavMenu" class="landing-mobile landing-container" hidden aria-label="Mobile navigation"><a href="#learning">Learning experience</a><a href="#how-it-works">How it works</a><a href="#who-its-for">For your role</a><a href="/about">About CareerBridge</a></nav></header>
<main id="main-content"><section class="landing-hero" id="home" aria-roledescription="carousel" aria-label="MinSU campus photographs"><div class="landing-slides"><div class="carousel-slide is-current" aria-hidden="false"><img src="/images/minsu_campus_1.jpg" alt="Mindoro State University Bongabong Campus" fetchpriority="high"></div><div class="carousel-slide" aria-hidden="true"><img src="/images/minsu_hostel_2.jpg" alt="MinSU Bongabong Hostel"></div><div class="carousel-slide" aria-hidden="true"><img src="/images/minsu_building_3.jpg" alt="MinSU Academic Building"></div></div><div class="hero-scrim"></div><div class="landing-container hero-grid"><div class="hero-copy"><p class="landing-eyebrow"><span></span> MINDORO STATE UNIVERSITY · BONGABONG CAMPUS</p><h1>Your learning.<br>Your progress.<br><em>Your next chapter.</em></h1><p class="hero-description">Build your tourism knowledge, put it into practice, and explore where it could take you. A guided learning space for graduating BSTM students.</p><div class="hero-actions"><button class="landing-button" onclick="openRegisterModal()">Start my learning journey <span>→</span></button><a class="landing-button outline" href="#how-it-works">See how it works ↓</a></div><p class="hero-note">Learn at your pace. Keep every achievement.</p></div><aside class="journey-preview" aria-label="Illustration of the learning journey"><div class="preview-header"><span class="preview-icon">↗</span><div><strong>A clearer path forward</strong><small>THE CAREERBRIDGE EXPERIENCE</small></div><span class="preview-dot"></span></div><div class="journey-step"><span class="journey-number">01</span><div><strong>Know your starting point</strong><p>Build your profile. Discover your learning gaps.</p></div></div><div class="journey-step"><span class="journey-number">02</span><div><strong>Learn. Practice. Progress.</strong><p>Complete lessons and receive faculty feedback.</p></div></div><div class="journey-step"><span class="journey-number pink">03</span><div><strong>See what comes next</strong><p>Earn course awards and explore career pathways.</p></div></div><div class="preview-footer"><span>✧</span><p>Recommendations backed by your learning evidence.</p></div></aside></div><div class="landing-container carousel-controls"><div class="campus-caption"><span class="small-line"></span> A place to learn. A future to build.</div><div class="carousel-buttons"><button class="carousel-arrow" onclick="setCarouselSlide(currentSlide-1)" aria-label="Previous campus photograph">←</button><span id="slide-count">01 / 03</span><button class="carousel-arrow" onclick="setCarouselSlide(currentSlide+1)" aria-label="Next campus photograph">→</button><div class="carousel-dots"><button class="carousel-dot is-current" onclick="setCarouselSlide(0)" aria-label="Campus photograph 1" aria-pressed="true"></button><button class="carousel-dot" onclick="setCarouselSlide(1)" aria-label="Campus photograph 2" aria-pressed="false"></button><button class="carousel-dot" onclick="setCarouselSlide(2)" aria-label="Campus photograph 3" aria-pressed="false"></button></div><button id="carousel-pause" class="pause-button" aria-pressed="false">Pause slideshow</button></div></div></section>
<section class="campus-strip"><div class="landing-container campus-strip-inner"><div class="campus-logos"><img src="/images/minsu_seal.png" alt="MinSU"><img src="/images/cbm_logo.png" alt="College of Business and Management"><img src="/images/council_tourism_logo.png" alt="Council of Tourism Students"><p>Rooted in our campus.<br><strong>Focused on your future.</strong></p></div><div class="live-stats"><div><strong>{{stats.students}}</strong><span>Student accounts</span></div><div><strong>{{stats.courses}}</strong><span>Published courses</span></div><div><strong>{{stats.completions}}</strong><span>Learning completions</span></div></div></div></section>
<section class="landing-section" id="learning"><div class="landing-container"><div class="section-intro"><div><p class="landing-eyebrow">BUILT AROUND YOUR GROWTH</p><h2>A little learning.<br>A meaningful next step.</h2></div><p>Connect what you know, what you're learning, and where you want to go—with support from your faculty along the way.</p></div><div class="feature-grid"><article class="landing-feature"><span class="feature-symbol">◎</span><h3>Understand your readiness</h3><p>Start with a knowledge diagnostic. See your results across tourism, communication, workplace and digital learning areas.</p><span class="feature-tag">YOUR STARTING POINT</span></article><article class="landing-feature"><span class="feature-symbol pink">▤</span><h3>Learn with a clear path</h3><p>Follow lessons, quizzes and practical tasks. Your checklist and saved progress help you pick up where you left off.</p><span class="feature-tag">YOUR DAILY PROGRESS</span></article><article class="landing-feature"><span class="feature-symbol">↗</span><h3>Explore your direction</h3><p>Discover career pathways, supporting evidence and recommended learning. Keep your certificates and badges in one place.</p><span class="feature-tag">YOUR NEXT CHAPTER</span></article></div></div></section>
<section class="landing-section process-section" id="how-it-works"><div class="landing-container"><p class="landing-eyebrow">A SIMPLE WAY FORWARD</p><h2>From first login<br>to your next milestone.</h2><div class="process-grid"><article><span>01</span><h3>Make it yours</h3><p>Register and complete your academic, OJT and career profile.</p></article><article><span>02</span><h3>Find your focus</h3><p>Take the diagnostic and choose courses for your goals and gaps.</p></article><article><span>03</span><h3>Build your evidence</h3><p>Finish lessons and assessments. Apply feedback from your faculty.</p></article><article><span>04</span><h3>Keep moving forward</h3><p>Collect eligible course awards, revisit your results and explore pathways.</p></article></div></div></section>
<section class="landing-section" id="who-its-for"><div class="landing-container"><div class="section-intro"><div><p class="landing-eyebrow">ONE CONNECTED WORKSPACE</p><h2>Everyone has a part<br>in your progress.</h2></div><p>The right tools for students, faculty and administrators—connected through learning.</p></div><div class="role-grid"><article><span class="role-label">FOR STUDENTS</span><h3>Take ownership<br>of your growth.</h3><p>Build your profile, complete courses, track results and download your earned awards.</p><button class="landing-text-link" onclick="openRegisterModal()">Create my student account →</button></article><article><span class="role-label">FOR FACULTY</span><h3>Turn teaching<br>into clear next steps.</h3><p>Create and review course content, monitor assigned sections and evaluate practical work.</p><a class="landing-text-link" href="/register?role=faculty">Request a faculty account →</a></article><article><span class="role-label">FOR ADMINISTRATORS</span><h3>Keep the learning<br>space running.</h3><p>Manage approvals, academic assignments, career rules, credentials and system activity.</p><button class="landing-text-link" onclick="openLoginModal()">Sign in to administration →</button></article></div></div></section>
<section class="landing-container"><div class="landing-cta"><div><p class="landing-eyebrow">YOUR NEXT CHAPTER STARTS HERE</p><h2>Make room for<br>what you can become.</h2><p>Your progress belongs to you. Let's give it a direction.</p></div><button class="landing-button white" onclick="openRegisterModal()">Create my account <span>↗</span></button></div></section>
<section class="landing-section faq-section"><div class="landing-container faq-grid"><div><p class="landing-eyebrow">GOOD TO KNOW</p><h2>A few questions,<br>answered.</h2></div><div><details><summary>What do CareerBridge certificates represent?</summary><p>They record completion of a CareerBridge course and its published requirements. They are not automatically TESDA qualifications or professional licences.</p></details><details><summary>How are career pathways suggested?</summary><p>Rules compare your assessed learning evidence with the learning areas needed by a pathway. Optional AI explains the evidence. Ongoing or unlocked courses do not count as earned competency, and suggestions do not guarantee employment.</p></details><details><summary>Can I take a course again?</summary><p>Yes. A new attempt has its own progress and completion record. Your previous results remain in your history, and repeated courses do not stack your career matching score.</p></details><details><summary>Can I use my Google account?</summary><p>Yes. Register with Google and complete your required academic details first. Faculty requests need Admin approval. After registration, use Google to sign in.</p></details></div></div></section></main>
<footer class="landing-footer"><div class="landing-container"><div class="footer-main"><a class="footer-brand" href="/">CareerBridge<span>LEARNING TODAY. POSSIBILITIES TOMORROW.</span></a><nav aria-label="Footer navigation"><a href="/about">About</a><a href="#how-it-works">How it works</a><a href="/register">Create account</a><a href="/login">Log in</a></nav></div><div class="footer-bottom"><p>BSTM · Mindoro State University, Bongabong Campus</p><p>Learning evidence supports decisions. Faculty guidance matters.</p></div></div></footer>
  <!-- ================= POPUP MODALS (BOXY DESIGN WITH SHARP CORNERS) ================= -->

  <!-- 1. LOGIN POPUP MODAL (BOXY) -->
  <div id="loginModal" role="dialog" aria-modal="true" aria-label="Sign in" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm overflow-y-auto">
    <div class="relative w-full max-w-[440px] my-8 bg-white rounded-none shadow-2xl p-8 sm:p-10 border border-gray-300 transition-all scale-95 opacity-0 duration-200" id="loginModalCard">
      
      <!-- Close Button -->
      <button aria-label="Close sign-in dialog" onclick="closeLoginModal()" class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 p-1.5 hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {{#if openLoginModal}}<div class="auth-status">{{> messages}}</div>{{/if}}
<!-- Modal Card Header -->
      <div class="mb-6">
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Sign In</h2>
      </div>

      <!-- Form -->
      <form action="/login" method="POST" class="space-y-4"><input type="hidden" name="_csrf" value="{{csrf}}">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1" for="modal_login_email">Email address</label>
          <input 
            type="email" 
            id="modal_login_email" 
            name="email" 
            placeholder="you@example.com" 
            required 
            class="w-full px-4 py-2.5 rounded-none border border-gray-300 text-slate-800 text-sm placeholder:text-gray-400 focus:outline-none focus:ring-1 focus:ring-[#007042] focus:border-[#007042] transition-all"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block text-sm font-semibold text-slate-700" for="modal_login_password">Password</label>
            <a href="/forgot-password" class="text-xs font-semibold text-[#007042] hover:text-[#005230] transition-colors">Forgot?</a>
          </div>
          <div class="relative">
            <input 
              type="password" 
              id="modal_login_password" 
              name="password" 
              placeholder="Enter your password" 
              required 
              class="w-full pl-4 pr-11 py-2.5 rounded-none border border-gray-300 text-slate-800 text-sm placeholder:text-gray-400 focus:outline-none focus:ring-1 focus:ring-[#007042] focus:border-[#007042] transition-all"
            />
            <button 
              type="button" 
              onclick="toggleModalPassword('modal_login_password', this)" 
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-slate-600 focus:outline-none"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-3 px-4 bg-[#007042] hover:bg-[#005a35] text-white font-bold rounded-none shadow-sm hover:shadow transition-all duration-200 mt-2 text-sm tracking-wide"
        >
          Log in
        </button>
      </form>

      <!-- OR Divider -->
      <div class="relative flex py-5 items-center">
        <div class="flex-grow border-t border-gray-200"></div>
        <span class="flex-shrink mx-4 text-xs font-medium text-gray-400 uppercase">or</span>
        <div class="flex-grow border-t border-gray-200"></div>
      </div>

      <!-- Google Sign In -->
      <a 
        href="/auth/google?intent=login"
        class="w-full flex items-center justify-center gap-3 py-2.5 px-4 border border-gray-300 rounded-none text-sm font-semibold text-slate-700 hover:bg-gray-50 hover:border-gray-400 transition-all shadow-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Sign in with Google
      </a>

      <!-- Switch to Register -->
      <p class="text-center text-xs text-slate-600 mt-5">
        New to CareerBridge? 
        <button onclick="switchToRegisterModal()" class="font-bold text-[#007042] hover:text-[#005a35] underline underline-offset-2">Create an account</button>
      </p>

      <!-- Terms -->
      <p class="text-center text-[11px] text-gray-400 mt-4 leading-relaxed">
        By logging in, you agree to CareerBridge's 
        <a href="/terms" class="underline text-gray-500 hover:text-gray-700">Terms</a> &
        <a href="/privacy" class="underline text-gray-500 hover:text-gray-700">Data use</a>
      </p>

    </div>
  </div>


  <!-- 2. REGISTER POPUP MODAL (BOXY) -->
  <div id="registerModal" role="dialog" aria-modal="true" aria-label="Create account" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm overflow-y-auto">
    <div class="relative w-full max-w-[460px] my-8 bg-white rounded-none shadow-2xl p-8 sm:p-10 border border-gray-300 transition-all scale-95 opacity-0 duration-200" id="registerModalCard">
      
      <!-- Close Button -->
      <button aria-label="Close registration dialog" onclick="closeRegisterModal()" class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 p-1.5 hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Modal Card Header -->
      <div class="mb-5">
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Sign Up</h2>
      </div>

      <!-- Form -->
      {{> registrationForm prefix="modal_"}}

      <!-- OR Divider -->
      <div class="relative flex py-4 items-center">
        <div class="flex-grow border-t border-gray-200"></div>
        <span class="flex-shrink mx-4 text-xs font-medium text-gray-400 uppercase">or</span>
        <div class="flex-grow border-t border-gray-200"></div>
      </div>

      <!-- Google Sign In -->
      <a 
        href="/auth/google?intent=register&amp;role={{registrationRole}}" data-google-register
        class="w-full flex items-center justify-center gap-3 py-2.5 px-4 border border-gray-300 rounded-none text-sm font-semibold text-slate-700 hover:bg-gray-50 hover:border-gray-400 transition-all shadow-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Sign up with Google
      </a>

      <!-- Switch to Login -->
      <p class="text-center text-xs text-slate-600 mt-4">
        Already have an account? 
        <button onclick="switchToLoginModal()" class="font-bold text-[#007042] hover:text-[#005a35] underline underline-offset-2">Log in</button>
      </p>

      <!-- Terms -->
      <p class="text-center text-[11px] text-gray-400 mt-3 leading-relaxed">
        By creating an account, you agree to CareerBridge's 
        <a href="/terms" class="underline text-gray-500 hover:text-gray-700">Terms</a> &
        <a href="/privacy" class="underline text-gray-500 hover:text-gray-700">Data use</a>
      </p>

    </div>
  </div>

  <!-- JAVASCRIPT LOGIC: MODAL & CAROUSEL -->
  <script>
    let currentSlide = 0, carouselPaused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const slides = document.querySelectorAll('.carousel-slide'), dots = document.querySelectorAll('.carousel-dot');
    function setCarouselSlide(index) { currentSlide = (index + slides.length) % slides.length; slides.forEach((s,i) => {s.classList.toggle('is-current',i===currentSlide);s.setAttribute('aria-hidden',i!==currentSlide);});dots.forEach((d,i)=>{d.classList.toggle('is-current',i===currentSlide);d.setAttribute('aria-pressed',i===currentSlide);});document.getElementById('slide-count').textContent=`0${currentSlide+1} / 03`; }
    const pause = document.getElementById('carousel-pause');
    pause.textContent = carouselPaused ? 'Play slideshow' : 'Pause slideshow';
    pause.addEventListener('click',()=>{carouselPaused=!carouselPaused;pause.textContent=carouselPaused?'Play slideshow':'Pause slideshow';pause.setAttribute('aria-pressed',carouselPaused);});
    setInterval(()=>{if(!carouselPaused&&!document.hidden)setCarouselSlide(currentSlide+1);},6500);
    document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeLoginModal();closeRegisterModal();}});
    // --- Modal Management (Boxy) ---
    const loginModal = document.getElementById('loginModal');
    const loginModalCard = document.getElementById('loginModalCard');
    const registerModal = document.getElementById('registerModal');
    const registerModalCard = document.getElementById('registerModalCard');

    let lastModalTrigger;
    function openAuthModal(which) {
      lastModalTrigger=document.activeElement;
      const other=which===loginModal?registerModal:loginModal;
      other.classList.add('hidden');other.classList.remove('flex');
      which.classList.remove('hidden');which.classList.add('flex');
      const card=which===loginModal?loginModalCard:registerModalCard;
      card.classList.remove('scale-95','opacity-0');card.classList.add('scale-100','opacity-100');
      document.body.style.overflow='hidden';which.querySelector('button,input,a')?.focus();
    }
    function closeAuthModal(which) { const wasOpen=!which.classList.contains('hidden');which.classList.add('hidden');which.classList.remove('flex');if(loginModal.classList.contains('hidden')&&registerModal.classList.contains('hidden'))document.body.style.overflow='';if(wasOpen)lastModalTrigger?.focus(); }
    function openLoginModal(){openAuthModal(loginModal);}
    function closeLoginModal(){closeAuthModal(loginModal);}
    function openRegisterModal(){openAuthModal(registerModal);}
    function closeRegisterModal(){closeAuthModal(registerModal);}
    for(const modal of [loginModal,registerModal])modal.addEventListener('keydown',e=>{if(e.key!=='Tab')return;const nodes=[...modal.querySelectorAll('a[href],button,input,select,textarea')].filter(x=>!x.disabled&&x.offsetParent!==null);if(!nodes.length)return;if(e.shiftKey&&document.activeElement===nodes[0]){nodes.at(-1).focus();e.preventDefault();}else if(!e.shiftKey&&document.activeElement===nodes.at(-1)){nodes[0].focus();e.preventDefault();}});
    function switchToRegisterModal() {
      closeLoginModal();
      setTimeout(openRegisterModal, 160);
    }

    function switchToLoginModal() {
      closeRegisterModal();
      setTimeout(openLoginModal, 160);
    }

    if (new URLSearchParams(window.location.search).get('auth') === 'login') openLoginModal();
    loginModal.addEventListener('click', (e) => {
      if (e.target === loginModal) closeLoginModal();
    });

    registerModal.addEventListener('click', (e) => {
      if (e.target === registerModal) closeRegisterModal();
    });

    function toggleModalPassword(inputId, btn) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.style.opacity = isPassword ? '0.7' : '1';
    }

    function toggleMobileNav() { const menu=document.getElementById('mobileNavMenu'),btn=document.getElementById('mobileMenuBtn');menu.hidden=!menu.hidden;btn.setAttribute('aria-expanded',!menu.hidden); }
    document.querySelectorAll('#mobileNavMenu a').forEach(a=>a.addEventListener('click',()=>{document.getElementById('mobileNavMenu').hidden=true;document.getElementById('mobileMenuBtn').setAttribute('aria-expanded','false');}));
  </script>

</body>
</html>

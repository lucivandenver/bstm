  <!-- 8. DETAILED FOOTER (BALANCED LOGOS) -->
  <footer class="bg-[#111827] text-gray-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

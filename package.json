{
  "name": "BSTM",
  "version": "1.0.0",
  "description": "XianFire Framework project",
  "main": "electron/main.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "create:add-middleware": "node create.js middleware",
    "create:upload-middleware": "node create.js upload-middleware",
    "route:list": "node list-routes.js",
    "route:cache": "node route-cache.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "electron": "electron .",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "electron-builder",
    "run": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "electron-builder --publish=never",
    "seed:student": "node scripts/seedStudent.js",
    "test:student": "node --test tests/*.test.js",
    "build:css": "tailwindcss -i ./assets/tailwind.css -o ./public/tailwind.css --minify",
    "setup:google": "node scripts/setupGoogle.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-session-sequelize": "^8.0.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.17.3",
    "google-auth-library": "^11.3.1",
    "hbs": "^4.2.0",
    "inquirer": "^9.2.15",
    "multer": "^2.0.2",
    "mysql2": "^3.9.2",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.xianfire.app",
    "productName": "BSTM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
